#!/usr/bin/env bash
set -e

echo "=== Neajud E2E Test Runner ==="
echo ""

export PATH="$HOME/.local/share/mise/installs/node/22.22.2/bin:$PATH"
export LD_LIBRARY_PATH="$HOME/.local/chromium-libs/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH"

# Safety: never run outside test environment — check BEFORE overwriting RAILS_ENV
if [ "${RAILS_ENV:-test}" != "test" ]; then
  echo "ERROR: bin/e2e must run with RAILS_ENV=test (got '$RAILS_ENV')" >&2
  exit 1
fi
export RAILS_ENV=test
# Broadcasts come from the Solid Queue process (Etapa 0.3); only a
# cross-process adapter reaches the browser. Same as production.
export CABLE_ADAPTER=solid_cable

# The E2E server gets its own port so the development server on :3000 keeps
# running untouched. They used to share :3000: every run replaced the dev
# server with the test one for minutes, and localhost:3000 silently showed
# test data (Sep 2026). Specs read E2E_BASE_URL (e2e/support/runner.js).
E2E_PORT="${E2E_PORT:-3001}"
export E2E_BASE_URL="http://localhost:$E2E_PORT"

PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$PROJECT_ROOT"

# Specs write temp files (DXF/TIF) into e2e/ and delete them at the end of each
# test; an aborted or failed run leaves them behind. Only untracked files with
# the generated-name prefixes are removed, so tracked fixtures
# (e.g. e2e/e2e-size-test.dxf) and unrelated new files are never touched.
clean_e2e_artifacts() {
  git ls-files --others --exclude-standard -z e2e/ \
    | grep -zE '^e2e/(e2e-|auto-detect-|UniqCorte)' \
    | xargs -0 -r rm -f
}

# Single source of truth for which specs run — CI calls this script too, so
# a spec missing here runs nowhere (moldes.spec.js was silently skipped).
# Explicit list (not a glob) keeps the historical run order.
E2E_SPECS=(
  # autenticacao must run first: it needs the empty database of a new
  # instance to test the first-access setup, which creates the user every
  # later spec signs in as (e2e/support/sessao.js).
  autenticacao
  # Former arquivos.spec.js, split by area — keep this order: later files reuse
  # data created by earlier ones (arquivos-client-field opens the 29-30 card
  # that arquivos-previews / arquivos-dxf-organization uploaded).
  arquivos-upload arquivos-previews arquivos-versions arquivos-dxf-organization
  arquivos-client-field arquivos-size-selection
  pages-clients-moldes-pecas pages-modelos-materials
  arquivos-gallery arquivos-auto-detection arquivos-corte-comparison arquivos-unique-corte
  movimentos pedidos pedidos-pecas clients modelos materiais moldes lixeira
)
for file in e2e/*.spec.js; do
  name="$(basename "$file" .spec.js)"
  if [[ ! " ${E2E_SPECS[*]} " == *" $name "* ]]; then
    echo "ERROR: $file is not listed in E2E_SPECS in bin/e2e (listed: ${E2E_SPECS[*]})" >&2
    exit 1
  fi
done

# Logs kept per run, so an intermittent failure can still be investigated
# after later runs (a single /tmp/neajud_server.log used to be overwritten):
#   requests.log — this run's slice of log/test.log (the Rails request log;
#                  in the test env requests are NOT written to stdout)
#   server.log   — the server process's stdout/stderr (boot, Puma, crashes)
# A spec marker is appended to both before each spec. Keeps the last
# E2E_LOG_KEEP runs; log/e2e/latest → newest.
E2E_LOG_ROOT="log/e2e"
E2E_LOG_KEEP=10
RUN_ID="$(date +%Y%m%d-%H%M%S)-$$"
RUN_LOG_DIR="$E2E_LOG_ROOT/$RUN_ID"
SERVER_LOG="$RUN_LOG_DIR/server.log"
REQUESTS_LOG="$RUN_LOG_DIR/requests.log"
RAILS_TEST_LOG="log/test.log"
RAILS_TEST_LOG_OFFSET=""

prepare_run_log() {
  mkdir -p "$RUN_LOG_DIR"
  : > "$SERVER_LOG"
  ln -sfn "$RUN_ID" "$E2E_LOG_ROOT/latest"
  find "$E2E_LOG_ROOT" -mindepth 1 -maxdepth 1 -type d -name '2*' | sort | head -n -"$E2E_LOG_KEEP" | xargs -r rm -rf
  RAILS_TEST_LOG_OFFSET="$(stat -c %s "$RAILS_TEST_LOG" 2>/dev/null || echo 0)"
  trap save_requests_log EXIT
}

# Rails' logger opens log/test.log in append mode, so these lines interleave
# with request logs instead of overwriting them.
mark_spec() {
  local marker="=== [$(date +%T)] spec: $1 ==="
  echo "$marker" >> "$SERVER_LOG"
  echo "$marker" >> "$RAILS_TEST_LOG"
}

# Runs on any exit (success, failure, aborted startup).
save_requests_log() {
  [ -n "$RAILS_TEST_LOG_OFFSET" ] || return 0
  tail -c +"$((RAILS_TEST_LOG_OFFSET + 1))" "$RAILS_TEST_LOG" > "$REQUESTS_LOG" 2>/dev/null || true
}

# PIDs listening on the E2E port (lsof, falling back to fuser). Always exits
# 0: a free port is not an error, and `set -e` would abort on grep's exit 1.
e2e_port_pids() {
  lsof -t -iTCP:"$E2E_PORT" -sTCP:LISTEN 2>/dev/null \
    || fuser "$E2E_PORT"/tcp 2>/dev/null | tr -s ' ' '\n' | grep -E '^[0-9]+$' \
    || true
}

# Only a leftover *test* server may be stopped. Anything else on the E2E port
# (a dev server, another app) is refused, never killed.
is_test_server() {
  tr '\0' '\n' < "/proc/$1/environ" 2>/dev/null | grep -qx 'RAILS_ENV=test'
}

# Stops a leftover test server on the E2E port. Selected by port + RAILS_ENV,
# never by `pkill -f` pattern: that used to match any shell whose command
# contained "puma"/"rails server", including the one running bin/e2e (silent
# exit 144). TERM first, KILL only if the port is still busy after 5s.
stop_e2e_port() {
  local pids pid
  pids="$(e2e_port_pids)"
  [ -z "$pids" ] && return 0
  for pid in $pids; do
    if ! is_test_server "$pid"; then
      echo "ERROR: port $E2E_PORT is used by a non-test process, refusing to stop it: $(ps -o pid=,args= -p "$pid" | cut -c1-100)" >&2
      echo "       Stop it yourself or run with another port: E2E_PORT=3002 bash bin/e2e" >&2
      exit 1
    fi
  done
  echo "       Stopping leftover test server on :$E2E_PORT: $(ps -o pid=,args= -p "$(echo $pids | tr ' ' ',')" | cut -c1-100)"
  kill $pids 2>/dev/null || true
  for _ in $(seq 1 10); do
    [ -z "$(e2e_port_pids)" ] && return 0
    sleep 0.5
  done
  kill -9 $(e2e_port_pids) 2>/dev/null || true
  sleep 0.5
  if [ -n "$(e2e_port_pids)" ]; then
    echo "ERROR: port $E2E_PORT still in use after SIGKILL (PIDs: $(e2e_port_pids | tr '\n' ' '))" >&2
    exit 1
  fi
}

# Step 1: Free the E2E port (a leftover test server from an aborted run)
echo "[1/5] Freeing port $E2E_PORT (only a leftover test server is ever stopped)..."
stop_e2e_port
echo "       Done."

# Step 2: Prepare test database
echo "[2/5] Preparing test database..."
# Fresh queue DB: jobs left by an aborted run would process uploads whose
# rows are about to be truncated.
rm -f storage/test_queue.sqlite3* storage/test_cable.sqlite3*
bin/rails db:test:prepare 2>&1 | tail -1
# Wipe upload folders so E2E runs never accumulate orphan stamps. Only
# storage/test_stamps/ — never storage/stamps/, which holds real
# development/production uploads (see ArquivoVersion::STORAGE_BASE).
rm -rf storage/test_stamps/* 2>/dev/null || true
clean_e2e_artifacts
# Truncate all tables to ensure clean state for E2E
bin/rails runner '
conn = ActiveRecord::Base.connection
conn.execute("PRAGMA foreign_keys = OFF")
tables = conn.tables - %w[schema_migrations ar_internal_metadata]
tables.each { |t| conn.execute("DELETE FROM #{conn.quote_table_name(t)}") }
conn.execute("PRAGMA foreign_keys = ON")
Rails.application.load_seed
' 2>&1 | tail -1
echo "       Done."

# Step 3: Start Rails server in background
echo "[3/5] Starting Rails test server (port $E2E_PORT)..."
prepare_run_log
echo "       Logs: $RUN_LOG_DIR/ (requests.log, server.log)"
# Append mode (>>) so the spec markers written below interleave instead of
# being overwritten at the server's own file offset.
# Processing runs in Solid Queue inside Puma, like production (Etapa 0.3):
# uploads return before processing, and specs wait for the status the UI shows.
E2E_SOLID_QUEUE=1 SOLID_QUEUE_IN_PUMA=1 \
  bin/rails server -p "$E2E_PORT" -b 0.0.0.0 -e test -P "tmp/pids/e2e-server.pid" >>"$SERVER_LOG" 2>&1 &
SERVER_PID=$!
echo "       PID: $SERVER_PID"

# Wait for server to be ready
echo "       Waiting for server..."
for i in $(seq 1 30); do
  if curl -s "$E2E_BASE_URL/up" >/dev/null 2>&1; then
    echo "       Server is ready."
    break
  fi
  if [ "$i" -eq 30 ]; then
    echo "ERROR: Server failed to start within 30s."
    echo "--- Last 20 lines of server log ---"
    tail -20 "$SERVER_LOG"
    kill $SERVER_PID 2>/dev/null || true
    exit 1
  fi
  sleep 1
done

# Step 4: Run Playwright E2E tests
echo "[4/5] Running Playwright E2E tests..."
set +e
EXIT_CODE=0
FAILED_SPECS=()
for spec in "${E2E_SPECS[@]}"; do
  mark_spec "$spec"
  node "e2e/${spec}.spec.js" "$@" || { EXIT_CODE=1; FAILED_SPECS+=("$spec"); }
done
if [ "$EXIT_CODE" -ne 0 ]; then
  echo "       Failed specs: ${FAILED_SPECS[*]}"
  echo "       Logs for this run: $RUN_LOG_DIR/requests.log (search for \"=== [\" spec markers)"
fi
set -e

echo "       Exit code: $EXIT_CODE"

# Step 5: Kill server
echo "[5/5] Stopping server (PID $SERVER_PID)..."
clean_e2e_artifacts
kill $SERVER_PID 2>/dev/null || true
stop_e2e_port
echo "       Done."

echo ""
echo "=== E2E tests complete — logs: $RUN_LOG_DIR/ ==="
exit $EXIT_CODE
