<%# The construções (Dublagem 3/5): each saved dublado with whose it is, its
    situação, the suggested and the final price, and whether it is in use. %>
<div class="grupos-pagina construcoes-pagina">
  <div>
    <p class="grupos-trilha"><%= link_to "Materiais", materiais_path %> › Construções</p>
    <h2>Construções</h2>
  </div>
  <p class="construcoes-acoes">
    <% if pode?(:estoque, :editar) %><%= link_to "+ Nova construção", new_construcao_path, class: "btn btn-primary" %><% end %>
    <%= link_to "Rede de dublagens", rede_de_dublagens_path, class: "rede-link" %>
  </p>

  <% if @construcoes.empty? %>
    <p class="grupos-vazio">Nenhuma construção ainda. Uma construção é um dublado: a superfície, as bases em ordem e o ligante entre cada duas.</p>
  <% else %>
    <div class="rede-tabela-rolagem">
      <table class="rede-tabela construcoes-tabela">
        <thead>
          <tr><th>Construção</th><th>Dono</th><th>Situação</th><th class="num">Sugerido / m</th><th class="num">Final / m</th><th></th></tr>
        </thead>
        <tbody>
          <% @construcoes.each do |construcao| %>
            <tr class="construcoes-item" data-construcao="<%= construcao.nome %>">
              <td><%= link_to construcao.nome, edit_construcao_path(construcao) %></td>
              <td><%= construcao.client&.name || "Empresa" %></td>
              <td><%= construcao.situacao_rotulo || "Normal" %></td>
              <td class="num"><%= number_to_currency(PrecoSugeridoDaConstrucao.new(construcao, servico: @servico).total) %></td>
              <td class="num" data-preco-final><%= construcao.preco_final ? number_to_currency(construcao.preco_final) : "—" %></td>
              <td><% if construcao.em_uso? %><span class="rede-chip">em uso</span><% end %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
