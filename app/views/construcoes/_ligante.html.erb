<%# Between em cima and embaixo (5b1a): the ligantes the network allows in
    the situação for the junction's two layers and what is still "a
    confirmar", "ver na rede"; a pair the network doesn't have in red, with
    "Adicionar à rede" for whoever edits it (5b1b: momento and ligante group,
    lado any; its fields have no name, so the construção's form never sends
    them — construcao_controller.js posts them). In use, where the network
    changed since (rede editável 2/2a, Q6a). %>
<% ligacao = dublagem.ligacao %>
<% acima = dublagem.acima_da_juncao.materia_prima %>
<% abaixo = dublagem.juncao.materia_prima %>
<div class="construcao-liga" data-ligacao>
  <% if ligacao %>
    <% ligantes = @opcoes.ligantes(ligacao, @construcao.situacao) | [ dublagem.juncao.ligante ].compact %>
    <% regra = ligacao.ligantes_na(@construcao.situacao).map(&:descricao).to_sentence(two_words_connector: " ou ", last_word_connector: " ou ") %>
    <span>ligante</span>
    <% if ligantes.any? %>
      <select name="<%= campo %>[ligante_uuid]" class="construcao-campo construcao-ligante" aria-label="Ligante da <%= dublagem.letra %>" data-action="change->construcao#montar" <%= "disabled" if em_uso %>>
        <option value="">— <%= regra %></option>
        <% ligantes.each do |ligante| %>
          <option value="<%= ligante.uuid %>" <%= "selected" if ligante == dublagem.juncao.ligante %>><%= ligante.nome_completo %></option>
        <% end %>
      </select>
    <% else %>
      <span class="construcao-ligante-pendente" data-ligante-pendente><%= regra %> — a escolher na 5/5</span>
    <% end %>
    <% if ligacao.a_confirmar? %><span class="rede-chip rede-chip--confirmar">a confirmar</span><% end %>
    <%= link_to "ver na rede", rede_ligacao_path(ligacao.uuid), class: "construcao-ver-na-rede", data: { ver_na_rede: true } %>
  <% elsif acima && abaixo %>
    <div class="construcao-falta-rede" data-falta-rede>
      <b><%= acima.grupo_material.nome %> + <%= abaixo.grupo_material.nome %> não estão na rede.</b>
      <% if @grupos_de_ligante && !em_uso %>
        Criar a ligação:
        <select class="construcao-campo" aria-label="Momento da ligação nova da <%= dublagem.letra %>" data-rede-momento>
          <option value="depois">depois da estampa</option>
          <option value="antes">antes da estampa</option>
        </select>
        <select class="construcao-campo" aria-label="Ligante da ligação nova da <%= dublagem.letra %>" data-rede-ligante>
          <% @grupos_de_ligante.each do |grupo| %><option value="<%= grupo.uuid %>"><%= grupo.nome %></option><% end %>
        </select>
        <button type="button" class="construcao-adicionar-rede" data-action="construcao#adicionarARede"
                data-grupo-a="<%= acima.grupo_material.uuid %>" data-grupo-b="<%= abaixo.grupo_material.uuid %>" data-url="<%= rede_ligacoes_path %>">Adicionar à rede</button>
        <span class="construcao-erro-rede" data-erro-rede role="alert"></span>
      <% else %>
        Peça a quem edita a rede de dublagens.
      <% end %>
    </div>
  <% else %>
    <span>ligante: escolha em cima e embaixo</span>
  <% end %>
  <% if mudanca %>
    <%# Rede editável 2/2a (Q6a): in use, it keeps what it was made with. %>
    <span class="construcao-rede-mudou" data-rede-mudou>a rede mudou: <%= mudanca.texto %>
      <% if mudanca.ligacao_uuid %>· <%= link_to "ver na rede", rede_ligacao_path(mudanca.ligacao_uuid) %><% end %></span>
  <% end %>
</div>
