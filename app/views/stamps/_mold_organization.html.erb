<%= form_with url: organize_stamp_path(stamp), method: :patch, local: true, data: { turbo: false }, class: "mold-organization-form" do |f| %>
  <% if !stamp.organized? %>
    <div class="mold-organization-alert">
      ⚠ This DXF file is not organized yet. Set the mold, piece, and sizes below.
    </div>
  <% end %>
  <% if stamp.organize_error.present? %>
    <div class="mold-organization-error">
      ⛔ <%= stamp.organize_error %>. If any overlapping element is a hole, mark it as "Hole" in Layer Configuration and save again.
    </div>
  <% end %>

  <div class="mold-organization-fields">
    <div class="mold-field">
      <%= f.label :molde_nome, "Molde" %>
      <%= f.text_field :molde_nome, name: "molde_nome", value: stamp.molde_nome, placeholder: "Ex: Tênis" %>
    </div>
    <div class="mold-field">
      <%= f.label :peca_nome, "Peça" %>
      <%= f.text_field :peca_nome, name: "peca_nome", value: stamp.peca_nome, placeholder: "Ex: Cabedal" %>
    </div>
  </div>

  <h4>Tamanhos</h4>
  <div class="tamanho-list">
    <% stamp.tamanhos.each_with_index do |t, idx| %>
      <div class="tamanho-row">
        <span class="tamanho-indicator"><%= idx + 1 %>.</span>
        <input type="hidden" name="tamanhos[<%= idx %>][width_mm]" value="<%= t.width_mm %>">
        <input type="hidden" name="tamanhos[<%= idx %>][height_mm]" value="<%= t.height_mm %>">
        <input type="hidden" name="tamanhos[<%= idx %>][area_mm2]" value="<%= t.area_mm2 %>">
        <input type="text" name="tamanhos[<%= idx %>][nome]" value="<%= t.nome %>" class="tamanho-input" placeholder="Ex: 35">
        <span class="tamanho-measurements">
          <%= t.width_mm&.round(1) %>×<%= t.height_mm&.round(1) %> mm
          · <%= number_with_delimiter(t.area_mm2&.round(1)) %> mm²
        </span>
      </div>
    <% end %>
  </div>

  <%= f.submit stamp.organized? ? "Update Organization" : "Save Organization", class: "btn btn-primary" %>
<% end %>
