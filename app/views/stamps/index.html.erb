<h2>Stamp Tracker</h2>

<section>
  <h3>Upload New Stamp</h3>
  <%= form_with model: @stamp, html: { enctype: "multipart/form-data", data: { controller: "upload", action: "submit->upload#submit", turbo: false } } do |f| %>
    <% if @stamp.errors.any? %>
      <div class="form-errors">
        <% @stamp.errors.full_messages.each do |msg| %>
          <p class="error"><%= msg %></p>
        <% end %>
      </div>
    <% end %>
    <div class="upload-dropzone" data-upload-target="dropzone"
         data-action="dragenter->upload#dragOver dragover->upload#dragOver dragleave->upload#dragLeave drop->upload#drop click->upload#click">
      <p>Drag & drop files here, or click to select</p>
      <p class="upload-hint">Supported: TIF, TIFF, PSD, JPG, JPEG, AI, EPS, CDR</p>
      <%= f.file_field :original_file, multiple: true,
            data: { upload_target: "input", action: "change->upload#fileSelected" },
            accept: ".tif,.tiff,.psd,.jpg,.jpeg,.ai,.eps,.cdr",
            class: "upload-file-input" %>
    </div>
    <div class="upload-file-list" data-upload-target="fileList"></div>
    <%= f.submit "Upload", data: { upload_target: "submit" } %>
  <% end %>
</section>

<section>
  <h3>Gallery</h3>
  <% if @stamps.any? %>
    <div class="gallery">
      <% @stamps.each do |stamp| %>
        <div class="stamp-card">
          <h4><%= link_to stamp.filename, stamp_path(stamp) %></h4>
          <p>Extension: <%= stamp.extension %></p>
          <p>Status: <%= stamp.status %></p>
          <p>Time: <%= format_time(stamp.annotated_seconds || stamp.estimated_seconds) %></p>
          <% if stamp.preview_file.present? && File.exist?(stamp.preview_file) %>
            <%= image_tag preview_stamp_path(stamp), alt: stamp.filename %>
          <% elsif stamp.preview_file.present? %>
            <span class="error">Preview unavailable</span>
          <% elsif stamp.failed? || stamp.unsupported_format? || stamp.invalid_colorspace? %>
            <span class="error"><%= stamp.status.humanize %></span>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p>No stamps uploaded yet.</p>
  <% end %>
</section>
