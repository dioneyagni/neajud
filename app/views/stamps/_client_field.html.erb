<div class="stamp-detail-section">
  <h3>Client</h3>
  <div data-controller="dialog">
    <form action="<%= update_client_stamp_path(@stamp) %>" method="post" style="position: relative;">
      <input type="hidden" name="_method" value="patch">
      <input type="hidden" name="client_id" id="client_id" value="<%= @stamp.client_id %>">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

      <div data-controller="combobox" data-combobox-search-url-value="<%= search_clients_path %>">
        <input type="text"
               class="combobox-input"
               placeholder="Search client..."
               value="<%= @stamp.client&.name %>"
               data-action="focus->combobox#search input->combobox#search blur->combobox#blur">
        <div class="combobox-results"></div>
      </div>

      <button type="submit" class="btn btn-primary btn-sm" style="margin-top: 0.5rem;">Save</button>
    </form>

    <dialog data-dialog-target="dialog" class="client-dialog">
      <form action="<%= clients_path %>" method="post" class="client-form">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <h4>Register New Client</h4>
        <div class="client-field">
          <label for="client_name_dialog">Name</label>
          <input type="text" name="client[name]" id="client_name_dialog" required>
        </div>
        <div class="client-field">
          <label for="client_responsible_dialog">Responsible</label>
          <input type="text" name="client[responsible]" id="client_responsible_dialog" required>
        </div>
        <div class="client-dialog-actions">
          <button type="button" data-action="click->dialog#close" class="btn btn-secondary">Cancel</button>
          <button type="submit" class="btn btn-primary">Register</button>
        </div>
      </form>
    </dialog>

    <a href="#" data-action="click->dialog#open" style="display: none;" data-hidden-trigger></a>
  </div>
</div>
