<h2>
  <%= image_tag "#{FileCategory.extension_icon(@stamp.extension)}.svg", class: "stamp-detail-ext-icon", alt: @stamp.extension %>
  <%= image_tag "#{@stamp.program_icon}.svg", class: "stamp-detail-program-icon", alt: "Program" %>
  Stamp: <%= @stamp.filename %>.<%= @stamp.extension %>
</h2>

<div class="stamp-detail">
  <div class="stamp-detail-preview">
    <% if @stamp.preview_file.present? && File.exist?(@stamp.preview_file) %>
      <%= image_tag preview_stamp_path(@stamp, t: @stamp.approved_version&.updated_at&.to_i), alt: @stamp.filename %>
    <% else %>
      <div class="no-preview">
        <p>Preview not available yet.</p>
      </div>
    <% end %>
  </div>

  <div class="stamp-detail-info">
    <div class="stamp-detail-section">
      <h3>Details</h3>
      <dl class="detail-grid">
        <dt>Update</dt>
        <dd>
          <% if @stamp.approved_version %>
            <%= l @stamp.approved_version.updated_at, format: :short %> — v-<%= @stamp.approved_version.version_number %>
          <% else %>
            Not approved yet
          <% end %>
        </dd>
        <dt>Category</dt>
        <dd><%= @stamp.category.presence || "Uncategorized" %></dd>
        <% if @stamp.category_notes.present? %>
          <dt>Category Notes</dt>
          <dd><%= @stamp.category_notes %></dd>
        <% end %>
        <dt>Colorspace</dt>
        <dd><%= @stamp.colorspace || "Unknown" %></dd>
        <dt>Has Spots</dt>
        <dd><%= @stamp.has_spots? ? "Yes" : "No" %></dd>
        <dt>ICC Profile</dt>
        <dd><%= @stamp.icc_profile.presence || "None" %></dd>
        <dt>Dimensions</dt>
        <dd><%= @stamp.width_px %>x<%= @stamp.height_px %> px (<%= format_cm(@stamp.width_px, @stamp.dpi) %>x<%= format_cm(@stamp.height_px, @stamp.dpi) %> cm)</dd>
        <dt>Estimated Time</dt>
        <dd><%= format_time(@stamp.estimated_seconds) %></dd>
        <dt>Annotated Time</dt>
        <dd><%= format_time(@stamp.annotated_seconds) %></dd>
      </dl>
    </div>

    <div class="stamp-detail-section">
      <h3>Update Time</h3>
      <%= form_with url: update_time_stamp_path(@stamp), method: :patch, local: true,
            data: { controller: "time-mask" }, class: "time-form" do |f| %>
        <%= f.label :annotated_seconds, "Time (h:mm)" %>
        <%= f.text_field :annotated_seconds,
              value: format_time(@stamp.annotated_seconds || @stamp.estimated_seconds),
              data: { time_mask_target: "input", action: "input->time-mask#format" } %>
        <%= f.submit "Update Time", class: "btn btn-primary" %>
      <% end %>
    </div>

    <div class="stamp-detail-section">
      <h3>Time History</h3>
      <% if @time_logs.any? %>
        <table class="time-history">
          <thead>
            <tr>
              <th>Previous</th>
              <th>New</th>
              <th>Changed By</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <% @time_logs.each do |log| %>
              <tr>
                <td><%= format_time(log.previous_seconds) %></td>
                <td><%= format_time(log.new_seconds) %></td>
                <td><%= log.changed_by %></td>
                <td><%= l log.created_at, format: :short %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="time-history-empty">No time changes recorded.</p>
      <% end %>
    </div>

    <div class="stamp-detail-section">
      <h3>Download</h3>
      <%= link_to "Download Original", download_stamp_path(@stamp), class: "btn btn-primary" %>
    </div>

    <%= link_to "Back to Gallery", stamps_path, class: "back-link" %>

    <%= button_to "Delete Stamp", stamp_path(@stamp), method: :delete,
          data: { turbo_confirm: "Are you sure?" },
          class: "btn btn-danger", style: "margin-top: 0.5rem;" %>
  </div>
</div>

<% if @stamp.category == "corte" && @stamp.approved_version&.cut_layers&.any? %>
  <section>
    <h3>Layer Configuration</h3>
    <%= render "layer_configuration", version: @stamp.approved_version %>
  </section>
<% end %>

<section>
  <h3>Versions</h3>
  <% if @versions.any? %>
    <div class="version-list">
      <% @versions.each do |version| %>
        <div class="version-card">
          <div class="version-card-thumb">
            <% if version.preview_file.present? && File.exist?(version.preview_file) %>
              <%= image_tag version_preview_stamp_path(@stamp, version_id: version.id), alt: "v#{version.version_number}" %>
            <% else %>
              <%= image_tag "#{FileCategory.extension_icon(version.extension)}.svg", class: "stamp-card-ext-icon-centered", alt: version.extension %>
            <% end %>
          </div>
          <div class="version-card-body">
            <div class="version-card-header">
              <strong>v<%= version.version_number %></strong>
              <% if version.approved? %>
                <span class="stamp-card-badge badge-processed">Approved</span>
              <% end %>
            </div>
            <div class="version-card-meta">
              <span class="version-filename"><%= version.filename %>.<%= version.extension %></span>
              <span class="version-status badge-<%= version.status %>"><%= version.status.humanize %></span>
              <span class="version-date"><%= l version.created_at, format: :short %></span>
            </div>
            <div class="version-card-actions">
              <% unless version.approved? %>
                <%= button_to "Approve", approve_version_stamp_path(@stamp, version_id: version.id), method: :patch, class: "btn btn-primary btn-sm" %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="gallery-empty">No versions yet.</p>
  <% end %>
</section>

<section>
  <h3>Upload New Version</h3>
  <div class="upload-form-wrapper">
    <%= form_with url: upload_version_stamp_path(@stamp), multipart: true, class: "version-upload-form",
          data: { controller: "upload", turbo: false, upload_field_name_value: "original_file" } do |f| %>
      <div class="upload-dropzone" style="padding: 1.5rem;"
           data-upload-target="dropzone"
           data-action="dragenter->upload#dragOver dragover->upload#dragOver dragleave->upload#dragLeave drop->upload#drop click->upload#click">
        <label for="original_file" style="display: block; cursor: pointer;">
          <p>Drag & drop a file here, or click to select</p>
        </label>
        <%= f.file_field :original_file, class: "upload-file-input", id: "original_file",
              data: { upload_target: "input", action: "change->upload#fileSelected" } %>
      </div>
      <div class="upload-file-list" data-upload-target="fileList"></div>
      <%= f.submit "Upload Version", data: { upload_target: "submit" }, class: "upload-submit" %>
    <% end %>
  </div>
</section>
