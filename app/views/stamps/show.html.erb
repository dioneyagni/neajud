<h2>
  <%= image_tag "#{FileCategory.extension_icon(@stamp.extension)}.svg", class: "stamp-detail-ext-icon", alt: @stamp.extension %>
  <%= image_tag "#{FileCategory.program_icon(@stamp.extension)}.svg", class: "stamp-detail-program-icon", alt: "Program" %>
  Stamp: <%= @stamp.filename %>.<%= @stamp.extension %>
</h2>

<div class="stamp-detail">
  <div class="stamp-detail-preview">
    <% if @stamp.preview_file.present? %>
      <%= image_tag preview_stamp_path(@stamp), alt: @stamp.filename %>
    <% else %>
      <div class="no-preview">
        <p>Preview not available yet.</p>
      </div>
    <% end %>
  </div>

  <div class="stamp-detail-info">
    <div class="stamp-detail-section">
      <h3>Details</h3>
      <dl class="detail-grid">
        <dt>Status</dt>
        <dd><%= @stamp.status %></dd>
        <dt>Category</dt>
        <dd><%= @stamp.category.presence || "Uncategorized" %></dd>
        <% if @stamp.category_notes.present? %>
          <dt>Category Notes</dt>
          <dd><%= @stamp.category_notes %></dd>
        <% end %>
        <dt>Colorspace</dt>
        <dd><%= @stamp.colorspace || "Unknown" %></dd>
        <dt>Has Spots</dt>
        <dd><%= @stamp.has_spots? ? "Yes" : "No" %></dd>
        <dt>ICC Profile</dt>
        <dd><%= @stamp.icc_profile.presence || "None" %></dd>
        <dt>Dimensions</dt>
        <dd><%= @stamp.width_px %>x<%= @stamp.height_px %> px (<%= format_cm(@stamp.width_px, @stamp.dpi) %>x<%= format_cm(@stamp.height_px, @stamp.dpi) %> cm)</dd>
        <dt>Estimated Time</dt>
        <dd><%= format_time(@stamp.estimated_seconds) %></dd>
        <dt>Annotated Time</dt>
        <dd><%= format_time(@stamp.annotated_seconds) %></dd>
      </dl>
    </div>

    <div class="stamp-detail-section">
      <h3>Update Time</h3>
      <%= form_with url: update_time_stamp_path(@stamp), method: :patch, local: true,
            data: { controller: "time-mask" }, class: "time-form" do |f| %>
        <%= f.label :annotated_seconds, "Time (h:mm)" %>
        <%= f.text_field :annotated_seconds,
              value: format_time(@stamp.annotated_seconds || @stamp.estimated_seconds),
              data: { time_mask_target: "input", action: "input->time-mask#format" } %>
        <%= f.submit "Update Time", class: "btn btn-primary" %>
      <% end %>
    </div>

    <div class="stamp-detail-section">
      <h3>Time History</h3>
      <% if @time_logs.any? %>
        <table class="time-history">
          <thead>
            <tr>
              <th>Previous</th>
              <th>New</th>
              <th>Changed By</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <% @time_logs.each do |log| %>
              <tr>
                <td><%= format_time(log.previous_seconds) %></td>
                <td><%= format_time(log.new_seconds) %></td>
                <td><%= log.changed_by %></td>
                <td><%= l log.created_at, format: :short %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="time-history-empty">No time changes recorded.</p>
      <% end %>
    </div>

    <%= link_to "Back to Gallery", stamps_path, class: "back-link" %>

    <%= button_to "Delete Stamp", stamp_path(@stamp), method: :delete,
          data: { turbo_confirm: "Are you sure?" },
          class: "btn btn-danger", style: "margin-top: 0.5rem;" %>
  </div>
</div>
