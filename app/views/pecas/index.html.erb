<h2>Pecas</h2>

<div data-controller="dialog" data-create-title="Register New Peca" data-create-label="Register" data-create-url="<%= pecas_path %>">
  <div class="clients-toolbar">
    <button class="btn btn-primary" data-action="click->dialog#open">New Peca</button>
  </div>

  <dialog data-dialog-target="dialog" class="client-dialog">
    <form action="<%= pecas_path %>" method="post" class="client-form">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <h4 data-dialog-target="dialogTitle">Register New Peca</h4>
      <div class="client-field">
        <label for="peca_nome_dialog">Name</label>
        <input type="text" name="peca[nome]" id="peca_nome_dialog" data-dialog-field="nome" required>
      </div>
      <div class="client-dialog-actions">
        <button type="button" data-action="click->dialog#close" class="btn btn-secondary">Cancel</button>
        <button type="submit" class="btn btn-primary" data-dialog-target="submitBtn">Register</button>
      </div>
    </form>
  </dialog>

  <% if @pecas.any? %>
    <table class="clients-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Moldes</th>
          <th>Arquivos</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @pecas.includes(:moldes).each do |peca| %>
          <tr>
            <td><%= peca.nome %></td>
            <td><%= peca.moldes.pluck(:nome).join(", ") %></td>
            <td><%= peca.arquivos.count %></td>
            <td class="clients-table-actions">
              <button class="btn btn-secondary btn-sm"
                      data-action="click->dialog#edit"
                      data-nome="<%= peca.nome %>"
                      data-action-url="<%= peca_path(peca) %>"
                      data-method="patch"
                      data-dialog-title="Edit Peca"
                      data-submit-label="Update">Edit</button>
              <%= button_to "Delete", peca_path(peca), method: :delete,
                    form: { style: "display: inline-block;" },
                    data: { turbo_confirm: "Delete peca \"#{peca.nome}\"?" },
                    class: "btn btn-danger btn-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="gallery-empty">No pecas registered yet.</p>
  <% end %>
</div>

<div class="back-link-wrapper">
  <%= link_to "Back to Gallery", root_path, class: "back-link" %>
</div>