<h2>Peças</h2>

<div class="clients-toolbar">
  <% if pode?(:catalogo, :editar) %>
    <%= link_to "New Peça", new_peca_path, class: "btn btn-primary" %>
  <% end %>
</div>

<% if @pecas.any? %>
  <table class="clients-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Moldes</th>
        <th>Arquivos</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @pecas.each do |peca| %>
        <tr>
          <td><%= peca.nome %></td>
          <td><%= peca.moldes.select { |molde| @moldes_visiveis.include?(molde.id) }.map(&:nome).join(", ") %></td>
          <td><%= @arquivos_por_peca[peca.id].to_i %></td>
          <td class="clients-table-actions">
            <% if pode?(:catalogo, :editar) %>
              <%= link_to "Edit", edit_peca_path(peca), class: "btn btn-secondary btn-sm" %>
            <% end %>
            <% if pode?(:catalogo, :excluir) %>
              <%= button_to "Delete", peca_path(peca), method: :delete,
                    form: { style: "display: inline-block;" },
                    data: { turbo_confirm: "Move peca to the trash: \"#{peca.nome}\"?" },
                    class: "btn btn-danger btn-sm" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="gallery-empty">No pecas registered yet.</p>
<% end %>

<div class="back-link-wrapper">
  <%= link_to "Back to Gallery", root_path, class: "back-link" %>
</div>
