<% content_for :title, "Painel" %>
<%# Painel 1/4 (04/11/2026): pedidos × stages. Painel 2/4b: blocks in time
    (BlocosNoTempo), the previsão, and a sector's tab is its numbered queue
    (_fila_do_setor, as in the Fila A mockup). It refreshes itself when the
    queue changes or a turno turns, keeping what was open (Q5a). Filters,
    sectors and counters run in the page (painel_controller.js). A cliente
    final sees days only: no sectors, queue or turnos (Q4a). Painel 2/4c:
    the Linha do tempo, the second view, switched in the page (the address
    keeps it), its window in a frame of its own (_linha_do_tempo). %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<% setores = cliente_final? ? {} : @painel.colunas.slice(*%w[impressao corte estamparia conferencia entrega]) %>
<% linhas_por_pedido = @painel.linhas.flat_map(&:com_reposicoes).index_by { |linha| linha.pedido.id } %>
<div class="painel" id="painel" data-controller="painel" data-painel-visao-value="<%= @visao %>"
     data-painel-itens-url-value="<%= itens_do_painel_path("UUID") %>"
     data-painel-colunas-value="<%= @painel.colunas.keys.to_json %>"
     data-painel-virada-value="<%= proxima_virada(@painel.fila) %>">
  <%= canal_do_painel %>

  <div class="painel-topo">
    <div class="painel-titulo">
      <h2>Painel</h2>
      <div class="painel-visoes" role="group" aria-label="Visão">
        <button type="button" class="painel-visao" data-action="painel#trocarVisao" data-visao="etapas" aria-pressed="<%= @visao == "etapas" %>">Etapas</button>
        <button type="button" class="painel-visao" data-action="painel#trocarVisao" data-visao="tempo" aria-pressed="<%= @visao == "tempo" %>">Linha do tempo</button>
      </div>
      <% if (agora = agora_no_painel(@calendario)) %><span class="painel-agora" data-painel-agora><%= agora %></span><% end %>
    </div>
    <div class="painel-contadores" role="group" aria-label="Contadores">
      <button type="button" class="painel-cont painel-cont--atraso" data-action="painel#contador" data-filtro="atrasado">
        <strong data-painel-target="contagem" data-conta="atrasado">0</strong> atrasados</button>
      <button type="button" class="painel-cont painel-cont--vai-atrasar" data-action="painel#contador" data-filtro="vaiAtrasar">
        <strong data-painel-target="contagem" data-conta="vaiAtrasar">0</strong> vão atrasar</button>
      <button type="button" class="painel-cont" data-action="painel#contador" data-filtro="pendencia">
        <strong data-painel-target="contagem" data-conta="pendencia">0</strong> com pendência</button>
      <% @painel.blocos.select { |bloco| BlocosNoTempo::CONTADOS.include?(bloco.chave) }.each do |bloco| %>
        <button type="button" class="painel-cont" data-action="painel#contador" data-filtro="bloco:<%= bloco.chave %>">
          <strong data-painel-target="contagem" data-conta="bloco:<%= bloco.chave %>"><%= bloco.linhas.size %></strong> <%= bloco.nome.split(" · ").first.downcase %></button>
      <% end %>
    </div>
  </div>

  <% if setores.any? %>
    <nav class="painel-setores" aria-label="Setor">
      <button type="button" class="painel-setor painel-setor--ativo" data-action="painel#setor" data-setor="" aria-pressed="true">Todos</button>
      <% setores.each do |chave, nome| %>
        <button type="button" class="painel-setor" data-action="painel#setor" data-setor="<%= chave %>" aria-pressed="false">
          <%= nome %> <span class="painel-setor-n" data-painel-target="contagem" data-conta="fila:<%= chave %>">0</span></button>
      <% end %>
    </nav>
  <% end %>

  <div class="painel-filtros">
    <label>Tipo
      <select data-painel-target="tipo" data-action="painel#filtrar">
        <option value="">Todos</option>
        <% Pedido::ROTULOS_DOS_TIPOS.each do |tipo, rotulo| %><option value="<%= tipo %>"><%= rotulo %></option><% end %>
      </select>
    </label>
    <label>Cliente
      <select data-painel-target="cliente" data-action="painel#filtrar">
        <option value="">Todos</option>
        <% @painel.linhas.filter_map { |l| l.pedido.client }.uniq.sort_by(&:name).each do |cliente| %>
          <option value="<%= cliente.uuid %>"><%= cliente.name %></option>
        <% end %>
      </select>
    </label>
    <label><input type="checkbox" data-painel-target="pendencia" data-action="painel#filtrar"> só com pendência</label>
    <%= link_to(@entregues ? "Ocultar entregues" : "Mostrar entregues (7 dias)", painel_path(request.query_parameters.merge("entregues" => (@entregues ? nil : 1)).compact),
                class: "painel-entregues-link", data: { painel_target: "comVisao" }) %>
  </div>

  <div data-painel-target="etapas"<%= " hidden" if @visao == "tempo" %>>
  <div class="painel-legenda" aria-label="Legenda">
    <% { feita: "feita", andamento: "em andamento", pode_comecar: "pode começar", travada: "travada", pendencia: "pendência", ainda_nao: "ainda não" }.each do |estado, rotulo| %>
      <span><i class="painel-leg painel-cel--<%= estado %>"></i><%= rotulo %></span>
    <% end %>
  </div>

  <div class="painel-quadro" data-painel-target="quadro">
    <div class="painel-grade" data-painel-target="grade" style="--painel-colunas: <%= @painel.colunas.size %>">
      <div class="painel-linha painel-cab">
        <div class="painel-ped">Pedido</div>
        <% @painel.colunas.each do |chave, nome| %><div data-coluna="<%= chave %>"><%= nome %></div><% end %>
        <div>Andamento</div>
      </div>
      <% @painel.blocos.each do |bloco| %>
        <section class="painel-bloco" data-bloco="<%= bloco.chave %>">
          <div class="painel-bloco-cab"><span class="painel-bloco-nome painel-bloco-nome--<%= bloco.chave.split(":").first %>"><%= bloco.nome %></span></div>
          <div class="painel-bloco-pedidos" data-painel-target="bloco" data-bloco="<%= bloco.chave %>">
            <% bloco.linhas.each do |linha| %>
              <%= render "paineis/pedido", linha: linha, colunas: @painel.colunas, bloco: bloco.chave, fila: @painel.fila %>
            <% end %>
          </div>
          <p class="painel-vazio">Nenhum pedido.</p>
        </section>
      <% end %>
    </div>
  </div>

  <% setores.except("entrega").each do |chave, nome| %>
    <%= render "paineis/fila_do_setor", fila: @painel.fila, setor: chave, nome: nome, linhas: linhas_por_pedido %>
  <% end %>
  </div>

  <div data-painel-target="tempo"<%= " hidden" if @visao == "etapas" %>>
    <%= render "paineis/linha_do_tempo", painel: @painel, de: @de, ordem: @ordem %>
  </div>
</div>
