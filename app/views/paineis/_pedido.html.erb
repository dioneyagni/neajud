<%# A pedido on the Painel: its row, its items (loaded when opened), the
    faixa below it and its reposições under it (themselves, rendered with
    filha: true). locals: linha (LinhaDoPainel), colunas, bloco (its block's
    key, BlocosNoTempo), fila (FilaDeProducao, for the faixa's timeline), filha %>
<% pedido = linha.pedido %>
<% filha = local_assigns.fetch(:filha, false) %>
<div class="painel-pedido<%= " painel-pedido--reposicao" if filha %>" id="painel_<%= pedido.uuid %>" data-uuid="<%= pedido.uuid %>" data-bloco="<%= bloco %>"
     data-tipo="<%= pedido.tipo %>" data-cliente="<%= pedido.client&.uuid %>" data-filas="<%= linha.filas.join(" ") %>"
     data-pendencia="<%= linha.pendencia? %>" data-atrasado="<%= linha.atrasado? %>" data-vai-atrasar="<%= linha.com_reposicoes.any?(&:vai_atrasar?) %>">
  <div class="painel-linha">
    <div class="painel-ped">
      <button type="button" class="painel-ped-btn" data-action="painel#abrir" aria-expanded="false">
        <span class="painel-pid">#<%= pedido.uuid.first(8) %> <small><%= Pedido::ROTULOS_DOS_TIPOS.fetch(pedido.tipo) %></small></span>
        <% if pedido.reposicao? %>
          <span class="painel-ref painel-ref--reposicao">↻ reposição de #<%= pedido.reposicao_de.uuid.first(8) %> · <%= pluralize(linha.pecas_da_reposicao, "peça", plural: "peças") %></span>
        <% else %>
          <span class="painel-ref"><%= pedido.client&.name || "sem cliente" %></span>
        <% end %>
      </button>
      <% if linha.juntando %>
        <span class="painel-selo-reposicao">↻ juntando reposição: <%= pluralize(linha.juntando, "peça", plural: "peças") %></span>
      <% end %>
      <% if pedido.itens_pedido.size > 1 %>
        <button type="button" class="painel-itens-btn" data-action="painel#itens" aria-expanded="false"><%= pedido.itens_pedido.size %> itens</button>
      <% end %>
    </div>
    <% colunas.each_key do |chave| %>
      <%= render "paineis/celula", celula: linha.celulas.fetch(chave), coluna: chave %>
    <% end %>
    <div class="painel-fim">
      <strong><%= linha.percentual %>%</strong>
      <% if linha.prazo %>
        <span class="<%= "painel-atrasado" if linha.atrasado? %>">prazo <%= linha.prazo.strftime("%d/%m") %></span>
        <%= selo_da_folga(linha.folga) unless linha.atrasado? %>
      <% else %>
        <span>sem prazo</span>
      <% end %>
      <span class="painel-previsao" data-previsao><%= texto_da_previsao(linha.previsao) if linha.previsao %></span>
    </div>
  </div>
  <div class="painel-itens" data-painel-itens hidden></div>
  <div class="painel-faixa" hidden>
    <%= render "paineis/faixa", linha: linha, fila: fila %>
  </div>
  <% if linha.reposicoes.any? %>
    <div class="painel-reposicoes">
      <% linha.reposicoes.each do |reposicao| %>
        <%= render "paineis/pedido", linha: reposicao, colunas: colunas, bloco: bloco, fila: fila, filha: true %>
      <% end %>
    </div>
  <% end %>
</div>
