<%# The faixa's timeline of one pedido (Painel 2/4c, Q5a): a lane per stage,
    a column per turno (a day for a cliente final), the stage's share of
    each turno filled; now outlined, the turnos past the deadline hatched.
    Nothing when nothing is ahead in the queue. Painel 3/4b2 (Q8a): the
    first plan dashed in the same cells, the turnos already over greyed, an
    arrow from the turno it was to end in to the one it ends in now — every
    item placed by row and column, so the arrow lies over the cells.
    locals: tempo (TempoDoPedido or nil), linha %>
<% if tempo %>
  <div class="painel-tdp" role="group" aria-label="Linha do tempo do pedido">
    <div class="painel-tdp-topo">
      <strong>Linha do tempo do pedido</strong>
      <% if linha.prazo %><span>prazo <%= dia_com_semana(linha.prazo) %></span><% end %>
      <% if tempo.restantes.positive? %><span>+ <%= pluralize(tempo.restantes, "turno", plural: "turnos") %> depois</span><% end %>
      <% if tempo.raias.any? { |raia| raia.planejadas.any? } %><span class="painel-tdp-legenda"><i class="painel-tdp-plano"></i> era o programado</span><% end %>
    </div>
    <div class="painel-tdp-rolagem">
      <div class="painel-tdp-grade" style="--tdp-colunas: <%= tempo.colunas.size %>">
        <div class="painel-tdp-nome" style="grid-area: 1 / 1"></div>
        <% tempo.colunas.each_with_index do |coluna, i| %>
          <div class="painel-tdp-col<%= classes_da_coluna_do_tempo(coluna) %>" style="grid-area: 1 / <%= i + 2 %>" data-tdp-coluna>
            <b><%= dia_com_semana(coluna.data) %></b><% if coluna.nome %><span><%= coluna.nome %></span><% end %>
          </div>
        <% end %>
        <% tempo.raias.each_with_index do |raia, r| %>
          <% linha_da_raia = r + 2 %>
          <div class="painel-tdp-nome" style="grid-area: <%= linha_da_raia %> / 1" data-tdp-raia="<%= raia.etapa.chave %>" data-estado="<%= raia.estado %>"><%= raia.etapa.nome %></div>
          <% if raia.celulas.empty? %>
            <div class="painel-tdp-nota painel-tdp-nota--<%= raia.estado %>" style="grid-area: <%= linha_da_raia %> / 2 / auto / span <%= tempo.colunas.size %>">
              <%= raia.estado == :feita ? "✓ feita" : motivo_da_vez(raia.vez) %></div>
          <% else %>
            <% raia.celulas.each_with_index do |parte, i| %>
              <div class="painel-tdp-cel<%= classes_da_coluna_do_tempo(tempo.colunas[i]) %>" style="grid-area: <%= linha_da_raia %> / <%= i + 2 %>">
                <% if (plano = raia.planejadas[i]) %><i class="painel-tdp-plano" style="width: <%= (plano * 100).round %>%" data-tdp-plano></i><% end %>
                <% if parte %><i class="painel-tdp-parte painel-tdp-parte--<%= raia.estado %>" style="width: <%= (parte * 100).round %>%"></i><% end %>
              </div>
            <% end %>
            <% if (seta = raia.seta) %>
              <% de, ate = [ seta.de, seta.para ].minmax %>
              <div class="painel-tdp-seta<%= " painel-tdp-seta--antes" if seta.turnos.negative? %>" style="grid-area: <%= linha_da_raia %> / <%= de + 2 %> / auto / <%= ate + 3 %>"
                   data-tdp-seta="<%= seta.turnos %>" title="era para terminar <%= pluralize(seta.turnos.abs, "turno", plural: "turnos") %> <%= seta.turnos.positive? ? "antes" : "depois" %>">
                <span><%= seta.turnos.positive? ? "+" : "−" %><%= pluralize(seta.turnos.abs, "turno", plural: "turnos") %></span>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
