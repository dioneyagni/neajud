<%# What opens below a pedido (Q3a): % done, start, deadline, the previsão
    (Painel 2/4b), the path of its stages with each one's time in the queue,
    its own timeline (Painel 2/4c, Q5a), what holds it, links. The same in
    both views. locals: linha, fila (FilaDeProducao) %>
<% pedido = linha.pedido %>
<% vezes = linha.previsao ? linha.previsao.vezes.index_by { |vez| vez.etapa.chave } : {} %>
<div class="painel-faixa-num">
  <span class="painel-pct"><%= linha.percentual %>%</span>
  <% if linha.reposicoes.any? %>
    <span data-percentuais>(pedido <%= linha.percentual_proprio %>% · reposição <%= linha.percentual_das_reposicoes %>%)</span>
  <% end %>
  <span>Início <b><%= linha.inicio ? linha.inicio.strftime("%d/%m %H:%M") : "—" %></b></span>
  <span>Prazo <b class="<%= "painel-atrasado" if linha.atrasado? %>"><%= linha.prazo ? linha.prazo.strftime("%d/%m/%Y") : "sem prazo" %><%= " · atrasado" if linha.atrasado? %></b></span>
  <span data-faixa-previsao>Previsão <b><%= texto_da_previsao(linha.previsao) %></b> <%= selo_da_folga(linha.folga) %></span>
</div>
<div class="painel-caminho" aria-label="Caminho do pedido">
  <% %w[arquivos comercial material].each do |chave| %>
    <% celula = linha.celulas[chave] %>
    <% next if celula.estado == :nao_tem %>
    <span class="painel-no painel-cel--<%= celula.estado %>"><strong><%= LinhaDoPainel::COLUNAS[chave] %></strong> <%= celula.texto %></span>
    <span class="painel-seta" aria-hidden="true">→</span>
  <% end %>
  <% linha.caminho.each do |passo| %>
    <span class="painel-passo<%= " painel-passo--paralelo" if passo.size > 1 %>">
      <% passo.each do |etapa| %>
        <% celula = linha.celulas[linha.coluna_da_etapa(etapa)] %>
        <span class="painel-no painel-cel--<%= celula.estado %>" data-etapa="<%= etapa.chave %>"><strong><%= etapa.nome %></strong> <%= celula.texto %>
          <% if (vez = vezes[etapa.chave]) %><small class="painel-no-tempo"><%= periodo_da_vez(vez) %></small><% end %></span>
      <% end %>
    </span>
    <span class="painel-seta" aria-hidden="true">→</span>
  <% end %>
  <% entrega = linha.celulas["entrega"] %>
  <span class="painel-no painel-cel--<%= entrega.estado %>"><strong>Entrega</strong> <%= entrega.texto %></span>
</div>
<%= render "paineis/tempo_do_pedido", tempo: TempoDoPedido.call(linha, fila: fila, cliente_final: cliente_final?), linha: linha %>
<div class="painel-faixa-info">
  <div class="painel-caixa">
    <h4>Trava</h4>
    <p data-trava><%= linha.trava || "nada trava este pedido" %></p>
  </div>
  <% if linha.juntando || linha.reposicoes.any? || pedido.reposicao? %>
    <div class="painel-caixa" data-reposicao>
      <h4>Reposição</h4>
      <% if pedido.reposicao? %>
        <p>Peças que faltaram no pedido <%= link_to "##{pedido.reposicao_de.uuid.first(8)}", resumo_pedido_path(pedido.reposicao_de) %>.</p>
      <% end %>
      <% linha.reposicoes.each do |reposicao| %>
        <p><%= link_to "##{reposicao.pedido.uuid.first(8)}", resumo_pedido_path(reposicao.pedido) %> · <%= pluralize(reposicao.pecas_da_reposicao, "peça", plural: "peças") %> · <%= reposicao.percentual %>%</p>
      <% end %>
      <% if linha.juntando %>
        <p>Juntando <%= pluralize(linha.juntando, "peça", plural: "peças") %><% unless cliente_final? %> — <%= link_to "gerar no resumo", resumo_pedido_path(pedido) %><% end %>.</p>
      <% end %>
    </div>
  <% end %>
  <div class="painel-caixa">
    <h4>Links</h4>
    <p class="painel-links">
      <%= link_to "Resumo do pedido", resumo_pedido_path(pedido) %>
      <% if pedido.saiu_do_rascunho? && !cliente_final? %>
        <% linha.caminho.flatten.each do |etapa| %><%= link_to etapa.nome, caminho_da_etapa(pedido, etapa) %><% end %>
      <% end %>
    </p>
  </div>
</div>
