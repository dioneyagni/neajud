<%# The dono's production parameters (Etapa 2.2, 1/3). %>
<h2>Production parameters</h2>
<p class="funcoes-intro">Used to check each baixa: the expected metragem comes from the files themselves
  (the arte's size on the paper, the DXF's fit on the fabric).</p>

<%= form_with model: @empresa, url: parametros_path, method: :patch, class: "client-form parametros-form" do |form| %>
  <%# Etapa 2.3: the paper is a material; its width gives the artes' meters per piece. %>
  <% papeis = visiveis(MateriaPrima).papeis.includes(:grupo_material, :cor_material).order(:largura) %>
  <div class="client-field">
    <label for="empresa_papel_padrao_uuid">Default paper</label>
    <select name="empresa[papel_padrao_uuid]" id="empresa_papel_padrao_uuid">
      <option value="">None — use the width below</option>
      <% papeis.each do |papel| %>
        <option value="<%= papel.uuid %>" <%= "selected" if @empresa.papel_padrao == papel %>><%= papel.nome_completo %> (<%= papel.largura_mm %> mm)</option>
      <% end %>
    </select>
    <small><%= papeis.any? ? "Its width is used to fit the artes on the paper." : "No paper registered yet: set a material's type to Papel on the Materials page." %></small>
  </div>
  <div class="client-field">
    <%= form.label :largura_papel_mm, "Paper width without a default paper (mm)" %>
    <%= form.number_field :largura_papel_mm, min: 1, step: 1, required: true %>
    <small>Only used while no default paper is chosen, e.g. 1600 for 1,60 m.</small>
  </div>
  <div class="client-field">
    <%= form.label :tolerancia_abaixo_pct, "Warn below the expected by more than (%)" %>
    <%= form.number_field :tolerancia_abaixo_pct, min: 0, max: 100, step: 1, required: true %>
  </div>
  <div class="client-field">
    <%= form.label :tolerancia_acima_pct, "Warn above the expected by more than (%)" %>
    <%= form.number_field :tolerancia_acima_pct, min: 0, max: 1000, step: 1, required: true %>
  </div>
  <%# Etapa 2.4: what a pair costs — the meters printed and the pieces cut. %>
  <div class="client-field">
    <label for="empresa_custo_impressao_metro">Printing cost per meter (R$)</label>
    <input type="text" inputmode="decimal" name="empresa[custo_impressao_metro]" id="empresa_custo_impressao_metro"
           value="<%= @empresa.custo_impressao_metro && number_with_precision(@empresa.custo_impressao_metro, precision: 2, separator: ",") %>">
    <small>Paper, ink and machine for one meter printed. With the cutting cost, gives each arte's cost per pair.</small>
  </div>
  <div class="client-field">
    <label for="empresa_custo_corte_peca">Cutting cost per piece (R$)</label>
    <input type="text" inputmode="decimal" name="empresa[custo_corte_peca]" id="empresa_custo_corte_peca"
           value="<%= @empresa.custo_corte_peca && number_with_precision(@empresa.custo_corte_peca, precision: 4, separator: ",", strip_insignificant_zeros: true) %>">
  </div>
  <%# Etapa 2.6a (decided 13/10/2026): the DTF film was just a width; since
      2.3d1 it is a material too, whose width replaces the typed one. %>
  <% filmes = visiveis(MateriaPrima).filmes_dtf.includes(:grupo_material, :cor_material).order(:largura) %>
  <fieldset class="parametros-dtf" id="parametros-dtf">
    <legend>DTF film</legend>
    <div class="client-field">
      <label for="empresa_filme_dtf_padrao_uuid">Default film</label>
      <select name="empresa[filme_dtf_padrao_uuid]" id="empresa_filme_dtf_padrao_uuid">
        <option value="">None — use the width below</option>
        <% filmes.each do |filme| %>
          <option value="<%= filme.uuid %>" <%= "selected" if @empresa.filme_dtf_padrao == filme %>><%= filme.nome_completo %> (<%= filme.largura_mm %> mm)</option>
        <% end %>
      </select>
      <small><%= filmes.any? ? "Its width fits the etiquetas; a pedido may print on another film of the same width." : "No DTF film registered yet: set a material's type to Filme DTF on the Materials page." %></small>
    </div>
    <div class="client-field">
      <%= form.label :largura_filme_dtf_mm, "Film width without a default film (mm)" %>
      <%= form.number_field :largura_filme_dtf_mm, min: 1, step: 1, required: true %>
    </div>
    <div class="client-field">
      <%= form.label :margem_filme_dtf_mm, "Margin at each edge (mm)" %>
      <%= form.number_field :margem_filme_dtf_mm, min: 0, step: 1, required: true %>
      <small class="parametros-dtf-util"><%= @empresa.largura_util_filme_dtf_mm %> mm left for the etiquetas.</small>
    </div>
    <div class="client-field">
      <label for="empresa_espacamento_dtf_mm">Space between etiquetas (mm)</label>
      <input type="text" inputmode="decimal" name="empresa[espacamento_dtf_mm]" id="empresa_espacamento_dtf_mm" required
             value="<%= number_with_precision(@empresa.espacamento_dtf_mm, precision: 2, separator: ",", strip_insignificant_zeros: true) %>">
      <small>Both ways, across and along the film. An etiqueta may set its own on its page.</small>
    </div>
    <div class="client-field">
      <%= form.label :fileiras_extras_dtf, "Extra rows per pedido" %>
      <%= form.number_field :fileiras_extras_dtf, min: 0, step: 1, required: true %>
      <small>Printed beyond what was ordered, to cover losses; a pedido may change it.</small>
    </div>
    <%# Etapa 2.6c: the dono's DTF prices; a client may have his own (his page). %>
    <div class="client-field">
      <label for="empresa_preco_metro_dtf">Price per meter (R$)</label>
      <input type="text" inputmode="decimal" name="empresa[preco_metro_dtf]" id="empresa_preco_metro_dtf"
             value="<%= @empresa.preco_metro_dtf && number_with_precision(@empresa.preco_metro_dtf, precision: 2, separator: ",") %>">
      <small>Each etiqueta's unit price is calculated from it and its fit on the film.</small>
    </div>
    <div class="client-field">
      <label for="empresa_preco_corte_dtf">Price per unit cut (R$)</label>
      <input type="text" inputmode="decimal" name="empresa[preco_corte_dtf]" id="empresa_preco_corte_dtf"
             value="<%= @empresa.preco_corte_dtf && number_with_precision(@empresa.preco_corte_dtf, precision: 4, separator: ",", strip_insignificant_zeros: true) %>">
      <small>A pedido delivered cut pays it on every unit printed.</small>
    </div>
    <div class="client-field">
      <%= form.label :cobranca_dtf, "Charge a pedido by" %>
      <%= form.select :cobranca_dtf, [ [ "Quantity", "quantidade" ], [ "Meter", "metro" ] ] %>
    </div>
    <div class="client-field">
      <%= form.label :cobrar_excedente_dtf, "Charge the excess (by quantity)" %>
      <%= form.select :cobrar_excedente_dtf, [ [ "Yes", true ], [ "No", false ] ] %>
      <small>The units printed beyond the ordered ones. A client or a pedido may say otherwise.</small>
    </div>
  </fieldset>
  <%# Etapa 2.7b: the tecido's print per meter (the same for a corrida and a
      cor lisa, any width; a client may have his own) and the minimum per item. %>
  <fieldset class="parametros-tecido" id="parametros-tecido">
    <legend>Tecido (estampa corrida e cor lisa)</legend>
    <div class="client-field">
      <label for="empresa_preco_impressao_metro_tecido">Print price per meter (R$)</label>
      <input type="text" inputmode="decimal" name="empresa[preco_impressao_metro_tecido]" id="empresa_preco_impressao_metro_tecido"
             value="<%= @empresa.preco_impressao_metro_tecido && number_with_precision(@empresa.preco_impressao_metro_tecido, precision: 2, separator: ",") %>">
      <small>Any width. The empresa's fabric is charged apart, at its material's price.</small>
    </div>
    <div class="client-field">
      <label for="empresa_metragem_minima_tecido">Minimum meters per item</label>
      <input type="text" inputmode="decimal" name="empresa[metragem_minima_tecido]" id="empresa_metragem_minima_tecido"
             value="<%= @empresa.metragem_minima_tecido && number_with_precision(@empresa.metragem_minima_tecido, precision: 1, separator: ",", strip_insignificant_zeros: true) %>">
      <small>Below it an item waits for someone with "aprovar abaixo do mínimo". Blank = no minimum.</small>
    </div>
  </fieldset>
  <%= form.submit "Save", class: "btn btn-primary" %>
<% end %>
