<h2><%= modelo.new_record? ? "Register New Modelo" : "Edit Modelo" %></h2>

<%= form_with model: modelo, local: true, class: "modelo-form" do |f| %>
  <% if modelo.errors.any? %>
    <div class="flash flash--error">
      <%= modelo.errors.full_messages.join(", ") %>
    </div>
  <% end %>

  <div class="client-field">
    <%= f.label :nome, "Name" %>
    <%= f.text_field :nome, required: true, autofocus: true %>
  </div>

  <div class="modelo-componentes-section"
       data-controller="componentes"
       data-componentes-search-url-value="<%= search_pecas_path %>"
       data-componentes-register-url-value="<%= new_peca_path(modelo_uuid: modelo.uuid) %>">
    <h3>Componentes</h3>

    <div class="componentes-buscar">
      <input type="text" class="combobox-input componentes-input"
             placeholder="Buscar peça..."
             data-componentes-target="input"
             data-action="input->componentes#search blur->componentes#blur">
      <div class="combobox-results" data-componentes-target="results"></div>
    </div>

    <ul class="componentes-lista" data-componentes-target="lista">
      <% modelo.pecas.each do |peca| %>
        <li data-peca-id="<%= peca.uuid %>">
          <span class="componente-nome"><%= peca.nome %></span>
          <input type="hidden" name="modelo[peca_uuids][]" value="<%= peca.uuid %>">
          <button type="button" class="btn btn-danger btn-sm" data-action="click->componentes#remove">&times;</button>
        </li>
      <% end %>
    </ul>

    <template data-componentes-target="model">
      <li>
        <span class="componente-nome"></span>
        <input type="hidden" name="modelo[peca_uuids][]" value="">
        <button type="button" class="btn btn-danger btn-sm" data-action="click->componentes#remove">&times;</button>
      </li>
    </template>
  </div>

  <div style="margin-top: 1.5rem; display: flex; gap: 0.5rem;">
    <%= f.submit modelo.new_record? ? "Register Modelo" : "Update Modelo", class: "btn btn-primary" %>
    <%= link_to "Cancel", modelos_path, class: "btn btn-secondary" %>
  </div>
<% end %>

<div class="back-link-wrapper">
  <%= link_to "Back to Modelos", modelos_path, class: "back-link" %>
</div>
