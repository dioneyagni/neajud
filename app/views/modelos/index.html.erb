<h2>Modelos</h2>

<p class="page-hint">
  The official Neajud list: every company uses the same products and models.
  To add one, ask Neajud.
</p>

<% @produtos.each do |produto| %>
  <section class="catalogo-produto" data-produto="<%= produto.nome %>">
    <h3><%= produto.nome %>
      <span class="catalogo-grade"><%= produto.grade.any? ? "Grade #{produto.grade.first}–#{produto.grade.last}" : "No grade" %></span>
    </h3>
    <table class="clients-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Abbreviation</th>
          <th>Arquivos</th>
        </tr>
      </thead>
      <tbody>
        <% produto.modelos.select { |m| !m.excluido? }.sort_by(&:nome).each do |modelo| %>
          <tr>
            <td><%= link_to modelo.nome, modelo_path(modelo) %></td>
            <td><%= modelo.abreviacao %></td>
            <td><%= @arquivos_por_modelo.fetch(modelo.id, 0) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>

<div class="back-link-wrapper">
  <%= link_to "Back to Gallery", root_path, class: "back-link" %>
</div>
