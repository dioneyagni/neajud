<h2>Modelos</h2>

<div class="clients-toolbar">
  <% if pode?(:catalogo, :editar) %>
    <%= link_to "New Modelo", new_modelo_path, class: "btn btn-primary" %>
  <% end %>
</div>

<% if @modelos.any? %>
  <table class="clients-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Peças</th>
        <th>Arquivos</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @modelos.each do |modelo| %>
        <tr>
          <td><%= link_to modelo.nome, modelo_path(modelo) %></td>
          <td><%= modelo.pecas.map(&:nome).join(", ") %></td>
          <td><%= modelo.arquivos_count %></td>
          <td class="clients-table-actions">
            <% if pode?(:catalogo, :editar) %>
              <%= link_to "Edit", edit_modelo_path(modelo), class: "btn btn-secondary btn-sm" %>
            <% end %>
            <% if pode?(:catalogo, :excluir) %>
              <%= button_to "Delete", modelo_path(modelo), method: :delete,
                    form: { style: "display: inline-block;" },
                    data: { turbo_confirm: "Move modelo to the trash: \"#{modelo.nome}\"?" },
                    class: "btn btn-danger btn-sm" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="gallery-empty">No modelos registered yet.</p>
<% end %>

<div class="back-link-wrapper">
  <%= link_to "Back to Gallery", root_path, class: "back-link" %>
</div>
