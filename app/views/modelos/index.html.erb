<h2>Modelos</h2>

<div data-controller="dialog" data-create-title="Register New Modelo" data-create-label="Register" data-create-url="<%= modelos_path %>">
  <div class="clients-toolbar">
    <button class="btn btn-primary" data-action="click->dialog#open">New Modelo</button>
  </div>

  <dialog data-dialog-target="dialog" class="client-dialog">
    <form action="<%= modelos_path %>" method="post" class="client-form">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <h4 data-dialog-target="dialogTitle">Register New Modelo</h4>
      <div class="client-field">
        <label for="modelo_nome_dialog">Name</label>
        <input type="text" name="modelo[nome]" id="modelo_nome_dialog" data-dialog-field="nome" required>
      </div>
      <div class="client-field">
        <label for="modelo_client_id_dialog">Client</label>
        <select name="modelo[client_id]" id="modelo_client_id_dialog" data-dialog-field="clientId" required>
          <option value="">Select a client...</option>
          <% Client.order(:name).each do |c| %>
            <option value="<%= c.id %>"><%= c.name %></option>
          <% end %>
        </select>
      </div>
      <div class="client-field">
        <label for="modelo_molde_id_dialog">Mold</label>
        <select name="modelo[molde_id]" id="modelo_molde_id_dialog" data-dialog-field="moldeId">
          <option value="">Select a mold...</option>
          <% Molde.order(:nome).each do |m| %>
            <option value="<%= m.id %>"><%= m.nome %></option>
          <% end %>
        </select>
      </div>
      <div class="client-dialog-actions">
        <button type="button" data-action="click->dialog#close" class="btn btn-secondary">Cancel</button>
        <button type="submit" class="btn btn-primary" data-dialog-target="submitBtn">Register</button>
      </div>
    </form>
  </dialog>

  <% if @modelos.any? %>
    <table class="clients-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Client</th>
          <th>Mold</th>
          <th>Stamps</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @modelos.each do |modelo| %>
          <tr>
            <td><%= modelo.nome %></td>
            <td><%= modelo.client.name %></td>
            <td><%= modelo.molde&.nome || "—" %></td>
            <td><%= modelo.stamps.count %></td>
            <td class="clients-table-actions">
              <button class="btn btn-secondary btn-sm"
                      data-action="click->dialog#edit"
                      data-nome="<%= modelo.nome %>"
                      data-client-id="<%= modelo.client_id %>"
                      data-molde-id="<%= modelo.molde_id %>"
                      data-action-url="<%= modelo_path(modelo) %>"
                      data-method="patch"
                      data-dialog-title="Edit Modelo"
                      data-submit-label="Update">Edit</button>
              <%= button_to "Delete", modelo_path(modelo), method: :delete,
                    form: { style: "display: inline-block;" },
                    data: { turbo_confirm: "Delete modelo \"#{modelo.nome}\"?" },
                    class: "btn btn-danger btn-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="gallery-empty">No modelos registered yet.</p>
  <% end %>
</div>

<div class="back-link-wrapper">
  <%= link_to "Back to Gallery", root_path, class: "back-link" %>
</div>