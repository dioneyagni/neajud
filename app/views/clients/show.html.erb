<h2><%= @client.name %> <%= selo_excluido(@client) %></h2>

<div class="stamp-detail">
  <div class="stamp-detail-info">
    <div class="stamp-detail-grid">
      <div class="stamp-detail-section">
        <h3>Details</h3>
        <dl class="detail-grid">
          <dt>Name</dt>
          <dd><%= @client.name %></dd>
          <dt>Responsible</dt>
          <dd><%= @client.responsible %></dd>
          <dt>Arquivos</dt>
          <dd><%= @client.arquivos.count %></dd>
        </dl>
      </div>

      <div class="stamp-detail-section">
        <h3>Actions</h3>
        <div style="display: flex; gap: 0.5rem;">
          <%= link_to "All Clients", clients_path, class: "btn btn-secondary" %>
          <%= link_to "All Moldes", moldes_path, class: "btn btn-secondary" %>
        </div>
      </div>

      <%# Cortes not organized yet, or organized but linked to no molde
          (01/10/2026): they had a client and showed nowhere on its page.
          Cortes are Catálogo, so only who sees the Catálogo sees them. %>
      <% if pode?(:catalogo, :ver) && @cortes_pendentes.any? %>
        <div class="stamp-detail-section stamp-detail-section--full cliente-cortes-pendentes" id="cortes-pendentes">
          <h3>Cortes não organizados <span class="badge-count"><%= @cortes_pendentes.size %></span></h3>
          <p class="page-hint">Open a corte to organize it (modelo, piece, sizes) and link it to one of this client's moldes.</p>
          <%= turbo_stream_from "arquivos" %>
          <div class="gallery">
            <% @cortes_pendentes.each do |corte| %>
              <%= render partial: "arquivos/card", locals: { arquivo: corte } %>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="stamp-detail-section stamp-detail-section--full" data-controller="dialog" data-create-title="Register New Molde" data-create-label="Register" data-create-url="<%= moldes_path %>">
        <div class="clients-toolbar">
          <h3 style="margin-bottom:0">Moldes</h3>
          <% if pode?(:catalogo, :editar) %>
            <button class="btn btn-primary" data-action="click->dialog#open">New Molde</button>
          <% end %>
        </div>

        <dialog data-dialog-target="dialog" class="client-dialog">
          <form action="<%= moldes_path %>" method="post" class="client-form">
            <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
            <input type="hidden" name="molde[client_uuid]" value="<%= @client.uuid %>">
            <h4 data-dialog-target="dialogTitle">Register New Molde</h4>
            <div class="client-field">
              <label for="molde_nome_dialog">Name</label>
              <input type="text" name="molde[nome]" id="molde_nome_dialog" data-dialog-field="nome" required>
            </div>
            <%= render "moldes/modelo_e_grade", sufixo: "dialog_client", editavel: true %>
            <div class="client-dialog-actions">
              <button type="button" data-action="click->dialog#close" class="btn btn-secondary">Cancel</button>
              <button type="submit" class="btn btn-primary" data-dialog-target="submitBtn">Register</button>
            </div>
          </form>
        </dialog>

        <% if @moldes.any? %>
          <table class="clients-table" style="margin-top: 0.75rem">
            <thead>
              <tr>
<th>Name</th>
                  <th>Model</th>
                  <th>Arquivos</th>
                  <th>View</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @moldes.each do |molde| %>
                <tr>
                  <td><%= molde.nome %></td>
                  <td><%= molde.modelo&.nome || "—" %></td>
                  <td><%= molde.arquivos.count %></td>
                  <td><%= link_to "Show", molde_path(molde), class: "btn btn-secondary btn-sm" %></td>
                  <td class="clients-table-actions">
                    <% if pode?(:catalogo, :editar) %>
                      <button class="btn btn-secondary btn-sm"
                              data-action="click->dialog#edit"
                              data-nome="<%= molde.nome %>"
                              data-modelo-uuid="<%= molde.modelo&.uuid %>"
                              data-tamanho-inicial="<%= molde.tamanho_inicial %>"
                              data-tamanho-final="<%= molde.tamanho_final %>"
                              data-action-url="<%= molde_path(molde) %>"
                              data-method="patch"
                              data-dialog-title="Edit Molde"
                              data-submit-label="Update">Edit</button>
                    <% end %>
                    <% if pode?(:catalogo, :excluir) %>
                      <%= button_to "Delete", molde_path(molde), method: :delete,
                            form: { style: "display: inline-block;" },
                            data: { turbo_confirm: "Move molde to the trash: \"#{molde.nome}\"?" },
                            class: "btn btn-danger btn-sm" %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="gallery-empty" style="margin-top: 0.75rem">No moldes for this client yet.</p>
        <% end %>
      <% @arquivos_by_molde.each do |molde, arquivos| %>
        <div class="stamp-detail-section stamp-detail-section--full">
          <h3><%= molde.nome %>
            <span style="font-weight:normal;font-size:0.85rem;color:var(--text-muted);">
              — <%= molde.client.name %><%= molde.modelo ? ", #{molde.modelo.nome}" : "" %>
            </span>
            <%= link_to "Show", molde_path(molde), class: "btn btn-secondary btn-sm", style: "float:right" %>
          </h3>
          <% cortes = pode?(:catalogo, :ver) ? @cortes_por_molde.fetch(molde) : [] %>
          <% if cortes.any? %>
            <h4 class="cliente-molde-subtitulo">Cortes</h4>
            <div class="gallery cliente-molde-cortes">
              <% cortes.each do |corte| %>
                <%= render partial: "arquivos/card", locals: { arquivo: corte } %>
              <% end %>
            </div>
          <% end %>
          <% if arquivos.any? %>
            <%= turbo_stream_from "arquivos" %>
            <% if cortes.any? %><h4 class="cliente-molde-subtitulo">Artes</h4><% end %>
            <div class="gallery cliente-molde-artes">
              <% arquivos.each do |arquivo| %>
                <%= render partial: "arquivos/card", locals: { arquivo: arquivo } %>
              <% end %>
            </div>
          <% elsif cortes.empty? %>
            <p class="gallery-empty" style="margin-top: 0.75rem">No arquivos for this mold yet.</p>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="stamp-detail-section stamp-detail-section--full" style="margin-top: 1.5rem;">
      <h3>Materials</h3>
      <% if @client_materiais.any? %>
        <table class="clients-table" style="margin-top: 0.5rem;">
          <thead>
            <tr>
              <th>Group</th>
              <th>Color</th>
              <th>Width</th>
              <th>Weight</th>
              <th>Balance</th>
            </tr>
          </thead>
          <tbody>
            <% @client_materiais.each do |mp| %>
              <tr>
                <td><%= mp.grupo_material.nome %></td>
                <td><%= mp.cor_material.nome %></td>
                <td><%= mp.largura %></td>
                <td><%= mp.gramatura %></td>
                <td><%= @client_saldos[mp.id] || 0 %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="gallery-empty" style="margin-top: 0.5rem;">No materials for this client yet.</p>
      <% end %>
    </div>
  </div>
</div>
