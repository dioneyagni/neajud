<h2>Clients</h2>

<div data-controller="dialog" data-create-title="Register New Client" data-create-label="Register" data-create-url="<%= clients_path %>">
  <div class="clients-toolbar">
    <button class="btn btn-primary" data-action="click->dialog#open">New Client</button>
  </div>

  <dialog data-dialog-target="dialog" class="client-dialog">
    <form action="<%= clients_path %>" method="post" data-dialog-target="clientForm" class="client-form">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <h4 data-dialog-target="dialogTitle">Register New Client</h4>
      <div class="client-field">
        <label for="client_name_dialog">Name</label>
        <input type="text" name="client[name]" id="client_name_dialog" data-dialog-field="name" required>
      </div>
      <div class="client-field">
        <label for="client_responsible_dialog">Responsible</label>
        <input type="text" name="client[responsible]" id="client_responsible_dialog" data-dialog-field="responsible" required>
      </div>
      <div class="client-dialog-actions">
        <button type="button" data-action="click->dialog#close" class="btn btn-secondary">Cancel</button>
        <button type="submit" class="btn btn-primary" data-dialog-target="submitBtn">Register</button>
      </div>
    </form>
  </dialog>

  <% if @clients.any? %>
    <table class="clients-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Responsible</th>
          <th>Modelos</th>
          <th>Stamps</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @clients.each do |client| %>
          <tr>
            <td><%= link_to client.name, client_path(client) %></td>
            <td><%= client.responsible %></td>
            <td><%= client.modelos.count %></td>
            <td><%= client.stamps.count %></td>
            <td class="clients-table-actions">
              <button class="btn btn-secondary btn-sm"
                      data-action="click->dialog#edit"
                      data-name="<%= client.name %>"
                      data-responsible="<%= client.responsible %>"
                      data-action-url="<%= client_path(client) %>"
                      data-method="patch"
                      data-dialog-title="Edit Client"
                      data-submit-label="Update">Edit</button>
              <%= button_to "Delete", client_path(client), method: :delete,
                    form: { style: "display: inline-block;" },
                    data: { turbo_confirm: "Delete client \"#{client.name}\"?" },
                    class: "btn btn-danger btn-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="gallery-empty">No clients registered yet.</p>
  <% end %>
</div>

<div class="back-link-wrapper">
  <%= link_to "Back to Gallery", root_path, class: "back-link" %>
</div>