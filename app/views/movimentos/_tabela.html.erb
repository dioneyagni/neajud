<%# The movement ledger, on the Materials and Movements pages. Etapa 2.3d2:
    a pedido's stock out links to it, and a trashed pedido's says it no
    longer counts (MovimentoEstoque.que_contam). Etapa 2.3e: a baixa's
    adjustment names its stage, and stops counting once the baixa is undone.
    Dublagem 5a: an ordem de dublagem's movements name it (linked for the
    team; the ordens are the factory's). Decided 05/11/2026: an entry
    launched at a baixa or a delivery names it, who launched it and who
    authorized it (the names only for the team). %>
<div class="materiais-tabela-wrap">
  <table class="clients-table movimentos-tabela">
    <thead>
      <tr>
        <th>Date</th>
        <th>Owner</th>
        <th>Material</th>
        <th>Type</th>
        <th>Qty</th>
        <th>Pedido</th>
        <th>Unit cost</th>
        <th>Total</th>
      </tr>
    </thead>
    <tbody>
      <% movimentos.each do |m| %>
        <tr data-movimento="<%= m.uuid %>">
          <td><%= l m.created_at, format: :short %></td>
          <td><%= m.dono %></td>
          <td><%= m.materia_prima.nome_completo %></td>
          <td><%= m.tipo == "entrada" ? "In" : "Out" %></td>
          <td><%= quantidade_do_material(m.quantidade, m.materia_prima) %></td>
          <td data-pedido="<%= m.pedido&.uuid %>">
            <% if m.pedido %>
              <%= link_to "##{m.pedido.uuid.first(8)}", resumo_pedido_path(m.pedido) %>
              <% if m.baixa_producao %><span class="movimento-etapa">· <%= EtapasProducao.etapa(m.pedido.tipo, m.baixa_producao.etapa).nome %></span><% end %>
              <% if (motivo = m.motivo_de_nao_contar) %><small class="movimento-nao-conta"><%= motivo %>: não conta</small><% end %>
            <% end %>
            <% if (lancada = m.lancada_na_baixa&.pedido || m.lancada_na_entrega) %>
              <span class="movimento-lancada" data-lancada>lançada na <%= m.lancada_na_baixa ? "baixa" : "entrega" %> de <%= link_to "##{lancada.uuid.first(8)}", resumo_pedido_path(lancada) %><%= " · #{EtapasProducao.etapa(lancada.tipo, m.lancada_na_baixa.etapa).nome}" if m.lancada_na_baixa %><% unless cliente_final? %><%= ", por #{m.lancado_por.nome}" if m.lancado_por %><%= ", autorizada por #{m.autorizado_por.nome}" if m.autorizado_por %><% end %></span>
            <% end %>
            <% if m.ordem_dublagem %>
              <span class="movimento-dublagem" data-ordem-dublagem="<%= m.ordem_dublagem.uuid %>"><%= cliente_final? ? "Dublagem ##{m.ordem_dublagem.uuid.first(8)}" : link_to("Dublagem ##{m.ordem_dublagem.uuid.first(8)}", dublagens_path) %></span>
            <% end %>
          </td>
          <td><%= preco_da_unidade(m.valor, m.materia_prima) if m.valor %></td>
          <td><%= number_to_currency(m.valor_total) if m.valor %></td>
        </tr>
      <% end %>
      <% if movimentos.empty? %>
        <tr><td colspan="8" class="gallery-empty">No movements recorded yet.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
