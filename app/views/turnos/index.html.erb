<% content_for :title, "Turnos e calendário" %>
<%# Painel 2/4a (decided 05/11/2026): the turnos, the year's exceptions and
    the national holidays suggested; the queue and the previsão run on them. %>
<p class="parametros-voltar"><%= link_to "← Production parameters", edit_parametros_path %> · <%= link_to "Production rhythm", edit_parametros_ritmos_path %></p>
<h2>Turnos e calendário</h2>
<p class="funcoes-intro">The factory's working hours. A turno that ends before it starts crosses midnight and belongs to
  the day it starts (a Friday "Noite 22:00–06:00" ends on Saturday). Turnos may not overlap.</p>

<section class="turnos" id="turnos">
  <h3>Turnos</h3>
  <div class="turnos-lista">
    <div class="turno-linha turno-cab" aria-hidden="true"><span>Name</span><span>Start</span><span>End</span><span>Days</span><span></span></div>
    <% @turnos.each do |turno| %>
      <%= render "turnos/linha", turno: turno, url: parametros_turno_path(turno), method: :patch, botao: "Save" %>
    <% end %>
    <%= render "turnos/linha", turno: Turno.new(dias: (1..5).to_a), url: parametros_turnos_path, method: :post, botao: "Add turno" %>
  </div>
  <% if @turnos.empty? %>
    <p class="turnos-vazio">No turno yet: the Painel can't tell the turno on now, and the previsão has nothing to fill.</p>
  <% end %>
</section>

<section class="calendario" id="calendario" data-controller="dialog">
  <div class="calendario-topo">
    <h3>Calendar <%= @ano %></h3>
    <nav class="calendario-anos" aria-label="Year">
      <%= link_to "‹ #{@ano - 1}", parametros_turnos_path(ano: @ano - 1, anchor: "calendario") %>
      <%= link_to "#{@ano + 1} ›", parametros_turnos_path(ano: @ano + 1, anchor: "calendario") %>
    </nav>
    <button type="button" class="btn btn-secondary" data-action="dialog#open">New exception</button>
  </div>
  <p class="funcoes-intro">Days, or turnos, the whole factory or one stage doesn't work. The previsão skips them.</p>

  <table class="clients-table calendario-excecoes">
    <thead><tr><th>Date</th><th>Name</th><th>Applies to</th><th></th></tr></thead>
    <tbody>
      <% manuais = @excecoes.reject { |excecao| excecao.origem == "feriado" } %>
      <% manuais.each do |excecao| %>
        <tr class="calendario-excecao" data-excecao="<%= excecao.nome %>">
          <td><%= dia_com_semana(excecao.data) %></td>
          <td><%= excecao.nome %></td>
          <td><%= excecao.abrangencia %></td>
          <td><%= button_to "Remove", parametros_excecao_path(excecao), method: :delete, class: "btn btn-secondary btn-sm", form: { style: "display: inline-block;" } %></td>
        </tr>
      <% end %>
      <% if manuais.empty? %>
        <tr><td colspan="4" class="calendario-vazio">No exception in <%= @ano %>.</td></tr>
      <% end %>
    </tbody>
  </table>

  <h4>National holidays (suggested)</h4>
  <p class="funcoes-intro">Check the ones the factory stops on. State and city holidays: add them as an exception.</p>
  <ul class="feriados">
    <% FeriadosNacionais.do_ano(@ano).each do |feriado| %>
      <% confirmado = @feriados_confirmados.key?(feriado.data) %>
      <li class="feriado<%= " feriado--confirmado" if confirmado %>" data-feriado="<%= feriado.data.iso8601 %>">
        <%= form_with url: feriado_parametros_excecoes_path, method: :post, class: "feriado-form" do %>
          <%= hidden_field_tag :data, feriado.data.iso8601, id: nil %>
          <%= hidden_field_tag :confirmado, confirmado ? "0" : "1", id: nil %>
          <button type="submit" class="feriado-botao" aria-pressed="<%= confirmado %>">
            <span class="feriado-check" aria-hidden="true"><%= confirmado ? "✓" : "" %></span>
            <span class="feriado-data"><%= dia_com_semana(feriado.data) %></span>
            <span class="feriado-nome"><%= feriado.nome %><%= " · ponto facultativo" if feriado.facultativo %></span>
            <span class="feriado-estado"><%= confirmado ? "factory stops" : "factory works" %></span>
          </button>
        <% end %>
      </li>
    <% end %>
  </ul>

  <dialog class="client-dialog calendario-dialog" data-dialog-target="dialog" aria-labelledby="calendario-dialog-titulo">
    <%= form_with url: parametros_excecoes_path, method: :post, scope: :excecao, class: "client-form" do |form| %>
      <h4 id="calendario-dialog-titulo">New exception</h4>
      <div class="client-field">
        <%= form.label :nome, "Name" %>
        <%= form.text_field :nome, required: true, placeholder: "e.g. Calandra maintenance, recess" %>
      </div>
      <div class="client-field">
        <%= form.label :data, "Date" %>
        <%= form.date_field :data, required: true %>
      </div>
      <div class="client-field">
        <%= form.label :turno_uuid, "Turno" %>
        <%= form.select :turno_uuid, [ [ "The whole day", "" ] ] + @turnos.map { |turno| [ "#{turno.nome} (#{turno.horario})", turno.uuid ] } %>
      </div>
      <div class="client-field">
        <%= form.label :etapa, "Applies to" %>
        <%= form.select :etapa, [ [ "The whole factory", "" ] ] + ExcecaoCalendario.etapas.map { |chave, nome| [ nome, chave ] } %>
      </div>
      <div class="client-dialog-actions">
        <button type="button" class="btn btn-secondary" data-action="dialog#close">Cancel</button>
        <%= form.submit "Save exception", class: "btn btn-primary" %>
      </div>
    <% end %>
  </dialog>
</section>
