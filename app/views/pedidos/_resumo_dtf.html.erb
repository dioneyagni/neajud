<%# A DTF pedido's totals and settings (Etapa 2.6b1): units ordered and
    printed (the last row completed and the extra rows — the excess goes to
    the client), the film's meters, the delivery and the pedido's default
    extra rows, which a line may override. Both settings are the cliente
    final's too on his draft (D5). %>
<% linhas = EncaixeDoPedidoDtf.call(pedido).reject(&:pendencia) %>
<dl class="pedido-resumo-lista">
  <dt>Etiquetas</dt><dd data-resumo="itens"><%= pedido.itens_pedido.size %></dd>
  <dt>Pedidas</dt><dd data-resumo="pedidas"><%= pedido.total_itens %></dd>
  <dt>Impressas</dt><dd data-resumo="impressas"><%= linhas.sum(&:impressas) %></dd>
  <dt>Filme</dt><dd data-resumo="metros"><%= metros_de_filme(linhas.sum(&:metros)) %></dd>
  <dt>Entrega</dt><dd data-resumo="entrega"><%= pedido.entrega == "cortada" ? "Cortada" : "Em rolo" %></dd>
</dl>
<% if pedido_editavel?(pedido) %>
  <%= form_with url: dtf_pedido_path(pedido), method: :patch, class: "pedido-dtf-ajustes", data: { controller: "auto-submit" } do %>
    <label>Entrega
      <select name="entrega" id="pedido-dtf-entrega" data-action="change->auto-submit#submit">
        <option value="rolo" <%= "selected" if pedido.entrega == "rolo" %>>Em rolo</option>
        <option value="cortada" <%= "selected" if pedido.entrega == "cortada" %>>Cortada</option>
      </select>
    </label>
    <label>Fileiras extras
      <input type="number" name="fileiras_extras" id="pedido-dtf-fileiras-extras" min="0" max="100" step="1" value="<%= pedido.fileiras_extras %>"
             data-action="change->auto-submit#submit">
    </label>
    <small>Por tamanho de cada etiqueta, além das fileiras do pedido; cada linha pode ter as suas.</small>
  <% end %>
<% end %>
