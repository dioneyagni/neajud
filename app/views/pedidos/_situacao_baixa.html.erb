<%# One production line's state in a stage (Etapa 2.2, 2/3): done (the
    measure, who and when), waiting for a locked stage, or the baixa button.
    locals: pedido, etapa, situacao (RegistrarBaixaService::Situacao or nil) %>
<% if situacao.nil? %>
  —
<% elsif situacao.estado == :feita %>
  <% baixa = situacao.baixa %>
  <span class="baixa-feita" title="<%= baixa.nivel == "linha" ? "Baixa desta linha" : "Baixa #{baixa.nivel == "pedido" ? "do pedido" : "da referência"} (#{baixa.linhas.size} linhas)" %>">
    ✓ <%= number_with_precision(baixa.medida, precision: etapa.metragem? ? 2 : 0, separator: ",", strip_insignificant_zeros: !etapa.metragem?) %> <%= etapa.metragem? ? "m" : "peças" %>
    · <%= baixa.user&.nome || baixa.changed_by %> · <%= l baixa.created_at, format: "%d/%m %H:%M" %>
  </span>
  <% if baixa.fora_da_faixa %><span class="baixa-fora" title="Confirmada fora da faixa (esperado <%= number_with_precision(baixa.esperado, precision: 2, separator: ",") %>)">fora da faixa</span><% end %>
<% elsif situacao.estado == :aguardando %>
  <span class="baixa-aguardando">aguardando <%= situacao.aguardando %></span>
<% elsif pode_dar_baixa?(pedido) %>
  <%= render "pedidos/baixa", pedido: pedido, etapa: etapa, nivel: "linha", alvo: situacao.linha.chave, rotulo: "Baixa", esperado: situacao.linha.esperado %>
<% else %>
  <span class="baixa-aberta">aberta</span>
<% end %>
