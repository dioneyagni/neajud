<h2>Pedidos</h2>

<div class="clients-toolbar">
  <span class="field-display" style="font-size:0.9rem; color:var(--text-muted);">
    <%= @pedidos.size %> pedidos
  </span>
  <%# 20/10/2026: the tecido pedidos have their own list. %>
  <%= link_to "Pedidos de tecido", pedidos_tecido_path, class: "btn btn-secondary pedidos-tecido-link" %>
  <% if pode?(:pedidos, :editar) %>
    <%= button_to "+ Novo Pedido", pedidos_path, method: :post, class: "btn btn-primary", style: "margin-left:auto;" %>
  <% end %>
</div>

<%# Etapa 2.2 (3/3): by status. %>
<nav class="pedidos-filtro" aria-label="Filtrar por status">
  <%= link_to "Todos", pedidos_path, "aria-current": (@status.nil? && !@aguardando ? "page" : nil) %>
  <% %w[rascunho enviado confirmado em_producao entregue].each do |status| %>
    <%= link_to rotulo_do_status(status).capitalize, pedidos_path(status: status), "aria-current": (@status == status ? "page" : nil), data: { status: status } %>
  <% end %>
  <%# Etapa 2.3d2: the pedidos whose out passed what came in. %>
  <%= link_to "Aguardando material", pedidos_path(aguardando: 1), "aria-current": (@aguardando ? "page" : nil), data: { status: "aguardando" } %>
</nav>

<%# Etapa 2.8 (5/5): the drafts the factory returned, on top with its note. %>
<% if @devolvidos.any? %>
  <section class="pedidos-devolvidos" role="alert">
    <h3>Devolvidos pela fábrica (<%= @devolvidos.size %>)</h3>
    <ul>
      <% @devolvidos.each do |devolucao| %>
        <li data-pedido="<%= devolucao.pedido.uuid %>">
          <%= link_to "Pedido ##{devolucao.pedido.uuid.first(8)}", resumo_pedido_path(devolucao.pedido) %>:
          <blockquote><%= devolucao.recado %></blockquote>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<div style="margin: 1rem 0;">
  <table class="clients-table">
    <thead>
      <tr>
        <th>Pedido</th>
        <th>Cliente</th>
        <th>Tipo</th>
        <th>Itens</th>
        <th>Status</th>
        <th>Data</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @pedidos.each do |p| %>
        <tr>
          <td>
            <%= link_to p.uuid.first(8), p %>
            <% if p.reposicao? %><div class="pedido-reposicao-de">reposição de #<%= p.reposicao_de.uuid.first(8) %></div><% end %>
          </td>
          <td><%= p.client&.name || "—" %></td>
          <%# Etapa 2.6b1: one type per pedido, from its items. %>
          <td class="pedido-tipo" data-tipo="<%= p.tipo %>"><%= Pedido::ROTULOS_DOS_TIPOS.fetch(p.tipo) %></td>
          <td><%= p.itens_count %></td>
          <td>
            <span class="badge badge-<%= p.status %>"><%= rotulo_do_status(p.status, reposicao: p.reposicao?) %></span>
            <% if aguardando_material.pedido_ids.include?(p.id) %><span class="badge badge-aguardando" data-aguardando>aguardando material</span><% end %>
            <% if p.saiu_do_rascunho? && p.status != "entregue" %>
              <div class="pedido-andamento-compacto"><%= AndamentoDoPedido.call(p).map { |a| "#{a.etapa.nome} #{a.feitas}/#{a.total}" }.join(" · ") %></div>
            <% end %>
          </td>
          <td><%= l p.created_at, format: :short %></td>
          <td>
            <% if p.confirmavel? %>
              <% pendentes = @bloqueios_por_pedido[p.id].to_i %>
              <div class="pedido-actions">
                <%= link_to "Resumo", resumo_pedido_path(p), class: "btn btn-sm btn-outline" %>
                <% if pendentes.positive? %>
                  <%= link_to "#{pendentes} pendente(s)", resumo_pedido_path(p),
                        class: "btn btn-sm pedido-pendentes-badge",
                        title: "Pendências (quantidade 0, número sem corte ou sem arquivo de produção) — resolva antes de confirmar" %>
                <% elsif pode?(:pedidos, :editar) && !cliente_final? %>
                  <%= link_to "Confirmar", confirmar_pedido_path(p),
                        data: { turbo_method: :post, turbo_confirm: "Confirm this pedido?" },
                        class: "btn btn-sm btn-primary" %>
                <% end %>
                <% if pode?(:pedidos, :excluir) %>
                  <%= link_to "Excluir", p,
                        data: { turbo_method: :delete, turbo_confirm: "Move this pedido to the trash?" },
                        class: "btn btn-sm btn-danger" %>
                <% end %>
              </div>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if @pedidos.empty? %>
        <tr><td colspan="7" class="gallery-empty">No pedidos yet.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="back-link-wrapper">
  <%= link_to "Back to Gallery", root_path, class: "back-link" %>
</div>
