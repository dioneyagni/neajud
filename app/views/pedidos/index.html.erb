<h2>Pedidos</h2>

<div class="clients-toolbar">
  <span class="field-display" style="font-size:0.9rem; color:var(--text-muted);">
    <%= @pedidos.size %> pedidos
  </span>
  <% if pode?(:pedidos, :editar) %>
    <%= button_to "+ Novo Pedido", pedidos_path, method: :post, class: "btn btn-primary", style: "margin-left:auto;" %>
  <% end %>
</div>

<%# Etapa 2.2 (3/3): by status. %>
<nav class="pedidos-filtro" aria-label="Filtrar por status">
  <%= link_to "Todos", pedidos_path, "aria-current": (@status.nil? ? "page" : nil) %>
  <% %w[rascunho confirmado em_producao entregue].each do |status| %>
    <%= link_to rotulo_do_status(status).capitalize, pedidos_path(status: status), "aria-current": (@status == status ? "page" : nil), data: { status: status } %>
  <% end %>
</nav>

<div style="margin: 1rem 0;">
  <table class="clients-table">
    <thead>
      <tr>
        <th>Pedido</th>
        <th>Cliente</th>
        <th>Itens</th>
        <th>Status</th>
        <th>Data</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @pedidos.each do |p| %>
        <tr>
          <td><%= link_to p.uuid.first(8), p %></td>
          <td><%= p.client&.name || "—" %></td>
          <td><%= p.itens_count %></td>
          <td>
            <span class="badge badge-<%= p.status %>"><%= rotulo_do_status(p.status) %></span>
            <% if p.saiu_do_rascunho? && p.status != "entregue" %>
              <div class="pedido-andamento-compacto"><%= AndamentoDoPedido.call(p).map { |a| "#{a.etapa.nome} #{a.feitas}/#{a.total}" }.join(" · ") %></div>
            <% end %>
          </td>
          <td><%= l p.created_at, format: :short %></td>
          <td>
            <% if p.status == "rascunho" %>
              <% pendentes = @bloqueios_por_pedido[p.id].to_i %>
              <div class="pedido-actions">
                <%= link_to "Resumo", resumo_pedido_path(p), class: "btn btn-sm btn-outline" %>
                <% if pendentes.positive? %>
                  <%= link_to "#{pendentes} pendente(s)", resumo_pedido_path(p),
                        class: "btn btn-sm pedido-pendentes-badge",
                        title: "Pendências (quantidade 0, número sem corte ou sem arquivo de produção) — resolva antes de confirmar" %>
                <% elsif pode?(:pedidos, :editar) %>
                  <%= link_to "Confirmar", confirmar_pedido_path(p),
                        data: { turbo_method: :post, turbo_confirm: "Confirm this pedido?" },
                        class: "btn btn-sm btn-primary" %>
                <% end %>
                <% if pode?(:pedidos, :excluir) %>
                  <%= link_to "Excluir", p,
                        data: { turbo_method: :delete, turbo_confirm: "Move this pedido to the trash?" },
                        class: "btn btn-sm btn-danger" %>
                <% end %>
              </div>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if @pedidos.empty? %>
        <tr><td colspan="6" class="gallery-empty">No pedidos yet.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="back-link-wrapper">
  <%= link_to "Back to Gallery", root_path, class: "back-link" %>
</div>
