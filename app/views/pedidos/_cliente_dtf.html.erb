<%# A DTF pedido's client is the pedido's, not its etiquetas' (Etapa 2.6b1,
    D4): the team picks it while the draft is editable; a cliente final's
    pedido is always his own. %>
<% if pedido_editavel?(pedido) && !cliente_final? %>
  <%= form_with url: dtf_pedido_path(pedido), method: :patch, class: "pedido-cliente-dtf", data: { controller: "auto-submit" } do %>
    <label for="pedido-cliente-dtf"><strong>Cliente:</strong></label>
    <select name="client_uuid" id="pedido-cliente-dtf" data-action="change->auto-submit#submit">
      <option value="">Escolha o cliente…</option>
      <% visiveis(Client).ativos.order(:name).each do |client| %>
        <option value="<%= client.uuid %>" <%= "selected" if pedido.client_id == client.id %>><%= client.name %></option>
      <% end %>
    </select>
  <% end %>
<% else %>
  <p><strong>Cliente:</strong> <%= pedido.client&.name || "sem cliente" %> <%= selo_excluido(pedido.client) if pedido.client %></p>
<% end %>
