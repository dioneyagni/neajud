<%# One etiqueta of a DTF pedido (Etapa 2.6b1, decided 13/10/2026): no parts
    matrix — a row per size, by measure, with its fit on the film
    (EncaixeDoPedidoDtf): copies per row, rows (+ extra, editable while the
    draft is: blank = the pedido's), printed, the excess that goes to the
    client and the meters. Turned 90° is the team's (the cliente final
    neither sees nor sets the fit, only the extra rows — D5).
    Its prices sit in the same table (decided 14/10/2026, Etapa 2.6c): the
    starting one (the team's with "ver valores"), the unit price — edited
    there on the team's draft — and the subtotal, "—" when the pedido is
    charged by meter; the footer sums the etiqueta. valores is nil for who
    doesn't see prices. Under 600px each row becomes a block, its cells
    labelled by data-rotulo (CSS). %>
<% arquivo = item.arquivo %>
<% editavel = pedido_editavel?(pedido) %>
<% por_tamanho = linhas.index_by { |linha| linha.grade.tamanho_nome } %>
<% tamanhos = item.arte.tamanhos_do_pedido.presence || [ ProducaoPedidoService::TOTAL_KEY ] %>
<% quantidades = item.grades.to_h { |g| [ g.tamanho_nome, g.quantidade ] } %>
<% total = quantidades.values.sum %>
<% equipe = valores && !cliente_final? && pode_acao?(:ver_valores) %>
<% edita_preco = equipe && pedido.editavel? %>
<% colunas_de_preco = valores ? (equipe ? 3 : 2) : 0 %>
<% por_metro = valores&.cobranca == "metro" %>
<% medidas = linhas.reject(&:pendencia) %>
<article class="pedido-item pedido-item-dtf" data-item-uuid="<%= item.uuid %>"
         data-controller="grade-editor"
         data-grade-editor-save-url-value="<%= atualizar_item_pedido_path(pedido, id: item.uuid) %>">
  <div class="pedido-item-header">
    <% if arquivo.preview_file.present? && !(arquivo.pending? || arquivo.processing?) %>
      <img class="pedido-item-thumb" src="<%= preview_arquivo_path(arquivo) %>" alt="">
    <% else %>
      <span class="pedido-item-thumb pedido-item-thumb--vazio" aria-hidden="true"></span>
    <% end %>
    <div class="pedido-item-titulo">
      <strong><%= link_to item.arte.titulo.presence || arquivo.filename, arquivo %></strong> <%= selo_excluido(arquivo) %>
      <div class="pedido-item-sub">
        <% if item.arte.no_catalogo %><span class="pedido-item-catalogo">catálogo</span><% end %>
        <% if arquivo.client && do_proprio_cliente?(arquivo) %><span class="pedido-item-client"><%= arquivo.client.name %></span><% end %>
      </div>
    </div>
    <strong class="pedido-item-total"><%= total %> <%= total == 1 ? "unidade" : "unidades" %></strong>
  </div>

  <div class="pedido-dtf-tabela-wrap">
    <table class="pedido-dtf-tabela pedido-dtf-blocos">
      <thead>
        <% if valores %>
          <tr class="pedido-dtf-grupos">
            <th colspan="2"></th><th colspan="5" class="pedido-dtf-grupo">Encaixe no filme</th><th colspan="<%= colunas_de_preco %>" class="pedido-dtf-grupo">Valores</th>
          </tr>
        <% end %>
        <tr>
          <th>Tamanho</th><th>Pedidas</th><th>Por fileira</th><th>Fileiras</th><th>Extras</th>
          <th>Impressas</th><th>Filme</th>
          <% if equipe %><th>Partida</th><% end %>
          <% if valores %><th>Preço un.</th><th>Subtotal</th><% end %>
        </tr>
      </thead>
      <tbody>
        <% tamanhos.each do |tamanho| %>
          <% linha = por_tamanho[tamanho] %>
          <% grade = item.grades.find { |g| g.tamanho_nome == tamanho } %>
          <tr class="pedido-dtf-linha<%= " pedido-dtf-linha--pendente" if linha&.pendencia %>" data-tamanho="<%= tamanho %>">
            <th scope="row">
              <%= tamanho == ProducaoPedidoService::TOTAL_KEY ? "Qtd" : tamanho %>
              <% if linha&.arquivo %><small class="pedido-dtf-medida"><%= medida_do_arquivo(linha.arquivo) %></small><% end %>
            </th>
            <td class="pedido-dtf-pedidas" data-rotulo="Pedidas">
              <% if editavel %>
                <input type="number" class="grade-qtd-input pedido-dtf-qtd" data-tamanho-nome="<%= tamanho %>" value="<%= quantidades[tamanho] || 0 %>" min="0" step="1" aria-label="Quantidade <%= tamanho %>">
              <% else %>
                <%= quantidades[tamanho] || 0 %>
              <% end %>
            </td>
            <% if linha && !linha.pendencia %>
              <td class="pedido-dtf-por-fileira pedido-dtf-encaixe" data-rotulo="Por fileira"><%= linha.por_fileira %><% if linha.girada && !cliente_final? %> <span class="pedido-dtf-girada" title="Girada 90°: menos metros para esta quantidade" aria-label="girada">↻</span><% end %></td>
              <td class="pedido-dtf-fileiras pedido-dtf-encaixe" data-rotulo="Fileiras"><%= linha.fileiras %></td>
              <td class="pedido-dtf-extras" data-rotulo="Extras">
                <% if editavel %>
                  <%= form_with url: dtf_fileiras_pedido_path(pedido), method: :patch, class: "pedido-dtf-extras-form", data: { controller: "auto-submit" } do %>
                    <input type="hidden" name="item_uuid" value="<%= item.uuid %>">
                    <input type="hidden" name="tamanho_nome" value="<%= tamanho %>">
                    <input type="number" name="fileiras_extras" min="0" max="100" step="1" value="<%= grade.fileiras_extras %>" placeholder="<%= pedido.fileiras_extras %>"
                           aria-label="Fileiras extras <%= tamanho %>" data-action="change->auto-submit#submit">
                  <% end %>
                <% else %>
                  <%= linha.extras %>
                <% end %>
              </td>
              <td class="pedido-dtf-impressas-celula" data-rotulo="Impressas"><span class="pedido-dtf-impressas"><%= linha.impressas %></span> <span class="pedido-dtf-excedente"><%= "+#{linha.excedente}" %></span></td>
              <td class="pedido-dtf-metros pedido-dtf-encaixe" data-rotulo="Filme"><%= metros_de_filme(linha.metros) %></td>
              <%= render "pedidos/precos_da_linha_dtf", pedido: pedido, parte: valores.da_linha(linha), equipe: equipe, edita_preco: edita_preco, por_metro: por_metro if valores %>
            <% elsif linha %>
              <td colspan="<%= 5 + colunas_de_preco %>" class="pedido-dtf-pendencia"><%= PedidoBloqueiosDtf::DESCRICOES_DO_ENCAIXE.fetch(linha.pendencia).last %></td>
            <% else %>
              <td colspan="<%= 5 + colunas_de_preco %>" class="pedido-dtf-vazio">—</td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
      <% if medidas.any? %>
        <% soma = valores&.do_item(item) %>
        <tfoot>
          <tr class="pedido-dtf-soma">
            <th scope="row">Etiqueta</th>
            <td class="pedido-dtf-encaixe" data-rotulo="Pedidas"><%= total %></td><td></td><td></td><td></td>
            <td class="pedido-dtf-encaixe" data-rotulo="Impressas"><span><%= medidas.sum(&:impressas) %></span> <span class="pedido-dtf-excedente"><%= "+#{medidas.sum(&:excedente)}" %></span></td>
            <td class="pedido-dtf-encaixe" data-rotulo="Filme"><%= metros_de_filme(medidas.sum(&:metros)) %></td>
            <% if equipe %><td></td><% end %>
            <% if valores %><td></td><td class="pedido-valores-subtotal pedido-dtf-subtotal" data-rotulo="Subtotal"><%= por_metro ? "—" : reais(soma.subtotal) %></td><% end %>
          </tr>
        </tfoot>
      <% end %>
    </table>
  </div>

  <% if editavel %>
    <div class="pedido-item-actions">
      <%= button_to "Remover item", remover_item_pedido_path(pedido, id: item.uuid),
            method: :delete, class: "btn btn-secondary btn-sm",
            data: { turbo_confirm: "Remove this item?" } %>
      <button type="button" class="btn btn-sm btn-primary grade-save-btn"
              data-action="click->grade-editor#save">Salvar quantidades</button>
    </div>
  <% end %>
</article>
