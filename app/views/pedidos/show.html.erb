<%# An arte of this pedido finishing its queued processing (e.g. after
    "Enviar arquivo") morph-refreshes the page (Arquivo#broadcast_status_change). %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= canal_do_registro(@pedido) %>

<h2>
  <%= @pedido.reposicao? ? "Reposição" : "Pedido" %>
  <span style="font-size:0.8rem; color:var(--text-muted);">#<%= @pedido.uuid.first(8) %></span>
  <span class="badge badge-<%= @pedido.status %>"><%= rotulo_do_status(@pedido.status, reposicao: @pedido.reposicao?) %></span>
  <%= selo_excluido(@pedido) %>
</h2>

<%# A DTF pedido's fit and charges, computed once for its tables, its
    "Valores do pedido" and the panel (decided 14/10/2026: the prices sit in
    each etiqueta's table). Nil prices: the person doesn't see them. %>
<% if @pedido.dtf? %>
  <% linhas_dtf = EncaixeDoPedidoDtf.call(@pedido) %>
  <% valores_dtf = ValoresDoPedidoDtf.call(@pedido, linhas: linhas_dtf) if pode_ver_precos? && @pedido.itens_pedido.any? %>
<% end %>

<% if @pedido.dtf? %>
  <%= render "cliente_dtf", pedido: @pedido %>
<% elsif @pedido.client %>
  <p><strong>Cliente:</strong> <%= @pedido.client.name %> <%= selo_excluido(@pedido.client) %></p>
<% elsif @pedido.confirmavel? %>
  <%# A draft without client takes its artes' client — or is split by them
      when confirmed (01/10/2026: the page said nothing about it). %>
  <% clientes = @pedido.clientes_das_artes.to_a %>
  <p class="pedido-cliente-previsto"><strong>Cliente:</strong>
    <% if clientes.size > 1 %>
      será dividido por cliente ao confirmar: <%= clientes.map(&:name).join(", ") %>
    <% elsif clientes.one? %>
      <%= clientes.first.name %> (das artes)
    <% else %>
      ainda sem cliente — vem das artes
    <% end %>
  </p>
<% end %>
<p><strong>Criado em:</strong> <%= l @pedido.created_at, format: :long %></p>
<%# Etapa 2.2 (4/4): a reposição and the pedido it repairs point at each other. %>
<% if @pedido.reposicao? %>
  <p class="pedido-reposicao-de">Reposição de <%= link_to "##{@pedido.reposicao_de.uuid.first(8)}", resumo_pedido_path(@pedido.reposicao_de) %>: as peças que faltaram na conferência.</p>
<% end %>
<% if @pedido.reposicoes.any? %>
  <p class="pedido-reposicoes">Reposições:
    <% @pedido.reposicoes.order(:created_at).each do |reposicao| %>
      <%= link_to "##{reposicao.uuid.first(8)}", resumo_pedido_path(reposicao) %> (<%= rotulo_do_status(reposicao.status, reposicao: true) %>)
    <% end %>
  </p>
<% end %>

<% if @pedido.grade_antiga? %>
  <%# Etapa 1.2 (3/3): grades by the corte's size name can't be split by number. %>
  <p class="pedido-grade-antiga" role="note">Pedido no formato antigo (grade pelo tamanho do corte, ex: "29-30"): só leitura. Os pedidos agora são por arte e por número.</p>
<% end %>

<%# Etapa 1.2 (3/3, parte 3a, decided 06/10/2026): the items in the main
    column, each a matrix of its grade × parts; totals, confirming and the
    pendências in a side panel (below the items on narrow screens). %>
<div class="pedido-layout">
  <div class="pedido-principal">
    <% if @pedido.reposicao? %>
      <%= render "itens_reposicao", pedido: @pedido %>
    <% else %>
      <h3>Itens (<%= @pedido.itens_pedido.count %>)</h3>
      <% if @pedido.dtf? %>
        <%# Etapa 2.6b1: an etiqueta per item, its sizes on the film. %>
        <% linhas_por_item = linhas_dtf.group_by(&:item) %>
        <% @pedido.itens_pedido.includes(:grades, :arte, arquivo: :client).order(:id).each do |item| %>
          <%= render "item_dtf", item: item, pedido: @pedido, linhas: linhas_por_item.fetch(item, []), valores: valores_dtf %>
        <% end %>
      <% else %>
        <% @pedido.itens_pedido.includes(:grades, :arte, :materia_prima, arquivo: :client).order(:id).each do |item| %>
          <%= render "item", item: item, pedido: @pedido %>
        <% end %>
      <% end %>
    <% end %>

    <% if @pedido.itens_pedido.empty? && !@pedido.reposicao? %>
      <p class="gallery-empty">No items yet. Add an arte below, or from the gallery.</p>
    <% end %>

    <%# Etapa 2.4: a reposição is internal, never charged. A cliente final
        sees the price only, by his grid's "valores" (2.8, 3a). %>
    <%# A DTF has no price per pair: it is charged by quantity or meter (Etapa 2.6c). %>
    <% if pode_ver_precos? && !@pedido.reposicao? && @pedido.itens_pedido.any? %>
      <% if @pedido.dtf? %>
        <%= render "pedidos/valores_dtf", pedido: @pedido, valores: valores_dtf %>
      <% else %>
        <%= render "pedidos/valores", pedido: @pedido %>
      <% end %>
    <% end %>

    <% if pedido_editavel?(@pedido) %>
      <%# Etapa 1.2 (3/3, decided 05/10/2026): an item enters by molde → referência
          → arte here too, not only from the gallery's card. Etapa 2.6b1: a DTF
          pedido searches its etiquetas by number or name instead; an empty
          draft offers both (its type comes from the first item), one modal. %>
      <% vazio = @pedido.itens_pedido.empty? %>
      <div class="pedido-adicionar" data-controller="add-to-order pedido-adicionar"
           data-add-to-order-pedido-uuid-value="<%= @pedido.uuid %>"
           data-pedido-adicionar-url-value="<%= artes_para_adicionar_pedidos_path(format: :json) %>">
        <h3><%= @pedido.dtf? ? "Adicionar etiqueta DTF" : "Adicionar arte" %></h3>
        <div class="pedido-adicionar-filtros">
          <% unless @pedido.dtf? %>
            <% moldes = (@pedido.client ? visiveis(Molde).ativos.where(client: @pedido.client) : visiveis(Molde).ativos).includes(:client).order(:nome) %>
            <select data-pedido-adicionar-target="molde" data-action="change->pedido-adicionar#escolherMolde">
              <option value="">Molde…</option>
              <% moldes.each do |molde| %>
                <option value="<%= molde.uuid %>"><%= molde.nome %><%= " (#{molde.client.name})" unless @pedido.client %></option>
              <% end %>
            </select>
            <select data-pedido-adicionar-target="referencia" data-action="change->pedido-adicionar#escolherReferencia" hidden></select>
          <% end %>
          <% if @pedido.dtf? || vazio %>
            <input type="search" class="pedido-adicionar-busca" placeholder="Etiqueta DTF: número ou nome (863, Arcoverde…)" aria-label="Buscar etiqueta DTF"
                   data-pedido-adicionar-target="busca" data-action="input->pedido-adicionar#buscar">
          <% end %>
        </div>
        <div class="pedido-adicionar-artes" data-pedido-adicionar-target="artes"></div>
        <%= render "pedidos/add_to_order_modal" %>
      </div>
    <% end %>
  </div>

  <%= render "painel", pedido: @pedido, linhas_dtf: linhas_dtf, valores_dtf: valores_dtf %>
</div>

<div class="back-link-wrapper" style="margin-top:1rem;">
  <%= link_to "Back to Pedidos", pedidos_path, class: "back-link" %>
</div>
