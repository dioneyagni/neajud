<%# The side panel (Etapa 1.2, 3/3 parte 3a): totals, confirming and what
    still blocks it, each pendência with what settles it — "Enviar arquivo"
    uploads into the arte with the part and size filled and comes back here;
    "Trazer de outra arte" opens the arte page to bring files in. %>
<% itens = pedido.itens_pedido.includes(:grades).to_a %>
<aside class="pedido-painel">
  <section class="pedido-painel-card pedido-resumo">
    <h3>Resumo</h3>
    <dl class="pedido-resumo-lista">
      <dt>Itens</dt><dd data-resumo="itens"><%= itens.size %></dd>
      <% if pedido.reposicao? %>
        <dt>Peças a repor</dt><dd data-resumo="pecas"><%= pedido.itens_reposicao.sum(:pecas) %></dd>
      <% else %>
        <dt>Pares</dt><dd data-resumo="pares"><%= itens.sum { |i| i.grades.sum(&:quantidade) } %></dd>
      <% end %>
    </dl>
    <%# Etapa 2.2 (3/3): the stages' progress, and delivering. %>
    <% if pedido.saiu_do_rascunho? %>
      <ul class="pedido-andamento">
        <% AndamentoDoPedido.call(pedido).each do |andamento| %>
          <li data-etapa="<%= andamento.etapa.chave %>" class="<%= "pedido-andamento--completa" if andamento.abertas.zero? %>">
            <span><%= andamento.etapa.nome %></span> <strong><%= andamento.feitas %>/<%= andamento.total %></strong>
          </li>
        <% end %>
      </ul>
      <%= render "pedidos/reposicao_em_aberto", pedido: pedido %>
      <% if pedido.status == "entregue" %>
        <p class="pedido-entregue">Entregue em <%= l pedido.entregue_em, format: "%d/%m/%Y %H:%M" %><%= " por #{pedido.entregue_por.nome}" if pedido.entregue_por %>.</p>
      <% elsif pode_dar_baixa?(pedido) %>
        <div class="entrega" data-controller="entrega" data-entrega-url-value="<%= entregar_pedido_path(pedido) %>">
          <button type="button" class="btn btn-primary entrega-botao" data-action="entrega#entregar">Marcar como entregue</button>
          <p class="baixa-mensagem" data-entrega-target="mensagem" hidden></p>
          <button type="button" class="btn btn-sm btn-outline entrega-confirmar" data-entrega-target="confirmar" data-action="entrega#confirmar" hidden>Entregar assim mesmo</button>
        </div>
      <% end %>
    <% end %>
    <%# Etapa 1.2 (3/3, partes 3b e 3c): production has its own pages, for the
        cutting table and for the printer. %>
    <% if itens.any? || pedido.reposicao? %>
      <%# Etapa 2.2 (2/3): every production stage of the pedido's type. %>
      <div class="pedido-ir-producao">
        <% EtapasProducao.do_tipo(pedido.tipo).each do |etapa| %>
          <%= link_to "#{etapa.nome} →", caminho_da_etapa(pedido, etapa), class: "btn btn-secondary pedido-ir-#{etapa.chave}" %>
        <% end %>
      </div>
    <% end %>
    <%# Etapa 2.8 (5/5): the client sends his draft; the team returns it. %>
    <%= render "pedidos/envio", pedido: pedido %>
    <% bloqueios = pedido.confirmavel? ? pedido.bloqueios_confirmacao : [] %>
    <% if pedido_editavel?(pedido) %>
      <%# Confirming is the factory's (Etapa 2.8, 5/5). %>
      <% unless cliente_final? %>
        <%= button_to "Confirmar pedido", confirmar_pedido_path(pedido), method: :post,
              class: "btn btn-primary pedido-confirmar", disabled: bloqueios.any?,
              data: { turbo_confirm: "Confirm this pedido? It will be split by client." } %>
        <% if bloqueios.any? %>
          <p class="pedido-confirmar-aviso">Resolva <%= bloqueios.size == 1 ? "1 pendência" : "#{bloqueios.size} pendências" %> para confirmar</p>
        <% end %>
      <% end %>
      <% if pode?(:pedidos, :excluir) %>
        <%= button_to "Excluir rascunho", pedido, method: :delete,
              class: "btn btn-secondary btn-sm",
              data: { turbo_confirm: "Move this draft to the trash?" } %>
      <% end %>
    <% end %>
  </section>

  <%# Etapa 2.8 (5/5): the client sees them too, his own with what settles
      them; the factory's only as "em análise" — they never stop his sending. %>
  <% if bloqueios.any? %>
    <% pode_enviar = pode?(:artes, :editar) %>
    <section class="pedido-painel-card pedido-pendencias" role="alert">
      <h3>Falta para confirmar (<%= bloqueios.size %>)</h3>
      <ul>
        <% bloqueios.each do |bloqueio| %>
          <li class="pedido-pendencia pedido-pendencia--<%= bloqueio.tipo %>">
            <span class="pedido-pendencia-texto"><%= bloqueio.descricao %></span>
            <div class="pedido-pendencia-acoes">
              <% if cliente_final? && PedidoBloqueiosService::DA_FABRICA.include?(bloqueio.tipo) %>
                <span class="pedido-pendencia-em-analise">em análise</span>
              <% elsif %i[sem_arquivo sem_lado].include?(bloqueio.tipo) && pode_enviar %>
                <%# Not nested in any other form (see AGENTS.md "Nested forms gotcha"). %>
                <%= form_with url: acrescentar_arquivo_arte_path(bloqueio.arquivo), multipart: true, class: "pedido-parte-enviar", data: { controller: "auto-submit", turbo: false } do %>
                  <input type="hidden" name="tamanho_uuid" value="<%= bloqueio.tamanho.uuid %>">
                  <% if bloqueio.lado %><input type="hidden" name="lado" value="<%= bloqueio.lado %>"><% end %>
                  <input type="hidden" name="voltar_para" value="<%= resumo_pedido_path(pedido) %>">
                  <label class="btn btn-sm btn-outline pedido-peca-enviar-label">
                    Enviar arquivo<%= " #{LadoNaArte::ABREVIACOES[bloqueio.lado]}" if bloqueio.lado %>
                    <input type="file" name="original_file" hidden
                           accept="<%= FileCategory.all["artes"][:extensions].map { |e| ".#{e}" }.join(",") %>"
                           data-action="change->auto-submit#submit">
                  </label>
                <% end %>
                <%= link_to "Trazer de outra arte", arquivo_path(bloqueio.arquivo, trazer: 1, anchor: "arte-arquivos"), class: "btn btn-sm btn-outline pedido-parte-trazer" %>
              <% elsif bloqueio.tipo == :sem_preco && bloqueio.molde %>
                <%# Etapa 2.4: the price per pair is set on the molde page. %>
                <%= link_to "abrir molde", molde_path(bloqueio.molde, anchor: "molde-precos"), class: "pedido-pendencias-item pedido-pendencia-molde" %>
              <% else %>
                <%= link_to "abrir arte", arquivo_path(bloqueio.arquivo), class: "pedido-pendencias-item" %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%= render "pedidos/eventos", pedido: pedido %>
</aside>
