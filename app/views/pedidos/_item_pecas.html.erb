<%# Pieces of the ordered modelo, side by side.
    incluida = goes to production · excluida = unchecked, dimmed, the pedido
    goes to production without it · pendente = no arte yet (blocks confirming).
    Checkboxes only while the pedido is a draft and the item has 2+ pieces. %>
<% pecas = item.item_pedido_pecas %>
<% editavel = pedido.status == "rascunho" && pecas.size > 1 %>
<div class="pedido-item-pecas"
     data-controller="item-pecas"
     data-item-pecas-url-value="<%= alternar_peca_pedido_path(pedido, id: item.uuid) %>"
     data-item-pecas-producao-url-value="<%= producao_pedido_path(pedido) %>">
  <% pecas.each do |peca_row| %>
    <div class="pedido-peca pedido-peca--<%= peca_row.estado %>" data-peca-id="<%= peca_row.id %>">
      <% if peca_row.arquivo&.preview_file.present? %>
        <img class="pedido-peca-thumb" src="<%= preview_arquivo_path(peca_row.arquivo) %>" alt="<%= peca_row.arquivo.filename %>">
      <% else %>
        <div class="pedido-peca-thumb pedido-peca-thumb--empty"><%= peca_row.arquivo ? "sem preview" : "sem arte" %></div>
      <% end %>
      <span class="pedido-peca-nome"><%= peca_row.peca&.nome || "Sem peça" %></span>
      <% if peca_row.estado == :pendente %>
        <span class="pedido-peca-pendente" title="Sem arte: precisa ser completada antes de confirmar o pedido">Pendente</span>
      <% elsif editavel %>
        <label class="pedido-peca-toggle">
          <input type="checkbox" class="pedido-peca-check"
                 data-action="change->item-pecas#toggle"
                 <%= "checked" if peca_row.incluida %>>
          incluir
        </label>
      <% elsif !peca_row.incluida %>
        <span class="pedido-peca-excluida-label">Excluída</span>
      <% end %>
    </div>
  <% end %>
  <p class="pedido-peca-erro" data-item-pecas-target="error" hidden></p>
</div>
