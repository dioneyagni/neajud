<%# The parts of an item's arte and, for each, where every ordered number comes
    from (Etapa 1.2, 3/3 parte 2; ResolucaoDoItem): the DXF size that serves
    it and the arte's file of that size — or the piloto as a sample — or a
    pendência, settled inside the arte ("Enviar arquivo" uploads into it with
    the part and size filled; "Trazer de outra arte" opens its page). Checking
    a part keeps the incluida / excluida choice of before. %>
<% partes = ResolucaoDoItem.call(item) %>
<% editavel = pedido_editavel?(pedido) && partes.size > 1 %>
<% pode_enviar = pedido_editavel?(pedido) && pode?(:artes, :editar) %>
<div class="pedido-item-pecas"
     data-controller="item-pecas"
     data-item-pecas-url-value="<%= alternar_peca_pedido_path(pedido, id: item.uuid) %>"
     data-item-pecas-producao-url-value="<%= producao_pedido_path(pedido) %>">
  <% partes.each do |parte| %>
    <% primeiro = parte.numeros.filter_map(&:arquivo).first || parte.arquivos.first %>
    <div class="pedido-peca pedido-peca--<%= parte.incluida ? "incluida" : "excluida" %><%= " pedido-peca--pendente" if parte.pendencias.any? %>"
         data-peca-uuid="<%= parte.peca_row.uuid %>" data-parte="<%= parte.peca&.nome %>">
      <% if primeiro && (primeiro.pending? || primeiro.processing?) %>
        <%# Queued processing (Etapa 0.3): reload the page once the file is ready. %>
        <div class="pedido-peca-thumb pedido-peca-thumb--empty"
             data-controller="processamento" data-processamento-url-value="<%= processamento_arquivo_path(primeiro, format: :json) %>">processando…</div>
      <% elsif primeiro&.preview_file.present? %>
        <img class="pedido-peca-thumb" src="<%= preview_arquivo_path(primeiro) %>" alt="<%= primeiro.filename %>">
      <% else %>
        <div class="pedido-peca-thumb pedido-peca-thumb--empty"><%= primeiro ? "sem preview" : "sem arquivo" %></div>
      <% end %>
      <span class="pedido-peca-nome"><%= parte.peca&.nome || "Sem peça" %></span>
      <% if editavel %>
        <label class="pedido-peca-toggle">
          <input type="checkbox" class="pedido-peca-check" data-action="change->item-pecas#toggle" <%= "checked" if parte.incluida %>>
          incluir
        </label>
      <% elsif !parte.incluida %>
        <span class="pedido-peca-excluida-label">Excluída</span>
      <% end %>

      <ul class="pedido-parte-tamanhos">
        <% parte.por_tamanho.each do |tamanho, numeros| %>
          <% exemplo = numeros.first %>
          <li class="pedido-parte-tamanho pedido-parte-tamanho--<%= exemplo.pendencia || exemplo.origem %>" data-tamanho="<%= tamanho&.nome %>">
            <span class="pedido-parte-dxf"><%= tamanho&.nome || "—" %></span>
            <span class="pedido-parte-numeros"><%= numeros.map { |n| "#{n.numero == ProducaoPedidoService::TOTAL_KEY ? "Qtd" : n.numero}×#{n.quantidade}" }.join(" · ") %></span>
            <% if exemplo.arquivo %>
              <%= link_to exemplo.arquivo.filename, arquivo_path(exemplo.arquivo), class: "pedido-parte-arquivo" %>
              <% if exemplo.origem == :piloto %><span class="pedido-parte-piloto" title="Arte pedida só no tamanho do piloto, sem arquivo de produção">piloto (amostra)</span><% end %>
            <% elsif exemplo.pendencia == :sem_corte %>
              <span class="pedido-parte-pendencia">⚠ nenhum corte organizado atende</span>
            <% else %>
              <span class="pedido-parte-pendencia">⚠ sem arquivo de produção</span>
              <% if pode_enviar %>
                <%# Not nested in any other form (see AGENTS.md "Nested forms gotcha"). %>
                <%= form_with url: acrescentar_arquivo_arte_path(item.arquivo), multipart: true, class: "pedido-parte-enviar", data: { controller: "auto-submit", turbo: false } do %>
                  <input type="hidden" name="tamanho_uuid" value="<%= tamanho.uuid %>">
                  <input type="hidden" name="voltar_para" value="<%= resumo_pedido_path(pedido) %>">
                  <label class="btn btn-sm btn-outline pedido-peca-enviar-label">
                    Enviar arquivo
                    <input type="file" name="original_file" hidden
                           accept="<%= FileCategory.all["artes"][:extensions].map { |e| ".#{e}" }.join(",") %>"
                           data-action="change->auto-submit#submit">
                  </label>
                <% end %>
                <%= link_to "Trazer de outra arte", arquivo_path(item.arquivo, trazer: 1, anchor: "arte-arquivos"), class: "btn btn-sm btn-outline pedido-parte-trazer" %>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <p class="pedido-peca-erro" data-item-pecas-target="error" hidden></p>
</div>
