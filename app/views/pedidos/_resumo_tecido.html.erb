<%# A tecido pedido's totals (Etapa 2.7a); whose fabric it is, the paper
    and their choice are pedidos/_materiais_do_pedido since 2.3d1. The
    total for who sees prices (2.7b); valores comes from the pedido page. %>
<% itens = pedido.itens_pedido.to_a %>
<dl class="pedido-resumo-lista">
  <dt>Artes</dt><dd data-resumo="itens"><%= itens.size %></dd>
  <dt>Metros</dt><dd data-resumo="metros"><%= metros(itens.sum { |i| i.metros.to_d }) %></dd>
  <% if valores %>
    <dt>Total</dt><dd data-resumo="total"><%= reais(valores.total) %></dd>
  <% end %>
</dl>
