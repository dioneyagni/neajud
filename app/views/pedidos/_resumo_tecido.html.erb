<%# A tecido pedido's totals and whose fabric it is (Etapa 2.7a, decided
    16/10/2026): once for the whole pedido — the client's (default) or the
    empresa's, which only the empresa's is charged for (2.7b). The cliente
    final chooses it too on his draft: he knows whether he brings it. %>
<% itens = pedido.itens_pedido.to_a %>
<dl class="pedido-resumo-lista">
  <dt>Artes</dt><dd data-resumo="itens"><%= itens.size %></dd>
  <dt>Metros</dt><dd data-resumo="metros"><%= metros(itens.sum { |i| i.metros.to_d }) %></dd>
  <dt>Tecido</dt><dd data-resumo="dono-tecido"><%= pedido.dono_tecido == "empresa" ? "Da empresa" : "Do cliente" %></dd>
</dl>
<% if pedido_editavel?(pedido) %>
  <%= form_with url: tecido_pedido_path(pedido), method: :patch, class: "pedido-tecido-ajustes", data: { controller: "auto-submit" } do %>
    <label>Tecido
      <select name="dono_tecido" id="pedido-dono-tecido" data-action="change->auto-submit#submit">
        <option value="cliente" <%= "selected" if pedido.dono_tecido == "cliente" %>>Do cliente</option>
        <option value="empresa" <%= "selected" if pedido.dono_tecido == "empresa" %>>Da empresa</option>
      </select>
    </label>
  <% end %>
<% end %>
