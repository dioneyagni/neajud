<%# Choose an existing arte for a pending piece. Groups come from
    ArteCandidatasService in the agreed order. An arte from another modelo is
    moved only after the "Mover para …?" confirmation (checked server-side too). %>
<h2>Escolher arte</h2>
<p class="escolher-arte-contexto">
  Peça <strong><%= @peca_row.peca&.nome || "Sem peça" %></strong>
  do modelo <strong><%= @modelo.nome %></strong>
  <span class="escolher-arte-cliente">(<%= @modelo.client.name %>)</span>
</p>

<% @grupos.each do |grupo| %>
  <section class="escolher-arte-grupo" data-grupo="<%= grupo.chave %>">
    <h3><%= grupo.titulo %> <span class="escolher-arte-contagem">(<%= grupo.artes.size %>)</span></h3>
    <% if grupo.artes.empty? %>
      <p class="escolher-arte-vazio">Nenhuma arte.</p>
    <% else %>
      <div class="escolher-arte-lista">
        <% grupo.artes.each do |arte| %>
          <% mover = arte.modelo.present? && arte.modelo != @modelo %>
          <div class="escolher-arte-card" data-arquivo-uuid="<%= arte.uuid %>">
            <% if arte.preview_file.present? %>
              <img class="escolher-arte-thumb" src="<%= preview_arquivo_path(arte) %>" alt="<%= arte.filename %>">
            <% else %>
              <div class="escolher-arte-thumb escolher-arte-thumb--vazio">sem preview</div>
            <% end %>
            <span class="escolher-arte-nome"><%= arte.filename %></span>
            <span class="escolher-arte-modelo"><%= arte.modelo ? "Modelo: #{arte.modelo.nome}" : "Sem modelo" %></span>
            <%= button_to "Usar esta", vincular_arte_pedido_peca_path(@pedido, @peca_row),
                  params: { arquivo_uuid: arte.uuid, confirmar_mudanca: (mover ? "1" : nil) }.compact,
                  class: "btn btn-sm btn-primary",
                  data: (mover ? { turbo_confirm: "Esta arte está no modelo #{arte.modelo.nome}. Mover para #{@modelo.nome}? A mudança fica registrada." } : {}) %>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>
<% end %>

<div class="back-link-wrapper" style="margin-top:1rem;">
  <%= link_to "Voltar ao pedido", resumo_pedido_path(@pedido), class: "back-link" %>
</div>
