<%# The molde's free suffix and, only when creating, the molde it is a
    variation of (Etapa 1.1, 4/5) — any client's: a variation follows its own
    client's numbering and is born with the base's modelo, grade, parts and
    corte links. The code (NNN-ABR) is assigned on save.
    Locals: sufixo_id (unique id suffix), editavel (data-dialog-field for Edit). %>
<div class="client-field">
  <label for="molde_sufixo_<%= sufixo_id %>">Suffix <span class="field-hint">(optional — e.g. Furado; the code 00N-ABR is automatic)</span></label>
  <input type="text" name="molde[sufixo]" id="molde_sufixo_<%= sufixo_id %>"
         <%= 'data-dialog-field="sufixo"'.html_safe if editavel %>>
</div>
<div class="client-field" data-somente-criacao>
  <label for="molde_variacao_de_uuid_<%= sufixo_id %>">Variation of <span class="field-hint">(optional)</span></label>
  <select name="molde[variacao_de_uuid]" id="molde_variacao_de_uuid_<%= sufixo_id %>">
    <option value="">— none —</option>
    <% Molde.ativos.includes(:client, :modelo).order(:nome).group_by(&:client).sort_by { |client, _| client.name }.each do |client, moldes| %>
      <optgroup label="<%= client.name %>">
        <% moldes.each do |m| %>
          <option value="<%= m.uuid %>"><%= m.nome %></option>
        <% end %>
      </optgroup>
    <% end %>
  </select>
</div>
