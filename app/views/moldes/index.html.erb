<h2>Moldes</h2>

<div data-controller="dialog" data-create-title="Register New Molde" data-create-label="Register" data-create-url="<%= moldes_path %>">
  <div class="clients-toolbar">
    <% if pode?(:catalogo, :editar) %>
      <button class="btn btn-primary" data-action="click->dialog#open">New Molde</button>
    <% end %>
  </div>

  <dialog data-dialog-target="dialog" class="client-dialog">
    <form action="<%= moldes_path %>" method="post" class="client-form">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <h4 data-dialog-target="dialogTitle">Register New Molde</h4>
      <div class="client-field" data-somente-criacao>
        <label for="molde_client_uuid_dialog">Client</label>
        <select name="molde[client_uuid]" id="molde_client_uuid_dialog" data-dialog-field="clientUuid" required>
          <option value="">Select a client...</option>
          <% @clientes_para_escolher.each do |c| %>
            <% if c.excluido? %>
              <option value="<%= c.uuid %>" data-somente-edicao hidden disabled><%= c.name %> (in the trash)</option>
            <% else %>
              <option value="<%= c.uuid %>"><%= c.name %></option>
            <% end %>
          <% end %>
        </select>
      </div>
      <%= render "moldes/sufixo_e_base", sufixo_id: "dialog", editavel: true %>
      <%= render "moldes/modelo_e_grade", sufixo: "dialog", editavel: true %>
      <div class="client-dialog-actions">
        <button type="button" data-action="click->dialog#close" class="btn btn-secondary">Cancel</button>
        <button type="submit" class="btn btn-primary" data-dialog-target="submitBtn">Register</button>
      </div>
    </form>
  </dialog>

  <% if @moldes.any? %>
    <table class="clients-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Client</th>
          <th>Model</th>
          <th>Sizes</th>
          <th>Arquivos</th>
          <th>View</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @moldes.each do |molde| %>
          <tr>
            <td><%= molde.nome %></td>
            <td><%= molde.client.name %> <%= selo_excluido(molde.client) %></td>
            <td><%= molde.modelo&.nome || "—" %></td>
            <td><%= molde.grade.any? ? "#{molde.grade.first}–#{molde.grade.last}" : "—" %></td>
            <td><%= molde.arquivos_count %></td>
            <td><%= link_to "Show", molde_path(molde), class: "btn btn-secondary btn-sm" %></td>
            <td class="clients-table-actions">
              <% if pode?(:catalogo, :editar) %>
                <button class="btn btn-secondary btn-sm"
                        data-action="click->dialog#edit"
                        data-sufixo="<%= molde.sufixo %>"
                        data-client-uuid="<%= molde.client.uuid %>"
                        data-modelo-uuid="<%= molde.modelo&.uuid %>"
                        data-tamanho-inicial="<%= molde.tamanho_inicial %>"
                        data-tamanho-final="<%= molde.tamanho_final %>"
                        data-action-url="<%= molde_path(molde) %>"
                        data-method="patch"
                        data-dialog-title="Edit Molde"
                        data-submit-label="Update">Edit</button>
              <% end %>
              <% if pode?(:catalogo, :excluir) %>
                <%= button_to "Delete", molde_path(molde), method: :delete,
                      form: { style: "display: inline-block;" },
                      data: { turbo_confirm: "Move molde to the trash: \"#{molde.nome}\"?" },
                      class: "btn btn-danger btn-sm" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="gallery-empty">No moldes registered yet.</p>
  <% end %>
</div>

<div class="back-link-wrapper">
  <%= link_to "Back to Gallery", root_path, class: "back-link" %>
</div>