<h2>Moldes</h2>

<div data-controller="dialog" data-create-title="Register New Molde" data-create-label="Register" data-create-url="<%= moldes_path %>">
  <div class="clients-toolbar">
    <button class="btn btn-primary" data-action="click->dialog#open">New Molde</button>
  </div>

  <dialog data-dialog-target="dialog" class="client-dialog">
    <form action="<%= moldes_path %>" method="post" class="client-form">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <h4 data-dialog-target="dialogTitle">Register New Molde</h4>
      <div class="client-field">
        <label for="molde_nome_dialog">Name</label>
        <input type="text" name="molde[nome]" id="molde_nome_dialog" data-dialog-field="nome" required>
      </div>
      <div class="client-field">
        <label for="molde_peca_ids_dialog">Pecas</label>
        <select name="molde[peca_ids][]" id="molde_peca_ids_dialog" multiple size="5">
          <% Peca.order(:nome).each do |peca| %>
            <option value="<%= peca.id %>"><%= peca.nome %></option>
          <% end %>
        </select>
      </div>
      <div class="client-dialog-actions">
        <button type="button" data-action="click->dialog#close" class="btn btn-secondary">Cancel</button>
        <button type="submit" class="btn btn-primary" data-dialog-target="submitBtn">Register</button>
      </div>
    </form>
  </dialog>

  <% if @moldes.any? %>
    <table class="clients-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Pecas</th>
          <th>Arquivos</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @moldes.each do |molde| %>
          <tr>
            <td><%= molde.nome %></td>
            <td><%= molde.pecas.pluck(:nome).join(", ") %></td>
            <td><%= molde.arquivos.count %></td>
            <td class="clients-table-actions">
              <button class="btn btn-secondary btn-sm"
                      data-action="click->dialog#edit"
                      data-nome="<%= molde.nome %>"
                      data-action-url="<%= molde_path(molde) %>"
                      data-method="patch"
                      data-dialog-title="Edit Molde"
                      data-submit-label="Update">Edit</button>
              <%= button_to "Delete", molde_path(molde), method: :delete,
                    form: { style: "display: inline-block;" },
                    data: { turbo_confirm: "Delete molde \"#{molde.nome}\"?" },
                    class: "btn btn-danger btn-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="gallery-empty">No moldes registered yet.</p>
  <% end %>
</div>

<div class="back-link-wrapper">
  <%= link_to "Back to Gallery", root_path, class: "back-link" %>
</div>