<h2>Molde: <%= @molde.nome %> <%= selo_excluido(@molde) %></h2>

<div class="stamp-detail">
  <div class="stamp-detail-info">
    <div class="stamp-detail-grid">
      <div class="stamp-detail-section">
        <h3>Details</h3>
        <dl class="detail-grid">
          <dt>Code</dt>
          <dd class="molde-codigo"><%= @molde.codigo %></dd>
          <dt>Suffix</dt>
          <dd><%= @molde.sufixo.presence || "—" %></dd>
          <dt>Client</dt>
          <dd><%= @molde.client.name %></dd>
          <% if @molde.variacao_de %>
            <dt>Variation of</dt>
            <dd class="molde-variacao-de"><%= link_to @molde.variacao_de.nome, molde_path(@molde.variacao_de) %>
              <% if @molde.variacao_de.client_id != @molde.client_id %>(<%= @molde.variacao_de.client.name %>)<% end %>
              <%= selo_excluido(@molde.variacao_de) %></dd>
          <% end %>
          <% variacoes = @molde.variacoes.ativos.includes(:client).order(:nome) %>
          <% if variacoes.any? %>
            <dt>Variations</dt>
            <dd class="molde-variacoes"><%= safe_join(variacoes.map { |v| link_to(v.client_id == @molde.client_id ? v.nome : "#{v.nome} (#{v.client.name})", molde_path(v)) }, ", ") %></dd>
          <% end %>
          <dt>Modelo</dt>
          <dd><%= @molde.modelo&.nome || "—" %></dd>
          <dt>Sizes</dt>
          <dd class="molde-grade"><%= @molde.grade.any? ? "#{@molde.grade.first}–#{@molde.grade.last}" : "—" %></dd>
        </dl>
      </div>

      <div class="stamp-detail-section">
        <h3>Actions</h3>
        <div style="display: flex; gap: 0.5rem;">
          <%= link_to "All Moldes", moldes_path, class: "btn btn-secondary" %>
          <%= link_to "Client", client_path(@molde.client), class: "btn btn-secondary" %>
        </div>
      </div>

      <div class="stamp-detail-section stamp-detail-section--full" id="molde-partes">
        <%# Etapa 1.1 (3/5): the parts belong to the molde, chosen here from the
            company's piece list; the category (modelo) has none. %>
        <h3>Parts and cuts</h3>

        <% if @molde_pecas.any? %>
          <div class="molde-pecas-list">
            <% @molde_pecas.each do |mp| %>
              <div class="molde-peca-row" data-controller="toggle-switch" data-parte="<%= mp.peca.nome %>">
                <div class="molde-peca-info">
                  <span class="molde-peca-name"><%= mp.peca.nome %> <%= selo_excluido(mp.peca) %></span>

                  <% if mp.needs_cut %>
                    <% if mp.corte_arquivo %>
                      <span class="molde-peca-status molde-peca-status--has-corte">
                        <%= link_to mp.corte_arquivo.filename, arquivo_path(mp.corte_arquivo), class: "molde-peca-file-link" %>
                        <% if mp.corte_arquivo.tamanhos.any? %>
                          <span class="molde-peca-sizes">
                            <%= mp.corte_arquivo.tamanhos.map { |t| t.nome }.join(", ") %>
                          </span>
                        <% end %>
                      </span>
                      <% if (aviso = CoberturaDaGrade.aviso_do_molde(mp.corte_arquivo, @molde)) %>
                        <span class="aviso-cobertura-grade">⚠ Grade: <%= aviso.descricao %></span>
                      <% end %>
                    <% else %>
                      <span class="molde-peca-status molde-peca-status--missing">
                        Corte ausente
                      </span>
                    <% end %>
                  <% else %>
                    <span class="molde-peca-status molde-peca-status--not-needed">
                      Não corta
                    </span>
                  <% end %>

                  <%# Etapa 1.2 (3/3, parte 3b): production counts pieces —
                      how many this part takes per pair, and whether they are
                      mirrored (half right, half left). %>
                  <% if pode?(:catalogo, :editar) %>
                    <%= form_with url: update_peca_config_molde_path(@molde, molde_peca_uuid: mp.uuid), method: :patch, class: "molde-peca-pecas" do %>
                      <label>Peças por par
                        <input type="number" name="pecas_por_par" value="<%= mp.pecas_por_par %>" min="1" step="1" class="molde-peca-pecas-qtd">
                      </label>
                      <input type="hidden" name="espelhada" value="false">
                      <label><input type="checkbox" name="espelhada" value="true" <%= "checked" if mp.espelhada %>> espelhada (direito / esquerdo)</label>
                      <button type="submit" class="btn btn-sm btn-secondary">Salvar</button>
                    <% end %>
                  <% else %>
                    <span class="molde-peca-pecas"><%= mp.pecas_por_par %> por par<%= " · espelhada" if mp.espelhada %></span>
                  <% end %>
                </div>

                <% if pode?(:catalogo, :editar) %>
                  <div class="molde-peca-toggle">
                    <span class="toggle-label"><%= mp.needs_cut ? "Cortar" : "Não corta" %></span>
                    <label class="toggle-switch">
                      <input type="checkbox" <%= "checked" if mp.needs_cut %>
                             data-action="change->toggle-switch#onChange"
                             data-url="<%= update_peca_config_molde_path(@molde, molde_peca_uuid: mp.uuid) %>">
                      <span class="toggle-slider"></span>
                    </label>
                    <%= button_to "Remove", remover_parte_molde_path(@molde, molde_peca_uuid: mp.uuid), method: :delete,
                          form: { style: "display: inline-block;" },
                          data: { turbo_confirm: "Remove the part \"#{mp.peca.nome}\" from this molde?" },
                          class: "btn btn-danger btn-sm" %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="gallery-empty" style="margin-top: 0.75rem">This molde has no parts yet.</p>
        <% end %>

        <% if pode?(:catalogo, :editar) %>
          <%= form_with url: adicionar_parte_molde_path(@molde), method: :post, class: "molde-adicionar-parte" do %>
            <label for="peca_uuid_parte">Add a part</label>
            <select name="peca_uuid" id="peca_uuid_parte" required>
              <option value="">Select a piece...</option>
              <% @pecas_para_adicionar.each do |peca| %>
                <option value="<%= peca.uuid %>"><%= peca.nome %></option>
              <% end %>
            </select>
            <button type="submit" class="btn btn-primary btn-sm">Add</button>
            <%= link_to "+ Register new piece", new_peca_path(molde_uuid: @molde.uuid), class: "btn btn-secondary btn-sm" %>
          <% end %>
        <% end %>
      </div>

      <% if pode_ver_precos? %>
        <%= render "moldes/precos", molde: @molde %>
      <% end %>
    </div>
  </div>
</div>
