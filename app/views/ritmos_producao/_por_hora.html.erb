<%# A rhythm per hour (Painel 2/4a). locals: ritmo, medida, campo, id, rotulo %>
<td class="ritmo-informado">
  <label class="visually-hidden" for="<%= id %>"><%= rotulo %> per hour</label>
  <input type="text" inputmode="decimal" name="<%= campo %>[por_hora]" id="<%= id %>" value="<%= numero_br(ritmo.por_hora, 3) %>">
  <span class="ritmo-unidade"><%= ritmo.unidade %></span>
</td>
<td class="ritmo-medido">
  <% if medida %>
    <%= numero_br(medida.valor) %> <%= ritmo.unidade %> <small>· <%= medida.turnos %> turnos</small>
  <% else %>
    <small>too few turnos</small>
  <% end %>
</td>
<td><%= render "fixar", ritmo: ritmo, campo: campo %></td>
<td class="ritmo-em-uso">
  <% if (em_uso = ritmo.em_uso(medida)) %>
    <strong><%= numero_br(em_uso) %> <%= ritmo.unidade %></strong>
    <small><%= ritmo.origem_em_uso(medida) == "medido" ? "measured" : "yours" %></small>
  <% else %>
    <small class="ritmo-falta">not set</small>
  <% end %>
</td>
