<h2>Materials Inventory</h2>

<div class="clients-toolbar">
  <span class="field-display" style="font-size:0.9rem; color:var(--text-muted);">
    <%= @materiais.count %> registered materials
  </span>
  <%= link_to "Grupos", grupo_materiais_path, class: "btn btn-secondary materiais-grupos-link", style: "margin-left:auto; margin-right:0.5rem;" %>
  <% if pode?(:estoque, :editar) %>
    <%= link_to "+ Register Movement", new_movimento_path, class: "btn btn-primary" %>
  <% end %>
</div>

<%# Stock summary (Etapa 2.3, decided 09/10/2026): in meters, the empresa's
    own stock and each client's material kept here; each material's type and
    sale price per meter (an entry's value is what it cost). %>
<div class="materiais-tabela-wrap">
  <table class="clients-table materiais-tabela">
    <thead>
      <tr>
        <th>Material</th>
        <th>Type · sale price / m</th>
        <th class="num">Empresa</th>
        <th>Clients</th>
        <th class="num">Total</th>
      </tr>
    </thead>
    <tbody>
      <% @materiais.each do |mp| %>
        <tr data-material="<%= mp.uuid %>">
          <td>
            <%= mp.nome_completo %>
            <%# Etapa 2.3d2: the pedidos whose out passed what came in. %>
            <% if (aguardando = aguardando_do_material(mp)) %><small class="material-aguardando" data-aguardando><%= aguardando %></small><% end %>
            <%# Dublagem 1/5: a requirement its group gained after it was registered. %>
            <% if (faltando = mp.atributos_faltando).any? %><small class="material-faltando" data-faltando><%= "falta #{faltando.map { |a| GrupoMaterial::ROTULOS_DOS_ATRIBUTOS[a].downcase }.to_sentence}" %></small><% end %>
          </td>
          <td>
            <% if pode?(:estoque, :editar) %>
              <%= form_with model: mp, url: material_path(mp), method: :patch, class: "material-edicao", id: "material-#{mp.uuid}" do |f| %>
                <%= f.select :tipo, MateriaPrima::ROTULOS_DOS_TIPOS.map { |t, rotulo| [ rotulo, t ] }, {}, id: "material-#{mp.uuid}-tipo", "aria-label": "Type of #{mp.nome_completo}" %>
                <%= f.text_field :preco_metro, value: (number_with_precision(mp.preco_metro, precision: 2, separator: ",") if mp.preco_metro),
                      placeholder: "R$ / m", inputmode: "decimal", id: "material-#{mp.uuid}-preco", "aria-label": "Sale price per meter of #{mp.nome_completo}" %>
                <%= f.submit "Save", class: "btn btn-sm btn-secondary" %>
              <% end %>
            <% else %>
              <%= MateriaPrima::ROTULOS_DOS_TIPOS[mp.tipo] %><%= " · #{number_to_currency(mp.preco_metro)}/m" if mp.preco_metro %>
            <% end %>
          </td>
          <td class="num" data-saldo="empresa"><%= metros(@saldos.empresa(mp)) %></td>
          <td class="materiais-clientes">
            <% @saldos.por_cliente(mp).each do |cliente, saldo| %>
              <span data-cliente="<%= cliente.name %>"><%= cliente.name %>: <%= metros(saldo) %></span>
            <% end %>
          </td>
          <td class="num" data-saldo="total"><%= metros(@saldos.total(mp)) %></td>
        </tr>
      <% end %>
      <% if @materiais.empty? %>
        <tr><td colspan="5" class="gallery-empty">No materials registered yet.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>

<%# Movement ledger %>
<h3>Movement History</h3>
<%= render "movimentos/tabela", movimentos: @movimentos %>

<div class="back-link-wrapper">
  <%= link_to "Back to Gallery", root_path, class: "back-link" %>
</div>
