<h2>Materials Inventory</h2>

<div class="clients-toolbar">
  <span class="field-display" style="font-size:0.9rem; color:var(--text-muted);">
    <%= @materiais.count %> registered materials
  </span>
  <%= link_to "+ Register Movement", new_movimento_path, class: "btn btn-primary", style: "margin-left:auto;" %>
</div>

<%# Stock summary %>
<div style="margin: 1rem 0;">
  <table class="clients-table">
    <thead>
      <tr>
        <th>Material</th>
        <th>Stock</th>
      </tr>
    </thead>
    <tbody>
      <% @materiais.each do |mp| %>
        <% saldo = mp.saldo(@saldo_cache) %>
        <tr>
          <td><%= mp.nome_completo %></td>
          <td><%= saldo %></td>
        </tr>
      <% end %>
      <% if @materiais.empty? %>
        <tr><td colspan="2" class="gallery-empty">No materials registered yet.</td></tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <th>Total</th>
        <td><%= @total_saldo %></td>
      </tr>
    </tfoot>
  </table>
</div>

<%# Movement ledger %>
<h3>Movement History</h3>
<table class="clients-table">
  <thead>
    <tr>
      <th>Date</th>
      <th>Client</th>
      <th>Material</th>
      <th>Type</th>
      <th>Qty</th>
      <th>Unit Value</th>
      <th>Total</th>
    </tr>
  </thead>
  <tbody>
    <% @movimentos.each do |m| %>
      <tr>
        <td><%= l m.created_at, format: :short %></td>
        <td><%= m.client.name %></td>
        <td><%= m.materia_prima.nome_completo %></td>
        <td><%= m.tipo == "entrada" ? "In" : "Out" %></td>
        <td><%= m.quantidade %></td>
        <td><%= number_to_currency(m.valor) if m.valor %></td>
        <td><%= number_to_currency(m.valor_total) if m.valor %></td>
      </tr>
    <% end %>
    <% if @movimentos.empty? %>
      <tr><td colspan="7" class="gallery-empty">No movements recorded yet.</td></tr>
    <% end %>
  </tbody>
</table>

<div class="back-link-wrapper">
  <%= link_to "Back to Gallery", root_path, class: "back-link" %>
</div>
