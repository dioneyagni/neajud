<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Neajud App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Neajud App">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# Gallery cards are also re-rendered by broadcast (no user in that
      context), so they can't check permissions themselves: these flags hide
      their controls by CSS. The server refuses the actions anyway. %>
  <body data-pode-adicionar-ao-pedido="<%= Current.user ? pode?(:pedidos, :editar) : false %>"
        data-pode-excluir-arquivos="<%= Current.user ? (pode?(:artes, :excluir) || pode?(:catalogo, :excluir)) : false %>">
    <header>
      <h1><%= link_to "Neajud", root_path %></h1>
      <% if Current.user %>
      <nav class="header-nav">
        <%# Only the áreas the user's função can see (Etapa 0.5, ControleDeAcesso). %>
        <% if pode?(:clientes, :ver) %>
          <%= link_to "Clients", clients_path, class: "header-nav-link" %>
        <% end %>
        <% if pode?(:catalogo, :ver) %>
          <%= link_to "Modelos", modelos_path, class: "header-nav-link" %>
          <%= link_to "Pecas", pecas_path, class: "header-nav-link" %>
          <%= link_to "Moldes", moldes_path, class: "header-nav-link" %>
        <% end %>
        <% if pode?(:estoque, :ver) %>
          <%= link_to "Materials", materiais_path, class: "header-nav-link" %>
          <%= link_to "Movements", movimentos_path, class: "header-nav-link" %>
        <% end %>
        <% if pode?(:pedidos, :ver) %>
        <%= link_to pedidos_path, class: "header-nav-link", data: { controller: "pedido-counter" } do %>
          Pedidos
          <% if @current_pedido_count > 0 %>
            <span class="header-pedido-counter" data-pedido-counter-target="count">(<%= @current_pedido_count %>)</span>
          <% else %>
            <span class="header-pedido-counter header-pedido-counter--hidden" data-pedido-counter-target="count"></span>
          <% end %>
        <% end %>
        <% end %>
        <% if pode?(:lixeira, :ver) %>
          <%= link_to "Lixeira", lixeira_path, class: "header-nav-link" %>
        <% end %>
        <% if pode_acao?(:gerenciar_usuarios) %>
          <%= link_to "Usuários", usuarios_path, class: "header-nav-link" %>
        <% end %>
        <% if dono? %>
          <%= link_to "Funções", funcoes_path, class: "header-nav-link" %>
          <%= link_to "Parâmetros", edit_parametros_path, class: "header-nav-link" %>
        <% end %>
      </nav>
      <div class="header-user">
        <%= link_to Current.user.nome, edit_senha_path, class: "header-user-nome", title: "#{Current.user.email_address} — change my password" %>
        <% if (cliente = Current.user.cliente) %><span class="header-user-cliente"><%= cliente.name %></span><% end %>
        <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-secondary btn-sm", form: { class: "header-user-sair" } %>
      </div>
      <% end %>
    </header>

    <main>
      <% if notice %>
        <p class="notice flash-notice" data-controller="flash"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="alert flash-notice" data-controller="flash"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
