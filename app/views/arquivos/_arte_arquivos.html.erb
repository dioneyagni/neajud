<%# Etapa 1.2 (2/3): an arte has one file per part × size; this is the list,
    the same on the page of any of them. Bring/separate fix files grouped apart
    or together by mistake (decided 02/10/2026; with previews 05/10/2026). Each
    part's piloto (the editable master) comes first (parte 2b, 05/10/2026). %>
<% partes = arquivo.arte.arquivos_por_parte %>
<% largura_papel = Empresa.atual&.largura_papel_efetiva_mm %>
<% total = partes.values.sum(&:size) %>
<div class="stamp-detail-section stamp-detail-section--full" id="arte-arquivos">
  <h3>Files of this arte <span class="badge-count"><%= total %></span></h3>

  <% partes.each do |peca, lista| %>
    <div class="arte-parte" data-parte="<%= peca&.nome || "" %>">
      <h4><%= peca&.nome || "Part not known yet" %></h4>
      <ul class="arte-arquivos-lista">
        <% lista.each do |membro| %>
          <li class="arte-arquivo<%= " arte-arquivo--atual" if membro == arquivo %><%= " arte-arquivo--piloto" if membro.piloto? %>" data-arquivo-uuid="<%= membro.uuid %>" data-papel="<%= membro.papel %>">
            <%= miniatura_do_arquivo(membro, classe: "arte-arquivo-thumb") %>
            <% if membro.piloto? %>
              <span class="arte-arquivo-tamanho" title="The editable master file of this part">★ Piloto</span>
            <% else %>
              <span class="arte-arquivo-tamanho"><%= membro.rotulo_de_tamanho || "size ?" %></span>
            <% end %>
            <%# Etapa 1.2 (3/3, parte 3c): the side of a mirrored part's file. %>
            <% if pode_editar_arquivo?(arquivo) && !membro.piloto? && (membro.lado || membro.parte_espelhada?) %>
              <%= form_with url: definir_lado_arquivo_arte_path(membro), method: :patch, class: "arte-acao-inline arte-lado", data: { controller: "auto-submit", turbo: false } do %>
                <select name="lado" aria-label="Side of <%= membro.filename %>" data-action="change->auto-submit#submit">
                  <option value="">no side</option>
                  <% LadoNaArte::ABREVIACOES.each do |lado, abreviado| %>
                    <option value="<%= lado %>" <%= "selected" if membro.lado == lado %>><%= abreviado %></option>
                  <% end %>
                </select>
              <% end %>
            <% elsif membro.lado %>
              <span class="arte-arquivo-lado"><%= membro.lado_abreviado %></span>
            <% end %>
            <% if membro == arquivo %>
              <span class="arte-arquivo-nome"><%= membro.filename %>.<%= membro.extension %> (this file)</span>
            <% else %>
              <%= link_to "#{membro.filename}.#{membro.extension}", arquivo_path(membro), class: "arte-arquivo-nome" %>
            <% end %>
            <%# Etapa 2.2 (1/3): how much paper one printed piece takes. %>
            <% if (consumo = consumo_de_papel(membro, largura_papel)) %>
              <span class="arte-arquivo-consumo" title="On the <%= largura_papel %> mm paper (Parâmetros), without turning the arte"><%= consumo %></span>
            <% end %>
            <% if membro.piloto? %>
              <span class="arte-arquivo-peso"><%= [ membro.rotulo_de_tamanho, peso_do_arquivo(membro) ].compact.join(" · ") %></span>
            <% elsif membro.anterior_ao_piloto? %>
              <span class="arte-arquivo-aprovacao arte-arquivo-aprovacao--alterado" title="Made before the piloto's newest version: it still has the old drawing">⚠ before the current piloto</span>
            <% end %>
            <% if arquivo.arte.depois_da_aprovacao?(membro) %>
              <span class="arte-arquivo-aprovacao" title="The client approved the arte before this file was added">after the approval</span>
            <% elsif arquivo.arte.alterado_depois_da_aprovacao?(membro) %>
              <span class="arte-arquivo-aprovacao arte-arquivo-aprovacao--alterado" title="Its new version undid the arte's approval">changed after the approval</span>
            <% end %>
            <% if membro.pending? || membro.processing? %>
              <span class="stamp-card-badge badge-<%= membro.status %>"><%= processamento_label(membro.status) %></span>
            <% end %>
            <% if pode_baixar_original? %>
              <%= link_to "Download", download_arquivo_path(membro), class: "btn btn-secondary btn-sm", data: { turbo: false } %>
            <% end %>
            <% if pode_editar_arquivo?(arquivo) %>
              <% if membro.piloto? %>
                <%= button_to "Back to production", voltar_para_producao_arquivo_arte_path(membro), class: "btn btn-secondary btn-sm", form: { class: "arte-acao-inline arte-voltar-producao" } %>
              <% else %>
                <%= button_to "Make it the piloto", tornar_piloto_arquivo_arte_path(membro), class: "btn btn-secondary btn-sm", form: { class: "arte-acao-inline arte-tornar-piloto" },
                      data: { turbo_confirm: "Make #{membro.filename} the piloto (editable master) of #{membro.resolved_peca&.nome || "its part"}?" } %>
              <% end %>
            <% end %>
            <% if total > 1 && pode_editar_arquivo?(arquivo) %>
              <%= button_to "Separate", separar_arquivo_arte_path(membro), class: "btn btn-secondary btn-sm",
                    form: { class: "arte-separar" }, data: { turbo_confirm: "Take #{membro.filename} out of this arte into an arte of its own?" } %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if pode_editar_arquivo?(arquivo) %>
    <% sugestoes = arquivo.mesma_arte_em_outro_envelope.to_a %>
    <% sugestoes.each do |outra| %>
      <div class="arte-sugestao-juntar" data-arquivo-uuid="<%= outra.uuid %>">
        <p>⚠ This looks like the same arte in other sizes:</p>
        <div class="arte-candidata">
          <%= link_to miniatura_do_arquivo(outra, classe: "arte-candidata-thumb"), arquivo_path(outra) %>
          <div class="arte-candidata-texto">
            <strong><%= outra.arte.titulo %></strong>
            <span><%= resumo_da_arte(outra) || "#{outra.rotulo_de_tamanho || "size ?"} · #{outra.filename}" %></span>
          </div>
          <%= button_to "Bring into this arte", trazer_arquivo_arte_path(arquivo), params: { "origem_uuids[]" => outra.uuid },
                class: "btn btn-primary btn-sm" %>
        </div>
      </div>
    <% end %>

    <details class="arte-acrescentar">
      <summary>Add a file (another part or size)</summary>
      <%= form_with url: acrescentar_arquivo_arte_path(arquivo), method: :post, multipart: true, data: { turbo: false }, class: "arte-acrescentar-form" do %>
        <input type="file" name="original_file" required>
        <% if arquivo.molde %>
          <% cortes = visiveis(Arquivo).cortes_do_molde(arquivo.molde).includes(:peca, :tamanhos).order(:id) %>
          <select name="tamanho_uuid" required>
            <option value="">Part and size…</option>
            <% cortes.each do |corte| %>
              <optgroup label="<%= corte.peca&.nome || corte.filename %>">
                <% corte.tamanhos.each do |t| %>
                  <option value="<%= t.uuid %>"><%= corte.peca&.nome %> <%= t.nome %></option>
                <% end %>
              </optgroup>
            <% end %>
          </select>
        <% else %>
          <select name="peca_uuid">
            <option value="">Part (optional)</option>
            <% visiveis(Peca).ativos.order(:nome).each do |peca| %>
              <option value="<%= peca.uuid %>"><%= peca.nome %></option>
            <% end %>
          </select>
          <input type="text" name="tamanho_rotulo" placeholder="Size (29-30, P…)">
        <% end %>
        <select name="lado" aria-label="Side">
          <option value="">Side (mirrored parts)</option>
          <% LadoNaArte::ABREVIACOES.each do |lado, abreviado| %>
            <option value="<%= lado %>"><%= abreviado %></option>
          <% end %>
        </select>
        <button type="submit" class="btn btn-primary btn-sm">Add</button>
      <% end %>
    </details>

    <% candidatas = arquivo.artes_para_trazer.to_a %>
    <% if candidatas.any? %>
      <%# Decided 05/10/2026: mark the other artes and bring them here (from the
          P's page, the M and the G), seeing each one's preview. %>
      <%# Opened by a pedido's "Trazer de outra arte" (?trazer=1). %>
      <details class="arte-juntar"<%= " open" if params[:trazer].present? %>>
        <summary>Bring other artes into this one</summary>
        <%= form_with url: trazer_arquivo_arte_path(arquivo), method: :post, class: "arte-juntar-form",
              data: { controller: "trazer-artes" } do %>
          <input type="search" class="arte-juntar-busca" placeholder="Filter by name…"
                 data-trazer-artes-target="busca" data-action="input->trazer-artes#filtrar">
          <div class="arte-candidatas">
            <% candidatas.each do |outra| %>
              <label class="arte-candidata arte-candidata--card" data-trazer-artes-target="card"
                     data-texto="<%= [ outra.arte.titulo, outra.filename, resumo_da_arte(outra) ].compact.join(" ").downcase %>">
                <input type="checkbox" name="origem_uuids[]" value="<%= outra.uuid %>" data-action="change->trazer-artes#contar">
                <%= miniatura_do_arquivo(outra, classe: "arte-candidata-thumb") %>
                <span class="arte-candidata-texto">
                  <strong><%= outra.arte.titulo %></strong>
                  <span><%= resumo_da_arte(outra) || "#{outra.rotulo_de_tamanho || "size ?"} · #{outra.filename}" %></span>
                </span>
              </label>
            <% end %>
          </div>
          <button type="submit" class="btn btn-primary btn-sm" disabled data-trazer-artes-target="botao"
                  data-turbo-confirm="The marked artes' files come into this one and take its molde, client, reference and name.">Bring the marked artes</button>
        <% end %>
      </details>
    <% end %>
  <% end %>
</div>
