<%# Client approval of this arte (Etapa 0.5, 4/4; per arte since Etapa 1.2,
    2/3): nothing waits until someone sends it for approval; then it can be
    registered. One request and one approval cover all the arte's files. History
    of requests and approvals, cancelled ones included.
    Etapa 2.8 (4a): the cliente final answers in the system — approves the
    versions he picks, or asks for changes; sending and registering stay the
    team's. %>
<% pode_aprovar = !cliente_final? && pode_acao?(:aprovar_arte) && !arquivo.excluido? && arquivo.approved_version %>
<% arte = arquivo.arte %>
<% estado = arte.estado_aprovacao %>
<div class="stamp-detail-section stamp-detail-section--full" id="aprovacao-section" data-estado="<%= estado %>">
  <h3>Client approval</h3>
  <div class="aprovacao-estado">
    <% if estado == :nao_enviada %>
      <span class="aprovacao-nao-enviada">Not sent for approval.</span>
      <% if arte.alterada_depois_da_aprovacao? %>
        <span class="aprovacao-alterada">⚠ Changed after the last approval: a file has a new version.</span>
      <% end %>
      <% if pode_aprovar %>
        <%= button_to "Send for approval", arquivo_solicitacoes_path(arquivo), method: :post, class: "btn btn-sm btn-primary",
              form: { style: "display: inline-block;" } %>
      <% end %>
    <% else %>
      <%= selo_aprovacao(arquivo) %>
    <% end %>
    <% if estado == :aguardando %>
      <% solicitacao = arte.solicitacao_vigente %>
      <span class="aprovacao-enviada">sent <%= l(solicitacao.created_at.to_date, format: "%d/%m/%Y") %> by <%= solicitacao.user.nome %></span>
      <% if pode_aprovar %>
        <%= link_to "Register approval", new_arquivo_aprovacao_path(arquivo, voltar_para: arquivo_path(arquivo)), class: "btn btn-sm btn-primary" %>
        <%= button_to "Cancel request", cancelar_solicitacao_path(solicitacao), method: :post, class: "btn btn-sm btn-secondary",
              form: { style: "display: inline-block;" }, data: { turbo_confirm: "Cancel sending it for approval? It stays in the history." } %>
      <% end %>
    <% end %>
    <% if estado == :alteracao_pedida && pode_aprovar %>
      <%= button_to "Send for approval again", arquivo_solicitacoes_path(arquivo), method: :post, class: "btn btn-sm btn-primary",
            form: { style: "display: inline-block;" } %>
    <% end %>
  </div>

  <% if estado == :alteracao_pedida %>
    <% alteracao = arte.alteracao_pedida %>
    <blockquote class="aprovacao-recado" id="alteracao-pedida">
      <strong><%= alteracao.user.nome %></strong> asked for changes on <%= l(alteracao.created_at.to_date, format: "%d/%m/%Y") %>:
      <p><%= alteracao.recado %></p>
    </blockquote>
  <% end %>

  <% if estado == :aprovada_em_outra_versao %>
    <%= render "aprovacao_em_outra_versao", arquivo: arquivo, aprovacao: arte.aprovacao_em_outra_versao %>
  <% end %>

  <%# Only the work's own client answers — never one reading it in the coleção geral (Etapa 2.5a). %>
  <% if estado == :aguardando && cliente_final? && do_proprio_cliente?(arquivo) && pode_acao?(:aprovar_arte) && !arquivo.excluido? %>
    <%= render "resposta_do_cliente", arquivo: arquivo %>
  <% end %>

  <% if arte.solicitacoes_aprovacao.any? %>
    <ul class="aprovacao-solicitacoes">
      <% arte.solicitacoes_aprovacao.each do |solicitacao| %>
        <li class="<%= "aprovacao--cancelada" if solicitacao.cancelada? %>">
          <%= arquivos_da_foto(solicitacao) %> sent for approval <%= l(solicitacao.created_at.to_date, format: "%d/%m/%Y") %> by <%= solicitacao.user.nome %>
          <% if solicitacao.cancelada? %> — cancelled by <%= solicitacao.cancelada_por&.nome %><% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if arte.alteracoes_arte.any? %>
    <ul class="aprovacao-solicitacoes aprovacao-alteracoes">
      <% arte.alteracoes_arte.each do |alteracao| %>
        <li>
          <%= arquivos_da_foto(alteracao) %>: <%= alteracao.user.nome %> asked for changes <%= l(alteracao.created_at.to_date, format: "%d/%m/%Y") %> — “<%= alteracao.recado %>”
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if arte.aprovacoes_arte.any? %>
    <table class="time-history-table aprovacao-historico">
      <thead>
        <tr><th>Files</th><th>Approved on</th><th>Channel</th><th>Registered by</th><th>Notes</th><th>Attachment</th><th></th></tr>
      </thead>
      <tbody>
        <% arte.aprovacoes_arte.each do |aprovacao| %>
          <tr class="<%= "aprovacao--cancelada" if aprovacao.cancelada? %>">
            <td><%= arquivos_da_foto(aprovacao) %></td>
            <td><%= l(aprovacao.aprovado_em, format: "%d/%m/%Y") %></td>
            <td><%= aprovacao.rotulo_canal %></td>
            <td><%= aprovacao.user.nome %></td>
            <td><%= aprovacao.observacao %></td>
            <td>
              <% if aprovacao.anexo_arquivo.present? %>
                <%= link_to aprovacao.anexo_nome, anexo_aprovacao_path(aprovacao), data: { turbo: false } %>
              <% end %>
            </td>
            <td>
              <% if aprovacao.cancelada? %>
                cancelled by <%= aprovacao.cancelada_por&.nome %> on <%= l(aprovacao.cancelada_em.to_date, format: "%d/%m/%Y") %>
              <% elsif pode_aprovar %>
                <%= button_to "Cancel", cancelar_aprovacao_path(aprovacao), method: :post, class: "btn btn-secondary btn-sm",
                      form: { style: "display: inline-block;" }, data: { turbo_confirm: "Cancel this approval? It stays in the history." } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
