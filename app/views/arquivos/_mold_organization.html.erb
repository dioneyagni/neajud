<div data-controller="dialog" data-create-title="Register New Mold" data-create-label="Register" data-create-url="<%= moldes_path %>">
<%= form_with url: organize_arquivo_path(arquivo), method: :patch, class: "mold-organization-form",
      data: { controller: "edit-toggle async-form", action: "turbo:submit-end->async-form#onSuccess turbo:submit-end->edit-toggle#onSuccess" } do |f| %>
  <% if !arquivo.organized? %>
    <div class="mold-organization-alert">
      ⚠ This DXF file is not organized yet. Set the mold, piece, and sizes below.
    </div>
  <% end %>
  <% if arquivo.organize_error.present? %>
    <div class="mold-organization-error">
      ⛔ <%= arquivo.organize_error %>. If any overlapping element is a hole, mark it as "Hole" in Layer Configuration and save again.
    </div>
  <% end %>

  <div class="mold-organization-fields">
    <div class="mold-field">
      <label for="molde_id">Mold</label>
      <% if arquivo.organized? %>
        <span class="field-display" data-edit-toggle-target="display"><%= arquivo.molde&.nome || arquivo.molde_nome %></span>
        <span data-edit-toggle-target="form" style="display:none">
          <select name="molde_id" id="molde_id" data-original-value="<%= arquivo.molde_id %>">
            <option value="">Select a mold...</option>
            <% Molde.order(:nome).each do |m| %>
              <option value="<%= m.id %>" <%= "selected" if arquivo.molde_id == m.id %>><%= m.nome %></option>
            <% end %>
          </select>
          <button type="button" class="btn btn-secondary btn-sm" data-action="click->dialog#openByName" data-dialog-name-param="molde" style="margin-top: 0.25rem">+ Register new mold</button>
        </span>
      <% else %>
        <select name="molde_id" id="molde_id">
          <option value="">Select a mold...</option>
          <% Molde.order(:nome).each do |m| %>
            <option value="<%= m.id %>" <%= "selected" if arquivo.molde_id == m.id %>><%= m.nome %></option>
          <% end %>
        </select>
        <button type="button" class="btn btn-secondary btn-sm" data-action="click->dialog#openByName" data-dialog-name-param="molde" style="margin-top: 0.25rem">+ Register new mold</button>
      <% end %>
    </div>
    <div class="mold-field">
      <label for="peca_id">Piece</label>
      <% if arquivo.organized? %>
        <span class="field-display" data-edit-toggle-target="display"><%= arquivo.peca&.nome || arquivo.peca_nome %></span>
        <span data-edit-toggle-target="form" style="display:none">
          <select name="peca_id" id="peca_id" data-original-value="<%= arquivo.peca_id %>">
            <option value="">Select a piece...</option>
            <% Peca.order(:nome).each do |p| %>
              <option value="<%= p.id %>" <%= "selected" if arquivo.peca_id == p.id %>><%= p.nome %></option>
            <% end %>
          </select>
          <button type="button" class="btn btn-secondary btn-sm" data-action="click->dialog#openByName" data-dialog-name-param="peca" style="margin-top: 0.25rem">+ Register new piece</button>
        </span>
      <% else %>
        <select name="peca_id" id="peca_id">
          <option value="">Select a piece...</option>
          <% Peca.order(:nome).each do |p| %>
            <option value="<%= p.id %>" <%= "selected" if arquivo.peca_id == p.id %>><%= p.nome %></option>
          <% end %>
        </select>
        <button type="button" class="btn btn-secondary btn-sm" data-action="click->dialog#openByName" data-dialog-name-param="peca" style="margin-top: 0.25rem">+ Register new piece</button>
      <% end %>
    </div>
  </div>

  <div class="section-heading-with-action">
    <h4>Sizes</h4>
    <% if arquivo.organized? %>
      <button type="button" class="btn-icon btn-edit" data-edit-toggle-target="display" data-action="click->edit-toggle#edit" title="Edit">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" height="18" width="18" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
      </button>
    <% end %>
  </div>

  <% if arquivo.organized? %>
    <div class="edit-display" data-edit-toggle-target="display">
      <div class="tamanho-list tamanho-list--readonly">
        <% arquivo.tamanhos.each_with_index do |t, idx| %>
          <div class="tamanho-row" data-tamanho-id="<%= t.id %>">
            <span class="tamanho-indicator"><%= idx + 1 %>.</span>
            <span class="tamanho-nome"><%= t.nome %></span>
            <span class="tamanho-measurements">
              <%= t.width_mm&.round(1) %>×<%= t.height_mm&.round(1) %> mm
              · <%= number_with_delimiter(t.area_mm2&.round(1)) %> mm²
              · <abbr title="Perimeter">P</abbr> <%= number_with_delimiter(t.perimeter_mm&.round(1)) %> mm
              · <abbr title="Total line (perimeter + inner lines)">L</abbr> <%= number_with_delimiter(t.total_line_mm&.round(1)) %> mm
            </span>
            <%= link_to "Download", download_tamanho_path(t), class: "btn btn-primary tamanho-download", title: "Download #{t.nome}.dxf", data: { turbo: false } %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div<%= arquivo.organized? ? ' data-edit-toggle-target="form" style="display:none"'.html_safe : ''.html_safe %>>
    <div class="tamanho-list">
      <% arquivo.tamanhos.each_with_index do |t, idx| %>
        <div class="tamanho-row">
          <span class="tamanho-indicator"><%= idx + 1 %>.</span>
          <input type="hidden" name="tamanhos[<%= idx %>][width_mm]" value="<%= t.width_mm %>">
          <input type="hidden" name="tamanhos[<%= idx %>][height_mm]" value="<%= t.height_mm %>">
          <input type="hidden" name="tamanhos[<%= idx %>][area_mm2]" value="<%= t.area_mm2 %>">
          <input type="text" name="tamanhos[<%= idx %>][nome]" value="<%= t.nome %>" class="tamanho-input" placeholder="Ex: 35" data-original-value="<%= t.nome %>">
          <span class="tamanho-measurements">
            <%= t.width_mm&.round(1) %>×<%= t.height_mm&.round(1) %> mm
            · <%= number_with_delimiter(t.area_mm2&.round(1)) %> mm²
            · <abbr title="Perimeter">P</abbr> <%= number_with_delimiter(t.perimeter_mm&.round(1)) %> mm
            · <abbr title="Total line (perimeter + inner lines)">L</abbr> <%= number_with_delimiter(t.total_line_mm&.round(1)) %> mm
          </span>
        </div>
      <% end %>
    </div>

    <div class="edit-actions">
      <button type="submit" class="btn-icon btn-confirm" data-async-form-target="submit" title="Save">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" height="18" width="18" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      </button>
      <% if arquivo.organized? %>
        <button type="button" class="btn-icon btn-cancel" data-action="click->edit-toggle#cancel" title="Cancel">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" height="18" width="18" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg>
        </button>
      <% end %>
    </div>

    <% unless arquivo.organized? %>
      </div>
    <% end %>
  </div>
<% end %>

  <dialog data-dialog-target="moldeDialog" class="client-dialog" id="molde_dialog_org">
    <form action="<%= moldes_path %>" method="post" class="client-form">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <input type="hidden" name="arquivo_uuid" value="<%= arquivo.uuid %>">
      <h4 data-dialog-target="dialogTitle">Register New Mold</h4>
      <div class="client-field">
        <label for="molde_nome_dialog_org">Name</label>
        <input type="text" name="molde[nome]" id="molde_nome_dialog_org" data-dialog-field="nome" required>
      </div>
      <div class="client-dialog-actions">
        <button type="button" data-action="click->dialog#closeMolde" class="btn btn-secondary">Cancel</button>
        <button type="submit" class="btn btn-primary" data-dialog-target="submitBtn">Register</button>
      </div>
    </form>
  </dialog>

  <dialog data-dialog-target="pecaDialog" class="client-dialog" id="peca_dialog_org">
    <form action="<%= pecas_path %>" method="post" class="client-form">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <input type="hidden" name="arquivo_uuid" value="<%= arquivo.uuid %>">
      <h4>Register New Piece</h4>
      <div class="client-field">
        <label for="peca_nome_dialog_org">Name</label>
        <input type="text" name="peca[nome]" id="peca_nome_dialog_org" required>
      </div>
      <div class="client-dialog-actions">
        <button type="button" data-action="click->dialog#closePeca" class="btn btn-secondary">Cancel</button>
        <button type="submit" class="btn btn-primary">Register</button>
      </div>
    </form>
  </dialog>
</div>
