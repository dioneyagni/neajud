<div data-controller="dialog">
  <div id="organize-flash"></div>
  <% if arquivo.preparando_tamanhos? %>
    <%# Etapa 0.6: PreparacaoTamanhosJob refreshes the page when done; polling
        is the safety net for a broadcast lost while connecting. %>
    <p class="processamento-status badge-processing preparacao-tamanhos"
       data-controller="processamento" data-processamento-url-value="<%= preparacao_tamanhos_arquivo_path(arquivo, format: :json) %>">
      Preparando os tamanhos… as prévias e os DXF de cada tamanho aparecem quando terminar.
    </p>
  <% end %>
<%= form_with url: organize_arquivo_path(arquivo), method: :patch, class: "mold-organization-form",
      data: { controller: "edit-toggle async-form", action: "turbo:submit-end->async-form#onSuccess turbo:submit-end->edit-toggle#onSuccess" } do |f| %>
  <% if !arquivo.organized? %>
    <div class="mold-organization-alert">
      ⚠ This DXF file is not organized yet. Set the model, piece, and sizes below.
    </div>
  <% end %>
  <% if arquivo.organize_error.present? %>
    <div class="mold-organization-error">
      ⛔ <%= arquivo.organize_error %>. If any overlapping element is a hole, mark it as "Hole" in Layer Configuration and save again.
    </div>
  <% end %>

  <%
    linked_modelo_id = arquivo.modelo_id || arquivo.moldes.find { |m| m.modelo_id.present? }&.modelo_id
    # Etapa 1.1 (3/5): a category has no parts any more, so every active piece
    # is offered (plus this corte's own, even if trashed).
    initial_pecas = Peca.ativos.or(Peca.where(id: arquivo.peca_id)).order(:nome).to_a

    molde_ids = arquivo.moldes.pluck(:id)
    occupied_peca_ids = if arquivo.corte? && molde_ids.any?
                          Arquivo.ativos.where(category: "corte", organized: true)
                                 .joins(:arquivo_moldes)
                                 .where(arquivo_moldes: { molde_id: molde_ids })
                                 .where.not(id: arquivo.id)
                                 .pluck(:peca_id)
                                 .to_set
                        else
                          Set.new
                        end
  %>

  <div class="mold-organization-fields">
    <div class="mold-field">
      <label for="modelo_uuid">Model</label>
      <% if arquivo.organized? %>
        <span class="field-display" data-edit-toggle-target="display"><%= arquivo.modelo&.nome || arquivo.modelo_nome %></span>
        <span data-edit-toggle-target="form" style="display:none">
          <select name="modelo_uuid" id="modelo_uuid"
                  data-original-value="<%= arquivo.modelo&.uuid %>">
            <option value="">Select a model...</option>
            <% Modelo.ativos.order(:nome).each do |m| %>
              <option value="<%= m.uuid %>" <%= "selected" if linked_modelo_id == m.id %>><%= m.nome %></option>
            <% end %>
          </select>
        </span>
      <% else %>
        <select name="modelo_uuid" id="modelo_uuid">
          <option value="">Select a model...</option>
          <% Modelo.ativos.order(:nome).each do |m| %>
            <option value="<%= m.uuid %>" <%= "selected" if linked_modelo_id == m.id %>><%= m.nome %></option>
          <% end %>
        </select>
      <% end %>
    </div>
    <div class="mold-field">
      <label for="peca_uuid">Piece</label>
      <% if arquivo.organized? %>
        <span class="field-display" data-edit-toggle-target="display"><%= arquivo.peca&.nome || arquivo.peca_nome %></span>
        <span data-edit-toggle-target="form" style="display:none">
          <select name="peca_uuid" id="peca_uuid"
                  data-original-value="<%= arquivo.peca&.uuid %>">
            <option value="">Select a piece...</option>
            <% initial_pecas.each do |p| %>
              <option value="<%= p.uuid %>" <%= "selected" if arquivo.peca_id == p.id %>><%= p.nome %><%= " ✓" if occupied_peca_ids.include?(p.id) %></option>
            <% end %>
          </select>
          <button type="button" class="btn btn-secondary btn-sm" data-action="click->dialog#openByName" data-dialog-name-param="peca" style="margin-top: 0.25rem">+ Register new piece</button>
        </span>
      <% else %>
          <select name="peca_uuid" id="peca_uuid">
            <option value="">Select a piece...</option>
            <% initial_pecas.each do |p| %>
              <option value="<%= p.uuid %>" <%= "selected" if arquivo.peca_id == p.id %>><%= p.nome %><%= " ✓" if occupied_peca_ids.include?(p.id) %></option>
            <% end %>
          </select>
        <button type="button" class="btn btn-secondary btn-sm" data-action="click->dialog#openByName" data-dialog-name-param="peca" style="margin-top: 0.25rem">+ Register new piece</button>
      <% end %>
    </div>
  </div>

  <% grade = grade_proposta(arquivo) %>
  <% tipo_proposto = grade&.dig(:tipo) %>
  <div class="section-heading-with-action">
    <h4>Sizes</h4>
    <% if arquivo.organized? && arquivo.tipo_grade %>
      <span class="tipo-grade-display" data-edit-toggle-target="display">Grade: <%= GradeDoCorte::TIPOS[arquivo.tipo_grade] %></span>
    <% end %>
    <% if arquivo.organized? %>
      <% if pode_editar_arquivo?(arquivo) %>
        <button type="button" class="btn-icon btn-edit" data-edit-toggle-target="display" data-action="click->edit-toggle#edit" title="Edit">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" height="18" width="18" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        </button>
      <% end %>
    <% end %>
  </div>

  <% if arquivo.organized? %>
    <div class="edit-display" data-edit-toggle-target="display">
      <%# Only a warning (01/10/2026): the molde may get its stretch later. %>
      <% CoberturaDaGrade.avisos(arquivo).each do |aviso| %>
        <p class="aviso-cobertura-grade">⚠ Grade: <%= aviso.descricao %></p>
      <% end %>
      <%# Etapa 2.2 (1/3): right above the sizes whose consumption it sets. %>
      <div id="giro-corte-section" class="giro-corte-bloco">
        <%= render "giro_corte", arquivo: arquivo %>
      </div>
      <div class="tamanho-list tamanho-list--readonly">
        <% arquivo.tamanhos.each_with_index do |t, idx| %>
          <div class="tamanho-row" data-tamanho-uuid="<%= t.uuid %>">
            <span class="tamanho-indicator"><%= idx + 1 %>.</span>
            <span class="tamanho-nome"><%= t.nome %></span>
            <% if t.numeros.any? && t.numeros.join("-") != t.nome %>
              <span class="tamanho-numeros">(<%= t.numeros.join("-") %>)</span>
            <% end %>
            <span class="tamanho-measurements">
              <%= t.width_mm&.round(1) %>×<%= t.height_mm&.round(1) %> mm
              · <%= number_with_delimiter(t.area_mm2&.round(1)) %> mm²
              · <abbr title="Perimeter">P</abbr> <%= number_with_delimiter(t.perimeter_mm&.round(1)) %> mm
              · <abbr title="Total line (perimeter + inner lines)">L</abbr> <%= number_with_delimiter(t.total_line_mm&.round(1)) %> mm
            </span>
            <%# Etapa 2.2 (1/3): pieces per meter of each fabric width, from the fit. %>
            <span class="tamanho-consumo" title="Peças por metro de tecido em cada largura cadastrada (giro: <%= GiroNoEncaixe::GIROS[arquivo.giro] %>)">
              <%= pecas_por_metro_do_tamanho(t) || (arquivo.giro ? "consumo ainda não calculado" : "giro não marcado: sem consumo") %>
            </span>
            <%= link_to "Download", download_tamanho_path(t), class: "btn btn-primary tamanho-download", title: "Download #{t.nome}.dxf", data: { turbo: false } %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div<%= arquivo.organized? ? ' data-edit-toggle-target="form" style="display:none"'.html_safe : ''.html_safe %>>
    <%# Etapa 1.2 (1/3): the grade type comes deduced from the detected names
        (GradeDoCorte.deduzir) until the corte has its own; P/M/G and Furada
        add the label column before the sizes. %>
    <div class="tipo-grade-field" data-controller="tipo-grade">
      <label for="tipo_grade_<%= arquivo.uuid %>">Grade type</label>
      <select name="tipo_grade" id="tipo_grade_<%= arquivo.uuid %>" data-tipo-grade-target="select"
              data-action="change->tipo-grade#mostrarRotulos" data-original-value="<%= tipo_proposto %>">
        <option value="" <%= "selected" unless tipo_proposto %>>Not set</option>
        <% GradeDoCorte::TIPOS.each do |valor, nome| %>
          <option value="<%= valor %>" <%= "selected" if tipo_proposto == valor %>><%= nome %></option>
        <% end %>
      </select>
      <% if tipo_proposto && arquivo.tipo_grade.nil? %>
        <span class="tipo-grade-deduzido">deduced from the sizes' names — check before saving</span>
      <% end %>
    </div>
    <div class="tamanho-list" data-tipo-grade-lista>
      <% arquivo.tamanhos.each_with_index do |t, idx| %>
        <% proposta = grade && grade[:tamanhos][idx] || { nome: t.nome, numeros: [] } %>
        <% rotulo = %w[pmg furada].include?(tipo_proposto) ? proposta[:nome] : "" %>
        <% campo = tamanhos_no_campo(tipo: tipo_proposto, **proposta) %>
        <div class="tamanho-row">
          <span class="tamanho-indicator"><%= idx + 1 %>.</span>
          <input type="hidden" name="tamanhos[<%= idx %>][width_mm]" value="<%= t.width_mm %>">
          <input type="hidden" name="tamanhos[<%= idx %>][height_mm]" value="<%= t.height_mm %>">
          <input type="hidden" name="tamanhos[<%= idx %>][area_mm2]" value="<%= t.area_mm2 %>">
          <input type="text" name="tamanhos[<%= idx %>][rotulo]" value="<%= rotulo %>" class="tamanho-rotulo" placeholder="Label (P, M…)"
                 data-original-value="<%= rotulo %>" <%= "hidden" unless %w[pmg furada].include?(tipo_proposto) %>>
          <input type="text" name="tamanhos[<%= idx %>][tamanhos]" value="<%= campo %>" class="tamanho-input" placeholder="Ex: 29-30" data-original-value="<%= campo %>">
          <span class="tamanho-measurements">
            <%= t.width_mm&.round(1) %>×<%= t.height_mm&.round(1) %> mm
            · <%= number_with_delimiter(t.area_mm2&.round(1)) %> mm²
            · <abbr title="Perimeter">P</abbr> <%= number_with_delimiter(t.perimeter_mm&.round(1)) %> mm
            · <abbr title="Total line (perimeter + inner lines)">L</abbr> <%= number_with_delimiter(t.total_line_mm&.round(1)) %> mm
          </span>
        </div>
      <% end %>
    </div>

    <div class="edit-actions">
      <button type="submit" class="btn-icon btn-confirm" data-async-form-target="submit" title="Save">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" height="18" width="18" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      </button>
      <% if arquivo.organized? %>
        <button type="button" class="btn-icon btn-cancel" data-action="click->edit-toggle#cancel" title="Cancel">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" height="18" width="18" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg>
        </button>
      <% end %>
    </div>

    <% unless arquivo.organized? %>
      </div>
    <% end %>
  </div>
<% end %>


  <dialog data-dialog-target="pecaDialog" class="client-dialog" id="peca_dialog_org">
    <form action="<%= pecas_path %>" method="post" class="client-form">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <input type="hidden" name="arquivo_uuid" value="<%= arquivo.uuid %>">
      <h4>Register New Piece</h4>
      <div class="client-field">
        <label for="peca_nome_dialog_org">Name</label>
        <input type="text" name="peca[nome]" id="peca_nome_dialog_org" required>
      </div>
      <div class="client-dialog-actions">
        <button type="button" data-action="click->dialog#closePeca" class="btn btn-secondary">Cancel</button>
        <button type="submit" class="btn btn-primary">Register</button>
      </div>
    </form>
  </dialog>
</div>
