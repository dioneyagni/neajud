<%# A DTF's space between its copies on the film (Etapa 2.6a, decided
    13/10/2026): its own, else the dono's default in Parâmetros. The team's
    only — the cliente final never sees it (show.html.erb). %>
<% arte = arquivo.arte %>
<% padrao = number_with_precision(Empresa.atual&.espacamento_dtf_mm, precision: 2, separator: ",", strip_insignificant_zeros: true) %>
<div class="stamp-detail-section stamp-detail-section--full" id="espacamento-dtf-section">
  <h3>Spacing on the film</h3>
  <% if pode_editar_arquivo?(arquivo) %>
  <%= form_with url: espacamento_arquivo_tipo_da_arte_path(arquivo), method: :patch, class: "espacamento-dtf-form" do %>
    <label for="espacamento-dtf-mm">Between copies (mm)</label>
    <input type="text" inputmode="decimal" name="espacamento_mm" id="espacamento-dtf-mm" placeholder="<%= padrao %>"
           value="<%= arte.espacamento_mm && number_with_precision(arte.espacamento_mm, precision: 2, separator: ",", strip_insignificant_zeros: true) %>">
    <button type="submit" class="btn btn-sm btn-outline">Save</button>
  <% end %>
  <% end %>
  <small class="espacamento-dtf-efetivo"><%= arte.espacamento_mm ? "Its own; blank goes back to the default (#{padrao} mm)." : "Blank: the default, #{padrao} mm (Parâmetros)." %></small>
</div>
