<%# Processing is queued (Etapa 0.3): this page morph-refreshes when this
    arquivo's status changes (Arquivo#broadcast_status_change). %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from @arquivo %>

<h2>
  <%= image_tag "#{FileCategory.extension_icon(@arquivo.extension)}.svg", class: "stamp-detail-ext-icon", alt: @arquivo.extension %>
  <%= @arquivo.category == "corte" ? "Cut" : "Arquivo" %>: <%= @arquivo.filename %>.<%= @arquivo.extension %>
  <%= selo_excluido(@arquivo) %>
</h2>

<% if @arquivo.pending? || @arquivo.processing? %>
  <p class="processamento-status badge-<%= @arquivo.status %>" data-status="<%= @arquivo.status %>"
     data-controller="processamento" data-processamento-url-value="<%= processamento_arquivo_path(@arquivo, format: :json) %>">
    <%= processamento_label(@arquivo.status) %> — a prévia e as medidas aparecem aqui quando o processamento terminar.
  </p>
<% end %>

<div class="stamp-detail">
  <div class="stamp-detail-preview">
    <% if @arquivo.preview_file.present? && File.exist?(@arquivo.preview_file) %>
      <%= image_tag preview_arquivo_path(@arquivo, t: @arquivo.approved_version&.updated_at&.to_i), alt: @arquivo.filename %>
    <% else %>
      <div class="no-preview">
        <p>Preview not available yet.</p>
      </div>
    <% end %>
  </div>

  <div class="stamp-detail-info">
    <div class="stamp-detail-grid">
      <%= render "client_field" %>
      <%= render "molde_field" %>
      <%= render "nome_arte", arquivo: @arquivo %>

      <% if @arquivo.category == "corte" && @arquivo.approved_version&.cut_layers&.any? %>
        <div class="stamp-detail-section stamp-detail-section--full">
          <h3>Layer Configuration</h3>
          <%= render "layer_configuration", version: @arquivo.approved_version %>
        </div>
      <% end %>

      <%# Its form edits (organize), so read-only users only see it once organized. %>
      <% if @arquivo.extension == "dxf" && (@arquivo.organized? || pode_editar_arquivo?(@arquivo)) %>
        <div class="stamp-detail-section stamp-detail-section--full" id="mold-organization-section">
          <h3>Mold Organization</h3>
          <%= render "mold_organization", arquivo: @arquivo %>
        </div>
      <% end %>

      <% if @arquivo.category == "corte" %>
        <div id="tipo-corte-section" class="stamp-detail-section stamp-detail-section--full">
          <%= render "tipo_corte", arquivo: @arquivo %>
        </div>
      <% end %>

      <% if @arquivo.category == "artes" %>
        <%# Always rendered: update_client/update_molde turbo streams replace
            #size-selection-section, so it must exist in the DOM. The partial
            hides itself until client + molde are set. Regression of 019535b,
            which gated it on organize_error and made the size vanish. %>
        <%= render "size_selection", arquivo: @arquivo %>
        <div id="corte-comparison-section">
          <%= render "corte_comparison", arquivo: @arquivo %>
        </div>
        <%= render "aprovacao", arquivo: @arquivo %>
      <% end %>

      <div class="stamp-detail-section">
        <h3>Details</h3>
        <dl class="detail-grid">
          <dt>Update</dt>
          <dd>
            <% if @arquivo.approved_version %>
              <%= l @arquivo.approved_version.updated_at, format: :short %> — v-<%= @arquivo.approved_version.version_number %>
            <% else %>
              Not approved yet
            <% end %>
          </dd>
          <dt>Category</dt>
          <dd><%= @arquivo.category.presence || "Uncategorized" %></dd>
          <% if @arquivo.category_notes.present? %>
            <dt>Category Notes</dt>
            <dd><%= @arquivo.category_notes %></dd>
          <% end %>
          <dt>Colorspace</dt>
          <dd><%= @arquivo.colorspace || "Unknown" %></dd>
          <dt>Has Spots</dt>
          <dd><%= @arquivo.has_spots? ? "Yes" : "No" %></dd>
          <dt>ICC Profile</dt>
          <dd><%= @arquivo.icc_profile.presence || "None" %></dd>
          <dt>Dimensions</dt>
          <dd><%= @arquivo.width_px %>x<%= @arquivo.height_px %> px (<%= format_cm(@arquivo.width_px, @arquivo.dpi) %>x<%= format_cm(@arquivo.height_px, @arquivo.dpi) %> cm)</dd>
          <dt>Estimated Time</dt>
          <dd><%= format_time(@arquivo.estimated_seconds) %></dd>
          <dt>Annotated Time</dt>
          <dd><%= format_time(@arquivo.annotated_seconds) %></dd>
        </dl>
      </div>

<div class="stamp-detail-section" id="update-time-section" data-controller="edit-toggle">
        <h3 class="section-heading-with-action">Update Time
          <% if pode_editar_arquivo?(@arquivo) %>
            <button type="button" class="btn-icon btn-edit" data-edit-toggle-target="display" data-action="click->edit-toggle#edit" title="Edit time">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" height="18" width="18" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            </button>
          <% end %>
        </h3>
        <div data-edit-toggle-target="display" class="edit-display">
          <span class="field-display"><%= format_time(@arquivo.annotated_seconds || @arquivo.estimated_seconds) %></span>
        </div>
        <div data-edit-toggle-target="form" style="display:none">
          <%= form_with url: update_time_arquivo_path(@arquivo), method: :patch,
                data: { controller: "time-mask async-form", action: "turbo:submit-end->async-form#onSuccess turbo:submit-end->edit-toggle#onSuccess" }, class: "time-form" do |f| %>
            <%= f.label :annotated_seconds, "Time (h:mm)" %>
            <%= f.text_field :annotated_seconds,
                  value: format_time(@arquivo.annotated_seconds || @arquivo.estimated_seconds),
                  data: { time_mask_target: "input", action: "input->time-mask#format", original_value: format_time(@arquivo.annotated_seconds || @arquivo.estimated_seconds) } %>
            <div class="edit-actions">
              <button type="submit" class="btn-icon btn-confirm" data-async-form-target="submit" title="Confirm">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" height="18" width="18" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              </button>
              <button type="button" class="btn-icon btn-cancel" data-action="click->edit-toggle#cancel" title="Cancel">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" height="18" width="18" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg>
              </button>
            </div>
          <% end %>
        </div>
      </div>

      <div class="stamp-detail-section <%=@time_logs.any? ? 'stamp-detail-section--full' : ''%>" id="time-history-section">
        <h3>Time History</h3>
        <% if @time_logs.any? %>
          <table class="time-history">
            <thead>
              <tr>
                <th>Previous</th>
                <th>New</th>
                <th>Changed By</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              <% @time_logs.each do |log| %>
                <tr>
                  <td><%= format_time(log.previous_seconds) %></td>
                  <td><%= format_time(log.new_seconds) %></td>
                  <td><%= autor_do_log(log) %></td>
                  <td><%= l log.created_at, format: :short %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="time-history-empty">No time changes recorded.</p>
        <% end %>
      </div>

      <%= render "vinculo_history", logs: @vinculo_logs %>

      <% if pode_acao?(:baixar_producao) %>
        <div class="stamp-detail-section">
          <h3>Download</h3>
          <%= link_to "Download Original", download_arquivo_path(@arquivo), class: "btn btn-primary" %>
        </div>
      <% end %>

      <div class="stamp-detail-section stamp-detail-section--actions">
        <%= link_to "Back to Gallery", arquivos_path, class: "back-link" %>
        <% if !@arquivo.excluido? && pode?(@arquivo.area_de_acesso, :excluir) %>
          <%= button_to "Delete Arquivo", arquivo_path(@arquivo), method: :delete,
                data: { turbo_confirm: "Move this arquivo to the trash?" },
                class: "btn btn-danger" %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<section>
  <h3>Versions</h3>
  <% if @versions.any? %>
    <div class="version-list">
      <% @versions.each do |version| %>
        <div class="version-card">
          <div class="version-card-thumb">
            <% if version.preview_file.present? && File.exist?(version.preview_file) %>
              <%= image_tag version_preview_arquivo_path(@arquivo, version_uuid: version.uuid), alt: "v#{version.version_number}" %>
            <% else %>
              <%= image_tag "#{FileCategory.extension_icon(version.extension)}.svg", class: "stamp-card-ext-icon-centered", alt: version.extension %>
            <% end %>
          </div>
          <div class="version-card-body">
            <div class="version-card-header">
              <strong>v<%= version.version_number %></strong>
              <%# "Em uso", not "Approved": approval means the client's (Etapa 0.5, 4/4).
                  In code the version in use is still approved_version / approved?. %>
              <% if version.approved? %>
                <span class="stamp-card-badge badge-processed">Em uso</span>
              <% end %>
            </div>
            <div class="version-card-meta">
              <span class="version-filename"><%= version.filename %>.<%= version.extension %></span>
              <span class="version-status badge-<%= version.status %>"><%= version.status.humanize %></span>
              <span class="version-date"><%= l version.created_at, format: :short %></span>
            </div>
            <div class="version-card-actions">
              <% if !version.approved? && pode_editar_arquivo?(@arquivo) %>
                <%= button_to "Usar esta versão", approve_version_arquivo_path(@arquivo, version_uuid: version.uuid), method: :patch, class: "btn btn-primary btn-sm" %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="gallery-empty">No versions yet.</p>
  <% end %>
</section>

<% if pode_editar_arquivo?(@arquivo) %>
<section>
  <h3>Upload New Version</h3>
  <div class="upload-form-wrapper">
    <%= form_with url: upload_version_arquivo_path(@arquivo), multipart: true, class: "version-upload-form",
          data: { controller: "upload", turbo: false, upload_field_name_value: "original_file" } do |f| %>
      <div class="upload-dropzone" style="padding: 1.5rem;"
           data-upload-target="dropzone"
           data-action="dragenter->upload#dragOver dragover->upload#dragOver dragleave->upload#dragLeave drop->upload#drop click->upload#click">
        <label for="original_file" style="display: block; cursor: pointer;">
          <p>Drag & drop a file here, or click to select</p>
        </label>
        <%= f.file_field :original_file, class: "upload-file-input", id: "original_file",
              data: { upload_target: "input", action: "change->upload#fileSelected" } %>
      </div>
      <div class="upload-file-list" data-upload-target="fileList"></div>
      <%= f.submit "Upload Version", data: { upload_target: "submit" }, class: "upload-submit" %>
    <% end %>
  </div>
</section>
<% end %>
