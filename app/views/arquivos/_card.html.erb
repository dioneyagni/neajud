<%# data-status lets E2E specs wait for queued processing to finish (Etapa 0.3).
    While queued, the card polls itself in case the broadcast was missed. %>
<%# One card per arte (Etapa 1.2, 2/3): it keeps polling while any file of the
    arte is queued — a broadcast lost on reload left a grouped upload "queued". %>
<% dados_da_arte = dados_da_arte_no_card(arquivo) %>
<% em_fila = arquivo.pending? || arquivo.processing? || dados_da_arte[:arte_em_fila] %>
<%= tag.div id: CanaisAoVivo.id_do_cartao(arquivo), class: "stamp-card",
      data: { status: arquivo.status, filename: arquivo.filename, **dados_da_arte }.merge(
        em_fila ? { controller: "processamento", processamento_mode_value: "card", processamento_url_value: processamento_arquivo_path(arquivo) } : {}
      ) do %>
  <label class="stamp-card-checkbox">
    <input type="checkbox" name="arquivo_ids[]" value="<%= arquivo.uuid %>" data-batch-select-target="checkbox" data-action="change->batch-select#toggle">
  </label>
  <%= link_to arquivo_path(arquivo) do %>
    <div class="stamp-card-thumb">
      <% if arquivo.preview_file.present? && File.exist?(arquivo.preview_file) %>
        <%= image_tag preview_arquivo_path(arquivo, t: arquivo.approved_version&.updated_at&.to_i), alt: arquivo.filename %>
        <div class="stamp-card-icons-overlay">
          <%= image_tag "#{arquivo.program_icon}.svg", class: "stamp-card-program-icon", alt: "Program" %>
          <span class="stamp-card-ext-flag"><%= arquivo.extension.upcase %></span>
        </div>
      <% elsif arquivo.preview_file.present? %>
        <%= image_tag "#{FileCategory.extension_icon(arquivo.extension)}.svg", class: "stamp-card-ext-icon-centered", alt: arquivo.extension %>
        <span class="stamp-card-preview-missing">Preview unavailable</span>
        <div class="stamp-card-icons-overlay">
          <%= image_tag "#{arquivo.program_icon}.svg", class: "stamp-card-program-icon", alt: "Program" %>
          <span class="stamp-card-ext-flag"><%= arquivo.extension.upcase %></span>
        </div>
      <% elsif arquivo.failed? || arquivo.unsupported_format? || arquivo.invalid_colorspace? %>
        <span class="file-icon">&#9888;</span>
      <% else %>
        <%= image_tag "#{FileCategory.extension_icon(arquivo.extension)}.svg", class: "stamp-card-ext-icon-centered", alt: arquivo.extension %>
        <div class="stamp-card-icons-overlay">
          <%= image_tag "#{arquivo.program_icon}.svg", class: "stamp-card-program-icon", alt: "Program" %>
          <span class="stamp-card-ext-flag"><%= arquivo.extension.upcase %></span>
        </div>
      <% end %>
      <div class="stamp-card-status-overlay">
        <% if !arquivo.client_id && arquivo.processed? %>
          <%= image_tag "icons/status/no-client.svg", class: "stamp-card-status-icon", alt: "No Client" %>
        <% end %>
        <% if arquivo.extension == "dxf" && !arquivo.organized? %>
          <%= image_tag "icons/status/not-organized.svg", class: "stamp-card-status-icon", alt: "Not Organized" %>
        <% end %>
        <%# Etapa 2.2 (1/3, decided 08/10/2026): whoever uploads the corte marks
            how its pieces turn; until then its consumption isn't computed. %>
        <% if arquivo.corte? && arquivo.organized? && arquivo.giro.nil? %>
          <%= image_tag "icons/status/no-giro.svg", class: "stamp-card-status-icon", alt: "Giro não marcado", title: "Giro no encaixe não marcado" %>
        <% end %>
        <% if arquivo.organize_error.present? %>
          <%= image_tag "icons/status/stacked-cuts.svg", class: "stamp-card-status-icon", alt: "Stacked Cuts" %>
        <% end %>
        <% if arquivo.tamanhos.any? && arquivo.tamanhos.none? { |t| t.preview_file.present? && File.exist?(t.preview_file.to_s) } %>
          <%= image_tag "icons/status/no-tamanho-preview.svg", class: "stamp-card-status-icon", alt: "Missing Preview" %>
        <% end %>
      </div>
    </div>
    <div class="stamp-card-body">
      <%# Etapa 2.5a: a work without corte shows its kind and number. %>
      <% if arquivo.arte && !arquivo.arte.calcado? %>
        <div class="stamp-card-tipo" data-tipo="<%= arquivo.arte.tipo %>">
          <%# Etapa 2.5b: a cor lisa's measured color; "parecida" never names the other (the card goes live to several clients). %>
          <% if (medida = arquivo.arte.tipo == "cor_lisa" && arquivo.arte.cor_medida) %>
            <span class="cor-amostra" style="background: <%= medida.cor_hex %>" aria-hidden="true"></span>
          <% end %>
          <%= arquivo.arte.codigo || (arquivo.arte.tipo == "cor_lisa" ? "Cor lisa · medindo…" : arquivo.arte.rotulo_do_tipo) %><%= " · catálogo" if arquivo.arte.no_catalogo %>
          <% if medida && CoresParecidas.alguma?(arquivo.arte) %><span class="stamp-card-parecida" title="A similar color is already in the system">parecida</span><% end %>
        </div>
      <% end %>
      <div class="stamp-card-name"><%= arquivo.filename %>.<%= arquivo.extension %></div>
      <% if (resumo = resumo_da_arte(arquivo)) %>
        <div class="stamp-card-arte" title="Files of this arte"><%= resumo %></div>
      <% end %>
      <div class="stamp-card-meta">
        <% if arquivo.failed? || arquivo.unsupported_format? || arquivo.invalid_colorspace? %>
          <span class="stamp-card-badge badge-<%= arquivo.status %>"><%= arquivo.status.humanize %></span>
        <% elsif arquivo.pending? || arquivo.processing? %>
          <span class="stamp-card-badge badge-<%= arquivo.status %>"><%= processamento_label(arquivo.status) %></span>
        <% end %>
        <%# The arte's client approval (Etapa 1.2, 2/3). %>
        <%= selo_aprovacao(arquivo.arte, compacto: true) if arquivo.arte %>
        <% if arquivo.annotated_seconds || arquivo.estimated_seconds&.positive? %>
          <span><%= format_time(arquivo.annotated_seconds || arquivo.estimated_seconds) %></span>
        <% end %>
      </div>
    </div>
  <% end %>
  <%# Calçado and DTF (Etapa 2.6b1) go into pedidos; the tecido's come in 2.7. %>
  <% if arquivo.category == "artes" && (arquivo.arte.nil? || arquivo.arte.calcado? || arquivo.arte.tipo == "dtf") %>
    <%# The card goes to every client who reads a catálogo work: it never says whose it is (Etapa 2.5a). %>
    <% dono = arquivo.client unless arquivo.arte&.no_catalogo %>
    <button type="button" class="btn-add-to-order"
            data-action="click->add-to-order#open"
            data-add-to-order-arte-uuid="<%= arquivo.uuid %>"
            data-add-to-order-arte-filename="<%= arquivo.filename %>"
            data-add-to-order-arte-tipo="<%= arquivo.arte&.tipo %>"
            data-add-to-order-arte-client="<%= dono&.name %>"
            data-add-to-order-arte-client-uuid="<%= dono&.uuid %>"
            data-add-to-order-arte-preview="<%= arquivo.preview_file.present? ? preview_arquivo_path(arquivo) : "" %>"
            data-add-to-order-tamanhos="<%= tamanhos_for_arte(arquivo).to_json %>"
            data-add-to-order-grade-completa="<%= grade_completa_for_arte(arquivo).to_json %>"
            title="Adicionar ao Pedido">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" height="16" width="16" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Pedido
    </button>
  <% end %>
<% end %>
