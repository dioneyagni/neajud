<h2>Tracker</h2>

<section>
  <h3>Upload New File</h3>
  <div class="upload-form-wrapper">
  <% accept_ext = FileCategory.extensions.map { |e| ".#{e}" }.join(",") %>
  <% hint_parts = FileCategory.all.map { |_name, config| "#{config[:label]}: #{config[:extensions].map(&:upcase).join(', ')}" }.join(" | ") %>
  <%= form_with model: @arquivo, html: { enctype: "multipart/form-data", data: { controller: "upload", action: "submit->upload#submit", turbo: false, allowed_extensions: FileCategory.extensions.map { |e| ".#{e}" }.join(",") } } do |f| %>
    <% if @arquivo.errors.any? %>
      <div class="form-errors">
        <% @arquivo.errors.full_messages.each do |msg| %>
          <p class="error"><%= msg %></p>
        <% end %>
      </div>
    <% end %>
    <div class="upload-dropzone" data-upload-target="dropzone"
         data-action="dragenter->upload#dragOver dragover->upload#dragOver dragleave->upload#dragLeave drop->upload#drop click->upload#click">
      <label for="arquivo_original_file" style="display: block; cursor: pointer;">
        <p>Drag & drop files here, or click to select</p>
        <p class="upload-hint"><%= hint_parts %></p>
      </label>
      <%= f.file_field :original_file, multiple: true,
            data: { upload_target: "input", action: "change->upload#fileSelected" },
            accept: accept_ext,
            class: "upload-file-input" %>
    </div>
    <div class="upload-file-list" data-upload-target="fileList"></div>
    <%= f.submit "Upload", data: { upload_target: "submit" }, class: "upload-submit" %>
  <% end %>
  </div>
</section>

<section>
  <h3>Gallery</h3>
  <% if @arquivos.any? %>
    <%= turbo_stream_from "arquivos" %>
    <div class="gallery">
      <% @arquivos.each do |arquivo| %>
        <%= render partial: "card", locals: { arquivo: arquivo } %>
      <% end %>
    </div>
  <% else %>
    <p class="gallery-empty">No arquivos uploaded yet.</p>
  <% end %>
</section>
