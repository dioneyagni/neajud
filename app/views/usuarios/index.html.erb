<h2>Usuários</h2>
<p class="auth-intro">The empresa's team. A client's own access (cliente final) is on that client's page, under "Acesso ao sistema".</p>

<div class="clients-toolbar">
  <%= link_to "+ New user", new_usuario_path, class: "btn btn-primary" %>
</div>

<table class="clients-table usuarios-tabela">
  <thead>
    <tr><th>Name</th><th>Email</th><th>Função</th><th>Extra accesses</th><th>Status</th><th></th></tr>
  </thead>
  <tbody>
    <%= render partial: "usuarios/linha", collection: @usuarios, as: :usuario %>
  </tbody>
</table>
